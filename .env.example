# AI Translator local development environment example.
# Copy values into your shell/IDE Run Configuration. Do not commit real secrets.

AI_TRANSLATOR_BACKEND_URL=http://localhost:8080

DB_URL=jdbc:mysql://localhost:3306/ai_translator?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=ai_translator
DB_PASSWORD=

# Must be Base64 and decode to at least 32 random bytes.
JWT_SECRET_BASE64=

OPENAI_API_KEY=
STUDY_OPENAI_MODEL=gpt-5.4-mini
LEARNING_TIME_ZONE=Asia/Ho_Chi_Minh

# LOCAL TEST ONLY. Leave blank in production.
# Set MANGA_PLUS to test paid Continuous Manga without creating a license row.
AI_TRANSLATOR_DEV_PLAN=
