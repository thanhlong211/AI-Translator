{
    "name":  "desktop",
    "private":  true,
    "version":  "1.0.0",
    "type":  "module",
    "main":  "electron/main.cjs",
    "scripts":  {
                    "dev":  "vite",
                    "electron":  "electron electron/main.cjs",
                    "dev:electron":  "concurrently \"npm run dev\" \"npm run electron\"",
                    "build":  "vite build",
                    "pack:win":  "npm run build \u0026\u0026 electron-builder --win dir",
                    "dist:win":  "npm run build \u0026\u0026 electron-builder --win nsis",
                    "package:dir":  "powershell -ExecutionPolicy Bypass -File ./scripts/build-unpacked.ps1",
                    "package:verify":  "powershell -ExecutionPolicy Bypass -File ./scripts/verify-packaged-app.ps1",
                    "package:installer":  "powershell -ExecutionPolicy Bypass -File ./scripts/build-installer.ps1",
                    "package:installer:verify":  "powershell -ExecutionPolicy Bypass -File ./scripts/verify-installer.ps1",
                    "release:config":  "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-release-config.ps1",
                    "release:verify":  "powershell -ExecutionPolicy Bypass -File ./scripts/verify-release-config.ps1"
                },
    "dependencies":  {
                         "react":  "^19.2.7",
                         "react-dom":  "^19.2.7",
                         "screenshot-desktop":  "^1.15.4",
                         "sharp":  "^0.35.3"
                     },
    "devDependencies":  {
                            "@types/node":  "^24.13.2",
                            "@types/react":  "^19.2.17",
                            "@types/react-dom":  "^19.2.3",
                            "@vitejs/plugin-react":  "^6.0.3",
                            "concurrently":  "^10.0.4",
                            "electron":  "^43.2.0",
                            "electron-builder":  "26.15.7",
                            "oxlint":  "^1.71.0",
                            "typescript":  "~6.0.2",
                            "vite":  "^8.1.1",
                            "wait-on":  "^9.1.0"
                        }
}
