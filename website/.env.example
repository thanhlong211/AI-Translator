
# ============================================================
# AITRANOVA WEBSITE RELEASE
# ============================================================

# Example:
# PUBLIC_APP_VERSION=0.9.0-beta
PUBLIC_APP_VERSION=

# Direct installer URL.
# Leave empty to send users to GitHub Releases instead.
PUBLIC_DOWNLOAD_URL=

# Optional SHA-256 checksum.
PUBLIC_RELEASE_SHA256=

# ============================================================
# AITRANOVA WEBSITE SITE
# ============================================================

# Public production origin.
PUBLIC_SITE_URL=https://aitranova.com

# Optional absolute URL or public path for a 1200x630 OpenGraph image.
# Example:
# PUBLIC_OG_IMAGE=/brand/og-cover.png
PUBLIC_OG_IMAGE=
