<section
  class="manga-showcase"
  id="manga"
>

  <!-- ambient background -->
  <div
    class="manga-ambient manga-ambient-left"
    aria-hidden="true"
  ></div>

  <div
    class="manga-ambient manga-ambient-right"
    aria-hidden="true"
  ></div>

  <div
    class="manga-stars"
    aria-hidden="true"
  >
    <i></i>
    <i></i>
    <i></i>
    <i></i>
    <i></i>
    <i></i>
  </div>


  <div class="container manga-shell">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="manga-heading">

      <div class="manga-heading-copy">

        <span class="manga-kicker">
          <i></i>

          <span>
            MANGA TRANSLATION
          </span>
        </span>


        <h2>

          <span
            data-i18n
            data-vi="Dịch cả mạch truyện,"
            data-en="Translate the whole story,"
          >
            Dịch cả mạch truyện,
          </span>

          <em
            data-i18n
            data-vi="không chỉ từng câu."
            data-en="not just one sentence."
          >
            không chỉ từng câu.
          </em>

        </h2>


        <p
          data-i18n
          data-vi="Manga Session dịch nhiều bubble trong cùng trang và sử dụng context từ các trang gần nhất để hội thoại, tên nhân vật và thuật ngữ nhất quán hơn."
          data-en="Manga Session translates multiple bubbles on the same page and uses recent page context to keep dialogue, character names and terminology more consistent."
        >
          Manga Session dịch nhiều bubble trong cùng trang
          và sử dụng context từ các trang gần nhất để hội thoại,
          tên nhân vật và thuật ngữ nhất quán hơn.
        </p>


        <div class="manga-heading-actions">

          <a
            href="/guide/manga"
            class="manga-primary-action"
          >
            <span>✦</span>

            <strong
              data-i18n
              data-vi="Xem cách sử dụng"
              data-en="View manga guide"
            >
              Xem cách sử dụng
            </strong>

            <span>→</span>
          </a>


          <span class="manga-meta">
            Manga Session · Batch · Context
          </span>

        </div>

      </div>


      <!-- ===================================================
           WORKFLOW
           =================================================== -->

      <div class="manga-workflow">

        <span class="workflow-title">
          MANGA WORKFLOW
        </span>


        <div class="workflow-items">

          <div class="workflow-item">
            <span class="workflow-icon">
              ▣
            </span>

            <small>01</small>

            <strong>
              Capture
            </strong>
          </div>


          <i>····</i>


          <div class="workflow-item active">
            <span class="workflow-icon">
              ◎
            </span>

            <small>02</small>

            <strong>
              OCR
            </strong>
          </div>


          <i>····</i>


          <div class="workflow-item">
            <span class="workflow-icon">
              文
            </span>

            <small>03</small>

            <strong>
              Translate
            </strong>
          </div>


          <i>····</i>


          <div class="workflow-item">
            <span class="workflow-icon">
              ▤
            </span>

            <small>04</small>

            <strong>
              Next Page
            </strong>
          </div>

        </div>

      </div>

    </div>


    <!-- =====================================================
         APP
         ===================================================== -->

    <div class="manga-app">

      <!-- sidebar -->

      <aside class="manga-sidebar">

        <span class="manga-brand-mark">
          ✦
        </span>

        <button
          type="button"
          aria-label="Capture"
        >
          +
        </button>

        <button
          type="button"
          class="active"
          aria-label="Manga"
        >
          漫
        </button>

        <button
          type="button"
          aria-label="Translation"
        >
          文
        </button>

        <span class="manga-sidebar-space"></span>

        <button
          type="button"
          aria-label="Settings"
        >
          ⚙
        </button>

      </aside>


      <div class="manga-app-main">

        <!-- topbar -->

        <header class="manga-app-header">

          <div>
            <small>
              MANGA SESSION
            </small>

            <strong>
              Chapter 03
            </strong>
          </div>


          <div class="manga-page-state">

            <div>
              <small>
                PAGE
              </small>

              <strong>
                08 / 24
              </strong>
            </div>

            <span class="manga-active-dot"></span>

            <b>
              ACTIVE
            </b>

          </div>

        </header>


        <!-- content -->

        <div class="manga-app-content">

          <!-- ===============================================
               MANGA PANEL
               =============================================== -->

          <div class="manga-reader">

            <span class="manga-page-badge">
              PAGE 08
            </span>


            <div
              class="manga-reader-glow"
              aria-hidden="true"
            ></div>


            <div
              class="manga-reader-stars"
              aria-hidden="true"
            >
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </div>


            <img
              class="manga-mascot"
              src="/brand/aitranova-mascot-manga-640.webp"
              alt="AitraNova mascot inside Manga Session"
              loading="lazy"
              decoding="async"
              draggable="false"
            />


            <div class="manga-bubble manga-bubble-a">
              未来だよ！
            </div>


            <div class="manga-bubble manga-bubble-b">
              どこへ行くの？
            </div>

          </div>


          <!-- ===============================================
               TRANSLATION PANEL
               =============================================== -->

          <div class="manga-translation">

            <div class="translation-header">

              <div>
                <small>
                  PAGE TRANSLATION
                </small>

                <strong>
                  Japanese → Vietnamese
                </strong>
              </div>


              <span class="translation-ai">
                ✦ AI
              </span>

            </div>


            <article class="translation-result">

              <span class="translation-index">
                01
              </span>

              <div>

                <small>
                  未来だよ！
                </small>

                <strong
                  data-i18n
                  data-vi="Tương lai đó!"
                  data-en="It's the future!"
                >
                  Tương lai đó!
                </strong>


                <span class="continuity-state">
                  ✓ Character continuity
                </span>

              </div>

            </article>


            <article class="translation-result">

              <span class="translation-index">
                02
              </span>

              <div>

                <small>
                  どこへ行くの？
                </small>

                <strong
                  data-i18n
                  data-vi="Cậu định đi đâu vậy?"
                  data-en="Where are you going?"
                >
                  Cậu định đi đâu vậy?
                </strong>

              </div>

            </article>


            <article class="translation-context">

              <span class="translation-index">
                ↺
              </span>

              <div>

                <small>
                  SYSTEM CONTEXT
                </small>

                <strong
                  data-i18n
                  data-vi="4 trang gần nhất"
                  data-en="4 recent pages"
                >
                  4 trang gần nhất
                </strong>

              </div>

              <b>
                ON
              </b>

            </article>


            <a
              href="/guide/manga"
              class="translation-next"
            >
              <span
                data-i18n
                data-vi="Trang tiếp theo"
                data-en="Next page"
              >
                Trang tiếp theo
              </span>

              <span>→</span>
            </a>

          </div>

        </div>

      </div>


      <!-- floating memory -->

      <div class="manga-memory">

        <span>
          ✓
        </span>

        <div>
          <small>
            CHARACTER MEMORY
          </small>

          <strong>
            未来 → Misaki
          </strong>
        </div>

      </div>

    </div>


    <!-- =====================================================
         BENEFITS
         ===================================================== -->

    <div class="manga-benefits">

      <article>

        <span class="benefit-icon">
          ▣
        </span>

        <div>
          <strong>
            Batch Translation
          </strong>

          <p
            data-i18n
            data-vi="Dịch các bubble trên cùng trang cùng nhau."
            data-en="Translate bubbles on the same page together."
          >
            Dịch các bubble trên cùng trang cùng nhau.
          </p>
        </div>

      </article>


      <article>

        <span class="benefit-icon">
          ↗
        </span>

        <div>
          <strong>
            Cross-page Context
          </strong>

          <p
            data-i18n
            data-vi="Trang trước hỗ trợ hiểu hội thoại trang sau."
            data-en="Previous pages help interpret the next page."
          >
            Trang trước hỗ trợ hiểu hội thoại trang sau.
          </p>
        </div>

      </article>


      <article>

        <span class="benefit-icon">
          ♧
        </span>

        <div>
          <strong>
            Character Continuity
          </strong>

          <p
            data-i18n
            data-vi="Giữ tên và thuật ngữ nhất quán hơn."
            data-en="Keep names and terminology more consistent."
          >
            Giữ tên và thuật ngữ nhất quán hơn.
          </p>
        </div>

      </article>


      <article>

        <span class="benefit-icon">
          ▤
        </span>

        <div>
          <strong>
            New Chapter
          </strong>

          <p
            data-i18n
            data-vi="Chuyển chương mà không phải tạo lại toàn bộ workflow."
            data-en="Move to a new chapter without rebuilding the workflow."
          >
            Chuyển chương mà không phải tạo lại toàn bộ workflow.
          </p>
        </div>

      </article>

    </div>

  </div>

</section>


