<script>
  function initHomeHeroPremium() {
    const hero =
      document.querySelector(
        ".home-hero-motion-ready"
      )
      || document.querySelector(
        "main > section:first-of-type"
      );

    if (
      !(hero instanceof HTMLElement)
    ) {
      return;
    }

    if (
      hero.dataset.heroPremiumReady
      === "true"
    ) {
      return;
    }

    hero.dataset.heroPremiumReady =
      "true";

    hero.classList.add(
      "home-hero-premium"
    );


    /* =====================================================
       NIGHT SKY
       ===================================================== */

    const sky =
      document.createElement(
        "div"
      );

    sky.className =
      "hero-night-sky";

    sky.setAttribute(
      "aria-hidden",
      "true"
    );


    const stars = [
      [7, 16, 1.4, 0.1],
      [13, 37, 1.1, 1.5],
      [19, 11, 1.7, 2.4],
      [25, 58, 1.2, 0.8],
      [31, 26, 1.5, 3.1],
      [37, 72, 1.1, 1.1],
      [43, 14, 1.3, 2.8],
      [49, 43, 1.8, 0.5],
      [55, 21, 1.0, 3.5],
      [61, 66, 1.5, 1.8],
      [67, 31, 1.2, 0.2],
      [73, 13, 1.6, 2.1],
      [79, 53, 1.0, 3.7],
      [85, 26, 1.5, 0.9],
      [91, 61, 1.1, 2.7],
      [96, 18, 1.7, 1.2],
      [11, 76, 1.0, 3.3],
      [22, 86, 1.4, 1.7],
      [35, 91, 1.1, 2.5],
      [58, 83, 1.5, 0.6],
      [71, 88, 1.0, 3.8],
      [88, 81, 1.3, 1.3],
    ];


    stars.forEach(
      (
        [
          x,
          y,
          size,
          delay,
        ]
      ) => {

        const star =
          document.createElement(
            "span"
          );

        star.className =
          "hero-night-star";

        star.style.setProperty(
          "--star-x",
          `${x}%`
        );

        star.style.setProperty(
          "--star-y",
          `${y}%`
        );

        star.style.setProperty(
          "--star-size",
          `${size}px`
        );

        star.style.setProperty(
          "--star-delay",
          `${delay}s`
        );

        sky.appendChild(
          star
        );

      }
    );


    const aurora =
      document.createElement(
        "div"
      );

    aurora.className =
      "hero-night-aurora";


    const horizon =
      document.createElement(
        "div"
      );

    horizon.className =
      "hero-night-horizon";


    sky.appendChild(
      aurora
    );

    sky.appendChild(
      horizon
    );


    hero.insertBefore(
      sky,
      hero.firstChild
    );


    /* =====================================================
       PREVIEW
       ===================================================== */

    const preview =
      hero.querySelector(
        "[data-home-hero-preview]"
      );


    if (
      preview instanceof HTMLElement
    ) {

      preview.classList.add(
        "hero-premium-preview"
      );


      const halo =
        document.createElement(
          "div"
        );

      halo.className =
        "hero-preview-halo";

      halo.setAttribute(
        "aria-hidden",
        "true"
      );


      preview.insertBefore(
        halo,
        preview.firstChild
      );

    }


    /* =====================================================
       TITLE
       ===================================================== */

    const title =
      hero.querySelector(
        "h1"
      );


    if (
      title instanceof HTMLElement
    ) {
      title.classList.add(
        "hero-premium-title"
      );
    }


    /* =====================================================
       PRIMARY CTA
       ===================================================== */

    let primaryCta =
      hero.querySelector(
        ".hero-motion-cta-primary"
      );


    if (!primaryCta) {
      primaryCta =
        hero.querySelector(
          [
            ".hero-actions a:first-child",
            ".home-hero-actions a:first-child",
            ".hero-cta a:first-child",
          ].join(",")
        );
    }


    if (
      primaryCta instanceof HTMLElement
    ) {

      primaryCta.classList.add(
        "hero-premium-primary-cta"
      );

    }


    /* =====================================================
       HERO CHIPS
       ===================================================== */

    const chipSelectors = [
      ".hero-capabilities > *",
      ".home-capabilities > *",
      ".hero-features > *",
    ];


    hero.querySelectorAll(
      chipSelectors.join(",")
    )
    .forEach(
      element => {

        element.classList.add(
          "hero-premium-chip"
        );

      }
    );

  }


  if (
    document.readyState
    === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initHomeHeroPremium,
      {
        once: true,
      }
    );

  } else {

    initHomeHeroPremium();

  }
</script>
