<script>
  function initCompactFeatureNav() {

    const buttons =
      document.querySelectorAll(
        "[data-open-feature]"
      );

    const switcher =
      document.querySelector(
        "[data-home-switcher]"
      );

    buttons.forEach(
      button => {

        button.addEventListener(
          "click",
          () => {

            const target =
              button.dataset
                .openFeature;

            if (!target) {
              return;
            }

            window.location.hash =
              target;


            window.setTimeout(
              () => {

                switcher?.scrollIntoView({
                  behavior: "smooth",
                  block: "start",
                });

              },
              40
            );

          }
        );

      }
    );

  }


  if (
    document.readyState
    === "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initCompactFeatureNav,
      {
        once: true,
      }
    );
  } else {
    initCompactFeatureNav();
  }
</script>


