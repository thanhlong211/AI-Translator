<!--
  HomeEnhancements
  Subtle JavaScript interactions for the public homepage.
-->

<div
  class="page-progress"
  data-page-progress
  aria-hidden="true"
>
  <span></span>
</div>


<button
  class="back-to-top"
  type="button"
  data-back-to-top
  aria-label="Back to top"
>
  ↑
</button>


<script>
  function initHomeEnhancements() {

    /* =========================================
       SCROLL PROGRESS
       ========================================= */

    const progress =
      document.querySelector(
        "[data-page-progress] span"
      );

    function updateProgress() {

      if (!progress) {
        return;
      }

      const maxScroll =
        document.documentElement.scrollHeight
        - window.innerHeight;

      const percent =
        maxScroll > 0
          ? Math.min(
              100,
              Math.max(
                0,
                (
                  window.scrollY
                  / maxScroll
                ) * 100
              )
            )
          : 0;

      progress.style.width =
        `${percent}%`;
    }


    /* =========================================
       BACK TO TOP
       ========================================= */

    const backToTop =
      document.querySelector(
        "[data-back-to-top]"
      );

    function updateBackToTop() {

      if (!backToTop) {
        return;
      }

      backToTop.classList.toggle(
        "visible",
        window.scrollY > 850
      );
    }


    backToTop?.addEventListener(
      "click",
      () => {

        window.scrollTo({
          top: 0,
          behavior: "smooth",
        });

      }
    );


    /* =========================================
       REVEAL ON SCROLL
       ========================================= */

    const revealSelectors = [
      ".hero-v5-copy",
      ".hero-v5-product",

      ".how-heading",
      ".how-workspace",
      ".how-details",

      ".compact-why-inner",

      ".compact-feature-head",
      ".compact-feature-card",

      ".manga-intro",
      ".manga-preview",
      ".manga-benefits",

      ".documents-heading",
      ".documents-product",
      ".document-decision",

      ".profile-deep-heading",
      ".profile-editor-shell",
      ".profile-system-card",

      ".learning-heading",
      ".learning-product",
      ".learning-workflow",

      ".roadmap-v5-heading",
      ".roadmap-board",
      ".roadmap-vision",
    ];


    const revealElements =
      Array.from(
        document.querySelectorAll(
          revealSelectors.join(",")
        )
      );


    revealElements.forEach(
      (element, index) => {

        element.classList.add(
          "home-reveal"
        );

        element.style.setProperty(
          "--reveal-delay",
          `${Math.min(
            index % 4,
            3
          ) * 45}ms`
        );

      }
    );


    if (
      "IntersectionObserver"
      in window
    ) {

      const observer =
        new IntersectionObserver(
          entries => {

            entries.forEach(
              entry => {

                if (
                  !entry.isIntersecting
                ) {
                  return;
                }

                entry.target.classList.add(
                  "home-reveal-visible"
                );

                observer.unobserve(
                  entry.target
                );

              }
            );

          },
          {
            threshold: 0.08,
            rootMargin:
              "0px 0px -40px 0px",
          }
        );


      revealElements.forEach(
        element => {

          observer.observe(
            element
          );

        }
      );

    } else {

      revealElements.forEach(
        element => {

          element.classList.add(
            "home-reveal-visible"
          );

        }
      );

    }


    /* =========================================
       CURSOR SPOTLIGHT
       ========================================= */

    const spotlightElements =
      document.querySelectorAll(
        [
          ".compact-feature-card",
          ".feature-v5-card",
          ".profile-system-card",
          ".roadmap-column",
        ].join(",")
      );


    spotlightElements.forEach(
      element => {

        element.classList.add(
          "js-spotlight"
        );


        element.addEventListener(
          "pointermove",
          event => {

            const rect =
              element.getBoundingClientRect();

            const x =
              event.clientX
              - rect.left;

            const y =
              event.clientY
              - rect.top;

            element.style.setProperty(
              "--mouse-x",
              `${x}px`
            );

            element.style.setProperty(
              "--mouse-y",
              `${y}px`
            );

          }
        );

      }
    );


    /* =========================================
       HERO POINTER GLOW
       ========================================= */

    const hero =
      document.querySelector(
        ".hero-v5"
      );


    hero?.addEventListener(
      "pointermove",
      event => {

        const rect =
          hero.getBoundingClientRect();

        hero.style.setProperty(
          "--hero-x",
          `${event.clientX - rect.left}px`
        );

        hero.style.setProperty(
          "--hero-y",
          `${event.clientY - rect.top}px`
        );

      }
    );


    /* =========================================
       SCROLL
       ========================================= */

    let ticking = false;

    function onScroll() {

      if (ticking) {
        return;
      }

      ticking = true;

      requestAnimationFrame(
        () => {

          updateProgress();
          updateBackToTop();

          ticking = false;

        }
      );

    }


    window.addEventListener(
      "scroll",
      onScroll,
      {
        passive: true,
      }
    );


    window.addEventListener(
      "resize",
      updateProgress,
      {
        passive: true,
      }
    );


    updateProgress();
    updateBackToTop();

  }


  if (
    document.readyState
    === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initHomeEnhancements,
      {
        once: true,
      }
    );

  } else {

    initHomeEnhancements();

  }
</script>


<style>

  /* ==========================================
     SCROLL PROGRESS
     ========================================== */

  .page-progress {
    position: fixed;

    z-index: 999;

    top: 0;
    left: 0;

    width: 100%;
    height: 3px;

    pointer-events: none;

    background:
      transparent;
  }


  .page-progress span {
    display: block;

    width: 0;
    height: 100%;

    background:
      linear-gradient(
        90deg,
        #6952ee,
        #7d68ff,
        #568ce9
      );

    box-shadow:
      0 0 12px
      rgba(105, 82, 238, 0.34);

    transition:
      width 80ms linear;
  }


  /* ==========================================
     REVEAL
     ========================================== */

  .home-reveal {
    opacity: 0;

    transform:
      translateY(18px);

    transition:
      opacity 560ms ease
      var(--reveal-delay, 0ms),
      transform 560ms
      cubic-bezier(
        0.2,
        0.75,
        0.25,
        1
      )
      var(--reveal-delay, 0ms);
  }


  .home-reveal.home-reveal-visible {
    opacity: 1;

    transform:
      translateY(0);
  }


  /* ==========================================
     SPOTLIGHT CARDS
     ========================================== */

  .js-spotlight {
    position: relative;

    isolation: isolate;

    overflow: hidden;
  }


  .js-spotlight::after {
    position: absolute;

    z-index: -1;

    inset: 0;

    opacity: 0;

    background:
      radial-gradient(
        260px circle
        at
        var(--mouse-x, 50%)
        var(--mouse-y, 50%),
        rgba(
          105,
          82,
          238,
          0.12
        ),
        transparent 68%
      );

    content: "";

    pointer-events: none;

    transition:
      opacity 180ms ease;
  }


  .js-spotlight:hover::after {
    opacity: 1;
  }


  /* ==========================================
     HERO CURSOR LIGHT
     ========================================== */

  .hero-v5::after {
    position: absolute;

    z-index: 0;

    inset: 0;

    background:
      radial-gradient(
        480px circle
        at
        var(--hero-x, 65%)
        var(--hero-y, 35%),
        rgba(
          115,
          92,
          245,
          0.10
        ),
        transparent 70%
      );

    content: "";

    pointer-events: none;
  }


  .hero-v5-grid,
  .hero-trust {
    position: relative;

    z-index: 1;
  }


  /* ==========================================
     BACK TO TOP
     ========================================== */

  .back-to-top {
    position: fixed;

    z-index: 90;

    right: 23px;
    bottom: 23px;

    display: grid;

    width: 42px;
    height: 42px;

    place-items: center;

    transform:
      translateY(15px)
      scale(0.92);

    opacity: 0;

    pointer-events: none;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.16
      );

    border-radius: 12px;

    background:
      rgba(
        30,
        25,
        42,
        0.88
      );

    backdrop-filter:
      blur(12px);

    color: white;

    cursor: pointer;

    box-shadow:
      0 15px 38px
      rgba(
        28,
        20,
        43,
        0.18
      );

    transition:
      opacity 180ms ease,
      transform 180ms ease,
      background 180ms ease;
  }


  .back-to-top.visible {
    transform:
      translateY(0)
      scale(1);

    opacity: 1;

    pointer-events: auto;
  }


  .back-to-top:hover {
    transform:
      translateY(-3px);

    background:
      #6952ee;
  }


  /* ==========================================
     ACCESSIBILITY
     ========================================== */

  @media (
    prefers-reduced-motion:
    reduce
  ) {

    .home-reveal {
      opacity: 1 !important;

      transform:
        none !important;

      transition:
        none !important;
    }


    .page-progress span {
      transition:
        none;
    }

  }


  @media (
    max-width: 600px
  ) {

    .back-to-top {
      right: 14px;
      bottom: 14px;

      width: 39px;
      height: 39px;
    }

  }

</style>
