---

<section
  class="feature-explorer"
  data-feature-explorer
>

  <div class="feature-explorer-tabs" role="tablist">

    {
      groups.map((group, index) => (

        <button
          type="button"
          class={index === 0 ? "active" : ""}
          data-feature-tab={group.id}
          aria-selected={index === 0 ? "true" : "false"}
        >

          <span class="feature-tab-icon">
            {group.icon}
          </span>

          <span
            data-i18n
            data-vi={group.labelVi}
            data-en={group.label}
          >
            {group.labelVi}
          </span>

        </button>

      ))
    }

  </div>


  <div class="feature-explorer-panels">

    {
      groups.map((group, index) => (

        <article
          class:list={[
            "feature-explorer-panel",
            index === 0 && "active",
          ]}
          data-feature-panel={group.id}
          hidden={index !== 0}
        >

          <div class="feature-panel-copy">

            <span class="feature-panel-kicker">
              {group.kicker}
            </span>

            <h2
              data-i18n
              data-vi={group.titleVi}
              data-en={group.titleEn}
            >
              {group.titleVi}
            </h2>

            <p
              data-i18n
              data-vi={group.descriptionVi}
              data-en={group.descriptionEn}
            >
              {group.descriptionVi}
            </p>


            <div class="feature-panel-actions">

              <a
                href={group.guide}
                class="feature-primary-action"
              >
                <span
                  data-i18n
                  data-vi="Xem hướng dẫn"
                  data-en="Open guide"
                >
                  Xem hướng dẫn
                </span>

                →
              </a>

              <a
                href="/download"
                class="feature-secondary-action"
              >
                <span
                  data-i18n
                  data-vi="Tải AitraNova"
                  data-en="Download AitraNova"
                >
                  Tải AitraNova
                </span>
              </a>

            </div>

          </div>


          <div class="feature-panel-product">

            <div class="feature-product-top">

              <div>
                <span></span>
                <span></span>
                <span></span>
              </div>

              <small>
                AITRANOVA
              </small>

              <strong>
                {group.label}
              </strong>

            </div>


            <div class="feature-product-body">

              <div class="feature-product-sidebar">

                {
                  groups.map((item) => (

                    <span
                      class:list={[
                        item.id === group.id
                          && "active",
                      ]}
                    >
                      {item.icon}
                    </span>

                  ))
                }

              </div>


              <div class="feature-product-content">

                <small>
                  {group.kicker}
                </small>

                <strong>
                  {group.label}
                </strong>


                <div class="feature-product-lines">

                  <span></span>
                  <span></span>
                  <span></span>

                </div>


                <div class="feature-product-result">

                  <span>
                    AI
                  </span>

                  <div>
                    <small>RESULT</small>

                    <strong
                      data-i18n
                      data-vi="Context-aware translation"
                      data-en="Context-aware translation"
                    >
                      Context-aware translation
                    </strong>
                  </div>

                </div>

              </div>

            </div>

          </div>


          <div class="feature-capabilities">

            {
              group.features.map((feature, featureIndex) => (

                <div>

                  <span>
                    {String(featureIndex + 1).padStart(2, "0")}
                  </span>

                  <strong>
                    {feature.title}
                  </strong>

                  <p
                    data-i18n
                    data-vi={feature.vi}
                    data-en={feature.en}
                  >
                    {feature.vi}
                  </p>

                </div>

              ))
            }

          </div>


          <div class="feature-workflow">

            <div class="feature-workflow-head">

              <small>WORKFLOW</small>

              <strong
                data-i18n
                data-vi="Từ source đến kết quả"
                data-en="From source to result"
              >
                Từ source đến kết quả
              </strong>

            </div>


            <div class="feature-workflow-track">

              {
                group.workflow.map((step, stepIndex) => (

                  <>
                    <div>
                      <span>
                        {String(stepIndex + 1).padStart(2, "0")}
                      </span>

                      <strong>
                        {step}
                      </strong>
                    </div>

                    {
                      stepIndex < group.workflow.length - 1
                      && (
                        <i>→</i>
                      )
                    }

                  </>

                ))
              }

            </div>

          </div>

        </article>

      ))
    }

  </div>

</section>


<script>
  function initFeatureExplorer() {

    const root =
      document.querySelector(
        "[data-feature-explorer]"
      );

    if (!root) {
      return;
    }


    const buttons =
      Array.from(
        root.querySelectorAll(
          "[data-feature-tab]"
        )
      );


    const panels =
      Array.from(
        root.querySelectorAll(
          "[data-feature-panel]"
        )
      );


    const valid =
      buttons
        .map(
          button =>
            button.dataset.featureTab
        )
        .filter(Boolean);


    const storageKey =
      "aitranova-feature-explorer";


    function showFeature(
      feature,
      updateUrl = true
    ) {

      if (
        !valid.includes(feature)
      ) {
        feature = "screen";
      }


      buttons.forEach(
        button => {

          const active =
            button.dataset.featureTab
            === feature;


          button.classList.toggle(
            "active",
            active
          );


          button.setAttribute(
            "aria-selected",
            String(active)
          );

        }
      );


      panels.forEach(
        panel => {

          const active =
            panel.dataset.featurePanel
            === feature;


          panel.hidden =
            !active;


          panel.classList.toggle(
            "active",
            active
          );


          if (
            active
            && typeof panel.animate
            === "function"
          ) {

            panel.animate(
              [
                {
                  opacity: 0,
                  transform:
                    "translateY(8px)",
                },
                {
                  opacity: 1,
                  transform:
                    "translateY(0)",
                },
              ],
              {
                duration: 210,
                easing: "ease-out",
              }
            );

          }

        }
      );


      try {

        localStorage.setItem(
          storageKey,
          feature
        );

      } catch {}


      if (updateUrl) {

        const url =
          new URL(
            window.location.href
          );


        url.searchParams.set(
          "feature",
          feature
        );


        history.replaceState(
          null,
          "",
          url
        );

      }

    }


    buttons.forEach(
      button => {

        button.addEventListener(
          "click",
          () => {

            const feature =
              button.dataset.featureTab;


            if (feature) {
              showFeature(feature);
            }

          }
        );


        button.addEventListener(
          "keydown",
          event => {

            if (
              event.key !== "ArrowLeft"
              && event.key !== "ArrowRight"
            ) {
              return;
            }


            event.preventDefault();


            const index =
              buttons.indexOf(
                button
              );


            const delta =
              event.key === "ArrowRight"
                ? 1
                : -1;


            const next =
              buttons[
                (
                  index
                  + delta
                  + buttons.length
                )
                % buttons.length
              ];


            next.focus();


            const feature =
              next.dataset.featureTab;


            if (feature) {
              showFeature(feature);
            }

          }
        );

      }
    );


    const params =
      new URLSearchParams(
        window.location.search
      );


    const requested =
      params.get(
        "feature"
      );


    let stored = null;


    try {

      stored =
        localStorage.getItem(
          storageKey
        );

    } catch {}


    showFeature(
      requested
      || stored
      || "screen",
      Boolean(requested)
    );

  }


  if (
    document.readyState
    === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initFeatureExplorer,
      {
        once: true,
      }
    );

  } else {

    initFeatureExplorer();

  }
</script>


<style>

