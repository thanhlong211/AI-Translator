---
import BaseLayout from "../layouts/BaseLayout.astro";
import GuideNavigator from "./GuideNavigator.astro";

interface Props {
  title: string;
  description: string;
  section?: string;
  badge?: string;
}

const {
  title,
  description,
  section = "Guide",
  badge = "DOCUMENTATION",
} = Astro.props;
---

<BaseLayout
  title={`${title} — AitraNova Guide`}
  description={description}
>

  <main class="article-page">

    <!-- TOP HERO -->

    <section class="article-hero">

      <div class="article-hero-glow"></div>

      <div class="container article-hero-inner">

        <div>

          <a
            href="/guide"
            class="article-back"
          >
            ←

            <span
              data-i18n
              data-vi="Tất cả hướng dẫn"
              data-en="All guides"
            >
              Tất cả hướng dẫn
            </span>
          </a>


          <span class="article-badge">
            {badge}
          </span>


          <span class="article-section">
            {section}
          </span>


          <h1>
            {title}
          </h1>


          <p>
            {description}
          </p>

        </div>


        <div class="article-meta">

          <div>

            <small
              data-i18n
              data-vi="Mức độ"
              data-en="Level"
            >
              Mức độ
            </small>

            <strong
              data-i18n
              data-vi="Cơ bản"
              data-en="Beginner"
            >
              Cơ bản
            </strong>

          </div>


          <span></span>


          <div>

            <small
              data-i18n
              data-vi="Nền tảng"
              data-en="Platform"
            >
              Nền tảng
            </small>

            <strong>
              Windows
            </strong>

          </div>

        </div>

      </div>

    </section>


    <!-- ARTICLE -->

    <section class="article-body">

      <div class="container article-layout">

        <GuideNavigator />


        <article class="article-content">

          <slot />

        </article>

      </div>

    </section>

  </main>


  <!-- ARTICLE PROGRESS -->

  <div
    class="article-progress"
    data-article-progress
    aria-hidden="true"
  >
    <span></span>
  </div>


  <button
    type="button"
    class="article-top"
    data-article-top
    aria-label="Back to top"
  >
    ↑
  </button>

</BaseLayout>


<script>
  function initGuideArticle() {

    const bar =
      document.querySelector(
        "[data-article-progress] span"
      );

    const topButton =
      document.querySelector(
        "[data-article-top]"
      );


    function update() {

      const max =
        document.documentElement.scrollHeight
        - window.innerHeight;

      const progress =
        max > 0
          ? Math.min(
              100,
              Math.max(
                0,
                window.scrollY / max * 100
              )
            )
          : 0;


      if (bar) {
        bar.style.width =
          `${progress}%`;
      }


      topButton?.classList.toggle(
        "visible",
        window.scrollY > 700
      );

    }


    window.addEventListener(
      "scroll",
      update,
      {
        passive: true,
      }
    );


    window.addEventListener(
      "resize",
      update,
      {
        passive: true,
      }
    );


    topButton?.addEventListener(
      "click",
      () => {

        window.scrollTo({
          top: 0,
          behavior: "smooth",
        });

      }
    );


    update();

  }


  if (
    document.readyState
    === "loading"
  ) {
    document.addEventListener(
      "DOMContentLoaded",
      initGuideArticle,
      {
        once: true,
      }
    );
  } else {
    initGuideArticle();
  }
</script>


<style is:global>

  .article-page {
    background:
      #dad4e4;
  }


  /* =========================================================
     HERO
     ========================================================= */

  .article-hero {
    position: relative;

    overflow: hidden;

    padding:
      64px 0 58px;

    border-bottom:
      1px solid #c9c1d4;

    background:
      linear-gradient(
        135deg,
        #e6dff0,
        #d8d5e8
      );
  }


  .article-hero-glow {
    position: absolute;

    top: -350px;
    right: -170px;

    width: 700px;
    height: 700px;

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(
          105,
          82,
          238,
          0.18
        ),
        transparent 68%
      );
  }


  .article-hero-inner {
    position: relative;

    z-index: 2;

    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items: end;

    gap: 60px;
  }


  .article-back {
    display: inline-flex;

    align-items: center;

    gap: 7px;

    margin-bottom: 28px;

    color:
      #766d81;

    font-size: 9px;

    font-weight: 700;
  }


  .article-back:hover {
    color:
      #6952ee;
  }


  .article-badge,
  .article-section {
    display: inline-flex;

    align-items: center;

    min-height: 24px;

    padding:
      0 8px;

    border-radius: 999px;

    font-size: 6px;

    font-weight: 850;

    letter-spacing:
      0.08em;
  }


  .article-badge {
    background:
      #6952ee;

    color:
      white;
  }


  .article-section {
    margin-left: 6px;

    border:
      1px solid #c7bfd1;

    background:
      rgba(
        255,
        255,
        255,
        0.35
      );

    color:
      #756c80;
  }


  .article-hero h1 {
    max-width: 760px;

    margin:
      19px 0 14px;

    color:
      #1d1827;

    font-size:
      clamp(
        48px,
        6.5vw,
        74px
      );

    line-height:
      0.96;

    letter-spacing:
      -0.06em;
  }


  .article-hero p {
    max-width: 680px;

    margin: 0;

    color:
      #71687d;

    font-size: 13px;

    line-height: 1.75;
  }


  .article-meta {
    display: flex;

    align-items: center;

    gap: 18px;

    padding: 15px 18px;

    border:
      1px solid #c5bdcf;

    border-radius: 13px;

    background:
      rgba(
        247,
        243,
        250,
        0.58
      );
  }


  .article-meta > span {
    width: 1px;
    height: 30px;

    background:
      #c8c0d2;
  }


  .article-meta small {
    display: block;

    color:
      #948b9f;

    font-size: 6px;
  }


  .article-meta strong {
    display: block;

    margin-top: 3px;

    color:
      #282231;

    font-size: 9px;
  }


  /* =========================================================
     LAYOUT
     ========================================================= */

  .article-body {
    padding:
      42px 0 95px;

    background:
      linear-gradient(
        180deg,
        #d9d3e3,
        #e1dbe8
      );
  }


  .article-layout {
    display: grid;

    grid-template-columns:
      250px minmax(0, 1fr);

    align-items: start;

    gap: 28px;
  }


  .article-content {
    min-width: 0;

    color:
      #292331;
  }


  /* =========================================================
     ARTICLE TYPOGRAPHY
     ========================================================= */

  .article-section-block {
    scroll-margin-top:
      105px;

    margin-bottom: 24px;

    padding: 26px;

    border:
      1px solid #c7bfd1;

    border-radius: 17px;

    background:
      rgba(
        245,
        241,
        249,
        0.79
      );

    box-shadow:
      0 8px 22px
      rgba(
        45,
        34,
        61,
        0.04
      );
  }


  .article-section-block
  > .section-number {
    display: inline-grid;

    width: 31px;
    height: 31px;

    place-items: center;

    margin-bottom: 15px;

    border-radius: 9px;

    background:
      #e3dcfb;

    color:
      #6952ee;

    font-size: 7px;

    font-weight: 850;
  }


  .article-section-block h2 {
    margin:
      0 0 10px;

    color:
      #211b2b;

    font-size:
      clamp(
        24px,
        3vw,
        34px
      );

    line-height:
      1.05;

    letter-spacing:
      -0.045em;
  }


  .article-section-block h3 {
    margin:
      22px 0 8px;

    color:
      #282130;

    font-size: 16px;

    letter-spacing:
      -0.025em;
  }


  .article-section-block p {
    margin:
      10px 0;

    color:
      #706778;

    font-size: 11px;

    line-height: 1.75;
  }


  .article-section-block strong {
    color:
      #292230;
  }


  /* =========================================================
     STEPS
     ========================================================= */

  .guide-steps {
    display: grid;

    gap: 9px;

    margin-top: 18px;
  }


  .guide-step {
    display: grid;

    grid-template-columns:
      auto 1fr;

    gap: 12px;

    padding: 14px;

    border:
      1px solid #d0c8d9;

    border-radius: 11px;

    background:
      rgba(
        255,
        255,
        255,
        0.43
      );
  }


  .guide-step-number {
    display: grid;

    width: 32px;
    height: 32px;

    place-items: center;

    border-radius: 9px;

    background:
      #6952ee;

    color:
      white;

    font-size: 7px;

    font-weight: 850;

    box-shadow:
      0 8px 18px
      rgba(
        105,
        82,
        238,
        0.18
      );
  }


  .guide-step strong {
    display: block;

    font-size: 10px;
  }


  .guide-step p {
    margin:
      4px 0 0;

    font-size: 9px;

    line-height: 1.6;
  }


  /* =========================================================
     INFO / TIP / WARNING
     ========================================================= */

  .guide-callout {
    display: grid;

    grid-template-columns:
      auto 1fr;

    gap: 10px;

    margin-top: 16px;

    padding: 13px;

    border-radius: 11px;
  }


  .guide-callout > span {
    display: grid;

    width: 29px;
    height: 29px;

    place-items: center;

    border-radius: 8px;

    font-size: 9px;

    font-weight: 850;
  }


  .guide-callout strong {
    display: block;

    font-size: 9px;
  }


  .guide-callout p {
    margin:
      3px 0 0;

    font-size: 8px;

    line-height: 1.55;
  }


  .guide-callout.tip {
    border:
      1px solid #c9bff5;

    background:
      #e9e3fb;
  }


  .guide-callout.tip > span {
    background:
      #6952ee;

    color: white;
  }


  .guide-callout.info {
    border:
      1px solid #bfd2e8;

    background:
      #e3ebf5;
  }


  .guide-callout.info > span {
    background:
      #557fdc;

    color: white;
  }


  .guide-callout.warning {
    border:
      1px solid #e1cba9;

    background:
      #f2e7d5;
  }


  .guide-callout.warning > span {
    background:
      #c6823f;

    color: white;
  }


  /* =========================================================
     EXAMPLE
     ========================================================= */

  .guide-example {
    display: grid;

    grid-template-columns:
      1fr auto 1fr;

    align-items: center;

    gap: 12px;

    margin-top: 17px;

    padding: 17px;

    border:
      1px solid #c8c0d2;

    border-radius: 12px;

    background:
      #e5dfed;
  }


  .guide-example small {
    display: block;

    margin-bottom: 5px;

    color:
      #948a9f;

    font-size: 6px;

    font-weight: 850;

    letter-spacing:
      0.08em;
  }


  .guide-example strong {
    font-size: 11px;
  }


  .guide-example > span {
    color:
      #6952ee;

    font-size: 15px;
  }


  /* =========================================================
     SHORTCUT
     ========================================================= */

  .shortcut-display {
    display: flex;

    flex-wrap: wrap;

    align-items: center;

    gap: 6px;

    margin-top: 15px;
  }


  .shortcut-display kbd {
    display: inline-grid;

    min-width: 47px;
    height: 34px;

    place-items: center;

    padding:
      0 8px;

    border:
      1px solid #bdb4c9;

    border-radius: 8px;

    background:
      #f0ebf5;

    color:
      #292231;

    font-size: 8px;

    font-weight: 750;

    box-shadow:
      0 2px 0 #bbb1c7;
  }


  .shortcut-display > span {
    color:
      #887e93;

    font-size: 8px;
  }


  /* =========================================================
     CHECKLIST
     ========================================================= */

  .guide-checklist {
    display: grid;

    gap: 7px;

    margin-top: 15px;
  }


  .guide-checklist > div {
    display: grid;

    grid-template-columns:
      auto 1fr;

    align-items: start;

    gap: 9px;

    padding:
      10px 12px;

    border:
      1px solid #d0c8d9;

    border-radius: 9px;

    background:
      rgba(
        255,
        255,
        255,
        0.35
      );
  }


  .guide-checklist
  > div > span {
    display: grid;

    width: 20px;
    height: 20px;

    place-items: center;

    border-radius: 6px;

    background:
      #dcece4;

    color:
      #3b9b72;

    font-size: 7px;

    font-weight: 850;
  }


  .guide-checklist strong {
    font-size: 9px;
  }


  .guide-checklist p {
    margin:
      2px 0 0;

    font-size: 8px;
  }


  /* =========================================================
     TROUBLESHOOTING
     ========================================================= */

  .trouble-list {
    display: grid;

    gap: 8px;

    margin-top: 16px;
  }


  .trouble-item {
    overflow: hidden;

    border:
      1px solid #ccc4d5;

    border-radius: 11px;

    background:
      rgba(
        255,
        255,
        255,
        0.42
      );
  }


  .trouble-item summary {
    display: grid;

    grid-template-columns:
      auto 1fr auto;

    align-items: center;

    gap: 10px;

    min-height: 48px;

    padding:
      0 13px;

    cursor: pointer;

    list-style: none;

    color:
      #2b2432;

    font-size: 9px;

    font-weight: 750;
  }


  .trouble-item
  summary::-webkit-details-marker {
    display: none;
  }


  .trouble-item summary > span:first-child {
    display: grid;

    width: 27px;
    height: 27px;

    place-items: center;

    border-radius: 8px;

    background:
      #f1e4d3;

    color:
      #c6823f;
  }


  .trouble-item summary > span:last-child {
    color:
      #958b9f;
  }


  .trouble-item[open]
  summary > span:last-child {
    transform:
      rotate(45deg);
  }


  .trouble-body {
    padding:
      0 14px 14px 51px;
  }


  .trouble-body p {
    margin: 0;
  }


  /* =========================================================
     NEXT GUIDE
     ========================================================= */

  .next-guide {
    display: grid;

    grid-template-columns:
      1fr auto;

    align-items: center;

    gap: 20px;

    margin-top: 28px;

    padding: 23px;

    border-radius: 16px;

    background:
      #17131f;

    color: white;
  }


  .next-guide small {
    display: block;

    color:
      #827b8d;

    font-size: 6px;

    letter-spacing:
      0.08em;
  }


  .next-guide strong {
    display: block;

    margin-top: 4px;

    color:
      #f4f0f8;

    font-size: 17px;
  }


  .next-guide p {
    margin:
      5px 0 0;

    color:
      #8d8697;

    font-size: 8px;
  }


  .next-guide > a {
    display: grid;

    width: 42px;
    height: 42px;

    place-items: center;

    border-radius: 11px;

    background:
      #6952ee;

    color: white;

    font-size: 14px;
  }


  /* =========================================================
     PROGRESS
     ========================================================= */

  .article-progress {
    position: fixed;

    z-index: 999;

    top: 0;
    left: 0;

    width: 100%;
    height: 3px;

    pointer-events: none;
  }


  .article-progress span {
    display: block;

    width: 0;
    height: 100%;

    background:
      linear-gradient(
        90deg,
        #6952ee,
        #557fdc
      );
  }


  .article-top {
    position: fixed;

    z-index: 90;

    right: 20px;
    bottom: 20px;

    display: grid;

    width: 41px;
    height: 41px;

    place-items: center;

    transform:
      translateY(10px);

    opacity: 0;

    pointer-events: none;

    border: 0;

    border-radius: 11px;

    background:
      #17131f;

    color: white;

    cursor: pointer;

    transition:
      opacity 160ms ease,
      transform 160ms ease,
      background 160ms ease;
  }


  .article-top.visible {
    transform:
      translateY(0);

    opacity: 1;

    pointer-events: auto;
  }


  .article-top:hover {
    background:
      #6952ee;
  }


  @media (max-width: 1000px) {

    .article-layout {
      grid-template-columns:
        1fr;
    }


    .article-hero-inner {
      grid-template-columns:
        1fr;
    }


    .article-meta {
      width: fit-content;
    }

  }


  @media (max-width: 650px) {

    .article-section-block {
      padding: 20px;
    }


    .guide-example {
      grid-template-columns:
        1fr;
    }


    .guide-example > span {
      transform:
        rotate(90deg);

      justify-self: center;
    }

  }

</style>
