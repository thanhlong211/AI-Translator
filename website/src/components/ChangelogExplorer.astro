---
import {
  changelogReleases,
  changelogStats,
} from "../data/changelog";


const filters = [
  {
    id: "all",
    vi: "Tất cả",
    en: "All",
    count: changelogStats.items,
  },

  {
    id: "new",
    vi: "Mới",
    en: "New",
    count: changelogStats.new,
  },

  {
    id: "improved",
    vi: "Cải thiện",
    en: "Improved",
    count: changelogStats.improved,
  },

  {
    id: "fixed",
    vi: "Đã sửa",
    en: "Fixed",
    count: changelogStats.fixed,
  },
];


const typeLabel = {
  new: {
    vi: "Mới",
    en: "New",
  },

  improved: {
    vi: "Cải thiện",
    en: "Improved",
  },

  fixed: {
    vi: "Đã sửa",
    en: "Fixed",
  },
};
---

<section
  class="changelog-explorer"
  data-changelog-explorer
>

  <!-- FILTER -->

  <div class="changelog-toolbar">

    <div
      class="changelog-filters"
      role="tablist"
    >

      {
        filters.map(
          (filter, index) => (

            <button
              type="button"
              class={index === 0 ? "active" : ""}
              data-changelog-filter={filter.id}
              aria-selected={index === 0 ? "true" : "false"}
            >

              <span
                data-i18n
                data-vi={filter.vi}
                data-en={filter.en}
              >
                {filter.vi}
              </span>

              <small>
                {filter.count}
              </small>

            </button>

          )
        )
      }

    </div>


    <div class="changelog-toolbar-actions">

      <button
        type="button"
        data-expand-releases
      >
        <span>＋</span>

        <span
          data-i18n
          data-vi="Mở tất cả"
          data-en="Expand all"
        >
          Mở tất cả
        </span>
      </button>


      <button
        type="button"
        data-collapse-releases
      >
        <span>−</span>

        <span
          data-i18n
          data-vi="Thu gọn"
          data-en="Collapse all"
        >
          Thu gọn
        </span>
      </button>

    </div>

  </div>


  <!-- RESULT -->

  <div class="changelog-result-meta">

    <span>

      <strong data-changelog-count>
        {changelogStats.items}
      </strong>

      <span
        data-i18n
        data-vi=" thay đổi"
        data-en=" changes"
      >
        {" "}thay đổi
      </span>

    </span>


    <span
      data-i18n
      data-vi="Chỉ hiển thị những thay đổi công khai có ý nghĩa với người dùng."
      data-en="Only meaningful public-facing changes are shown."
    >
      Chỉ hiển thị những thay đổi công khai
      có ý nghĩa với người dùng.
    </span>

  </div>


  <!-- RELEASES -->

  <div class="changelog-timeline">

    {
      changelogReleases.map(
        (release, releaseIndex) => (

          <article
            class="changelog-release"
            data-release
            data-release-id={release.id}
          >

            <div class="timeline-rail">

              <span
                class:list={[
                  "timeline-node",
                  releaseIndex === 0
                    && "latest",
                ]}
              >
              </span>

              <i></i>

            </div>


            <details
              class="release-details"
              open={releaseIndex === 0}
            >

              <summary>

                <div class="release-heading">

                  <span class="release-channel">
                    {release.channel}
                  </span>

                  <div>

                    <h2>
                      {release.label}
                    </h2>

                    <p
                      data-i18n
                      data-vi={release.summaryVi}
                      data-en={release.summaryEn}
                    >
                      {release.summaryVi}
                    </p>

                  </div>

                </div>


                <div class="release-summary-meta">

                  <span
                    data-release-visible-count
                  >
                    {release.items.length}
                  </span>

                  <small
                    data-i18n
                    data-vi=" thay đổi"
                    data-en=" changes"
                  >
                    {" "}thay đổi
                  </small>

                  <i>
                    +
                  </i>

                </div>

              </summary>


              <div class="release-items">

                {
                  release.items.map(
                    (item) => (

                      <div
                        class={`change-item change-${item.type}`}
                        data-change-item
                        data-type={item.type}
                      >

                        <div class="change-type">

                          <span></span>

                          <strong
                            data-i18n
                            data-vi={typeLabel[item.type].vi}
                            data-en={typeLabel[item.type].en}
                          >
                            {typeLabel[item.type].vi}
                          </strong>

                        </div>


                        <div class="change-content">

                          <small>
                            {item.area}
                          </small>

                          <h3
                            data-i18n
                            data-vi={item.titleVi}
                            data-en={item.title}
                          >
                            {item.titleVi}
                          </h3>

                          <p
                            data-i18n
                            data-vi={item.descriptionVi}
                            data-en={item.descriptionEn}
                          >
                            {item.descriptionVi}
                          </p>


                          {
                            item.guide
                            && (
                              <a href={item.guide}>

                                <span
                                  data-i18n
                                  data-vi="Xem hướng dẫn"
                                  data-en="Open guide"
                                >
                                  Xem hướng dẫn
                                </span>

                                →

                              </a>
                            )
                          }

                        </div>

                      </div>

                    )
                  )
                }

              </div>

            </details>

          </article>

        )
      )
    }

  </div>


  <div
    class="changelog-empty"
    data-changelog-empty
    hidden
  >

    <span>?</span>

    <strong
      data-i18n
      data-vi="Không có thay đổi thuộc nhóm này."
      data-en="There are no changes in this category."
    >
      Không có thay đổi thuộc nhóm này.
    </strong>

  </div>

</section>


<script>
  function initChangelogExplorer() {

    const root =
      document.querySelector(
        "[data-changelog-explorer]"
      );


    if (!root) {
      return;
    }


    const filters =
      Array.from(
        root.querySelectorAll(
          "[data-changelog-filter]"
        )
      );


    const releases =
      Array.from(
        root.querySelectorAll(
          "[data-release]"
        )
      );


    const allItems =
      Array.from(
        root.querySelectorAll(
          "[data-change-item]"
        )
      );


    const count =
      root.querySelector(
        "[data-changelog-count]"
      );


    const empty =
      root.querySelector(
        "[data-changelog-empty]"
      );


    const valid =
      filters
        .map(
          button =>
            button.dataset.changelogFilter
        )
        .filter(Boolean);


    const storageKey =
      "aitranova-changelog-filter";


    function applyFilter(
      filter,
      updateUrl = true
    ) {

      if (
        !valid.includes(filter)
      ) {
        filter = "all";
      }


      filters.forEach(
        button => {

          const active =
            button.dataset.changelogFilter
            === filter;


          button.classList.toggle(
            "active",
            active
          );


          button.setAttribute(
            "aria-selected",
            String(active)
          );

        }
      );


      let totalVisible =
        0;


      releases.forEach(
        release => {

          const items =
            Array.from(
              release.querySelectorAll(
                "[data-change-item]"
              )
            );


          let releaseVisible =
            0;


          items.forEach(
            item => {

              const show =
                filter === "all"
                || item.dataset.type
                  === filter;


              item.hidden =
                !show;


              if (show) {

                releaseVisible++;

                totalVisible++;


                if (
                  typeof item.animate
                  === "function"
                ) {

                  item.animate(
                    [
                      {
                        opacity: 0,
                        transform:
                          "translateY(5px)",
                      },

                      {
                        opacity: 1,
                        transform:
                          "translateY(0)",
                      },
                    ],
                    {
                      duration: 160,
                      easing: "ease-out",
                    }
                  );

                }

              }

            }
          );


          release.hidden =
            releaseVisible === 0;


          const releaseCount =
            release.querySelector(
              "[data-release-visible-count]"
            );


          if (releaseCount) {

            releaseCount.textContent =
              String(
                releaseVisible
              );

          }

        }
      );


      if (count) {

        count.textContent =
          String(
            totalVisible
          );

      }


      if (empty) {

        empty.hidden =
          totalVisible !== 0;

      }


      try {

        localStorage.setItem(
          storageKey,
          filter
        );

      } catch {}


      if (updateUrl) {

        const url =
          new URL(
            window.location.href
          );


        if (
          filter === "all"
        ) {

          url.searchParams.delete(
            "type"
          );

        } else {

          url.searchParams.set(
            "type",
            filter
          );

        }


        history.replaceState(
          null,
          "",
          url
        );

      }

    }


    filters.forEach(
      button => {

        button.addEventListener(
          "click",
          () => {

            const filter =
              button.dataset
                .changelogFilter;


            if (filter) {

              applyFilter(
                filter
              );

            }

          }
        );


        button.addEventListener(
          "keydown",
          event => {

            if (
              event.key !== "ArrowLeft"
              && event.key !== "ArrowRight"
            ) {
              return;
            }


            event.preventDefault();


            const index =
              filters.indexOf(
                button
              );


            const direction =
              event.key === "ArrowRight"
                ? 1
                : -1;


            const next =
              filters[
                (
                  index
                  + direction
                  + filters.length
                )
                % filters.length
              ];


            next.focus();


            const filter =
              next.dataset
                .changelogFilter;


            if (filter) {

              applyFilter(
                filter
              );

            }

          }
        );

      }
    );


    root.querySelector(
      "[data-expand-releases]"
    )
    ?.addEventListener(
      "click",
      () => {

        root.querySelectorAll(
          ".release-details"
        )
        .forEach(
          details => {

            if (
              details instanceof
              HTMLDetailsElement
              && !details.closest(
                "[data-release]"
              )?.hidden
            ) {

              details.open =
                true;

            }

          }
        );

      }
    );


    root.querySelector(
      "[data-collapse-releases]"
    )
    ?.addEventListener(
      "click",
      () => {

        root.querySelectorAll(
          ".release-details"
        )
        .forEach(
          details => {

            if (
              details instanceof
              HTMLDetailsElement
            ) {

              details.open =
                false;

            }

          }
        );

      }
    );


    const params =
      new URLSearchParams(
        window.location.search
      );


    const requested =
      params.get(
        "type"
      );


    let stored =
      null;


    try {

      stored =
        localStorage.getItem(
          storageKey
        );

    } catch {}


    applyFilter(
      requested
      || stored
      || "all",
      Boolean(requested)
    );

  }


  if (
    document.readyState
    === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initChangelogExplorer,
      {
        once: true,
      }
    );

  } else {

    initChangelogExplorer();

  }
</script>


<style>

  .changelog-explorer {
    margin-top: 34px;
  }


  /* TOOLBAR */

  .changelog-toolbar {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    gap: 20px;
  }


  .changelog-filters {
    display: grid;

    grid-template-columns:
      repeat(
        4,
        minmax(0, 1fr)
      );

    gap: 5px;

    width: min(
      100%,
      620px
    );

    padding: 6px;

    border:
      1px solid #c3bacd;

    border-radius: 14px;

    background:
      rgba(
        218,
        211,
        228,
        0.74
      );
  }


  .changelog-filters button {
    display: flex;

    min-height: 42px;

    align-items: center;

    justify-content: center;

    gap: 7px;

    border: 0;

    border-radius: 9px;

    background: transparent;

    color: #756b7f;

    cursor: pointer;

    font-size: 7px;

    font-weight: 750;

    transition:
      transform 150ms ease,
      background 150ms ease,
      color 150ms ease,
      box-shadow 150ms ease;
  }


  .changelog-filters
  button:hover {
    transform:
      translateY(-1px);

    background:
      rgba(
        255,
        255,
        255,
        0.36
      );
  }


  .changelog-filters
  button.active {
    background: #6952ee;

    color: white;

    box-shadow:
      0 8px 20px
      rgba(
        105,
        82,
        238,
        0.22
      );
  }


  .changelog-filters small {
    display: grid;

    min-width: 19px;
    height: 19px;

    place-items: center;

    padding:
      0 4px;

    border-radius: 999px;

    background:
      rgba(
        255,
        255,
        255,
        0.4
      );

    font-size: 5px;
  }


  .changelog-filters
  button.active small {
    background:
      rgba(
        255,
        255,
        255,
        0.15
      );
  }


  .changelog-toolbar-actions {
    display: flex;

    gap: 6px;
  }


  .changelog-toolbar-actions button {
    display: inline-flex;

    min-height: 32px;

    align-items: center;

    gap: 6px;

    padding:
      0 9px;

    border:
      1px solid #c4bacf;

    border-radius: 8px;

    background:
      rgba(
        244,
        240,
        247,
        0.42
      );

    color: #6d6477;

    cursor: pointer;

    font-size: 6px;

    font-weight: 750;
  }


  /* META */

  .changelog-result-meta {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    gap: 20px;

    margin:
      18px 0 18px;

    color: #847a8f;

    font-size: 6px;
  }


  .changelog-result-meta
  strong {
    color: #2d2635;

    font-size: 8px;
  }


  /* TIMELINE */

  .changelog-timeline {
    display: grid;

    gap: 0;
  }


  .changelog-release {
    display: grid;

    grid-template-columns:
      36px 1fr;

    gap: 10px;
  }


  .changelog-release[hidden] {
    display: none !important;
  }


  .timeline-rail {
    display: flex;

    align-items: center;

    flex-direction: column;
  }


  .timeline-node {
    position: relative;

    z-index: 2;

    display: block;

    flex: 0 0 auto;

    width: 12px;
    height: 12px;

    margin-top: 25px;

    border:
      3px solid #d9d3e1;

    border-radius: 50%;

    background: #82768e;
  }


  .timeline-node.latest {
    border-color: #dcd5ff;

    background: #6952ee;

    box-shadow:
      0 0 0 5px
      rgba(
        105,
        82,
        238,
        0.1
      );
  }


  .timeline-rail i {
    width: 1px;

    flex: 1;

    min-height: 22px;

    background: #c5bccf;
  }


  /* RELEASE DETAILS */

  .release-details {
    overflow: hidden;

    margin-bottom: 12px;

    border:
      1px solid #c6bdcf;

    border-radius: 16px;

    background:
      rgba(
        241,
        236,
        246,
        0.67
      );

    box-shadow:
      0 11px 30px
      rgba(
        49,
        37,
        65,
        0.045
      );
  }


  .release-details
  > summary {
    display: grid;

    grid-template-columns:
      1fr auto;

    align-items: center;

    gap: 25px;

    min-height: 104px;

    padding:
      18px 20px;

    cursor: pointer;

    list-style: none;
  }


  .release-details
  > summary::-webkit-details-marker {
    display: none;
  }


  .release-heading {
    display: grid;

    grid-template-columns:
      auto 1fr;

    align-items: center;

    gap: 14px;
  }


  .release-channel {
    display: grid;

    width: 45px;
    height: 45px;

    place-items: center;

    border-radius: 12px;

    background: #e3dcfb;

    color: #6952ee;

    font-size: 6px;

    font-weight: 850;
  }


  .release-heading h2 {
    margin: 0;

    color: #282130;

    font-size: 22px;

    letter-spacing:
      -0.04em;
  }


  .release-heading p {
    max-width: 660px;

    margin:
      5px 0 0;

    color: #7a7084;

    font-size: 7px;

    line-height: 1.55;
  }


  .release-summary-meta {
    display: flex;

    align-items: center;

    gap: 4px;

    color: #847a8e;
  }


  .release-summary-meta
  > span {
    color: #332b3c;

    font-size: 9px;

    font-weight: 800;
  }


  .release-summary-meta small {
    font-size: 6px;
  }


  .release-summary-meta i {
    margin-left: 10px;

    color: #6952ee;

    font-size: 14px;

    font-style: normal;

    transition:
      transform 150ms ease;
  }


  .release-details[open]
  .release-summary-meta i {
    transform:
      rotate(45deg);
  }


  /* ITEMS */

  .release-items {
    display: grid;

    gap: 0;

    padding:
      0 20px 20px;
  }


  .change-item {
    display: grid;

    grid-template-columns:
      95px 1fr;

    gap: 18px;

    padding:
      18px 0;

    border-top:
      1px solid #cec5d7;
  }


  .change-item[hidden] {
    display: none !important;
  }


  .change-type {
    display: flex;

    align-items: flex-start;

    gap: 7px;

    padding-top: 3px;
  }


  .change-type > span {
    width: 7px;
    height: 7px;

    margin-top: 2px;

    border-radius: 50%;
  }


  .change-new
  .change-type > span {
    background: #6952ee;
  }


  .change-improved
  .change-type > span {
    background: #557fdc;
  }


  .change-fixed
  .change-type > span {
    background: #3b9b72;
  }


  .change-type strong {
    color: #786e82;

    font-size: 6px;
  }


  .change-content small {
    display: block;

    color: #978da1;

    font-size: 5px;

    font-weight: 850;

    letter-spacing:
      0.1em;
  }


  .change-content h3 {
    margin:
      4px 0 6px;

    color: #312939;

    font-size: 13px;

    letter-spacing:
      -0.025em;
  }


  .change-content p {
    max-width: 720px;

    margin: 0;

    color: #786f82;

    font-size: 7px;

    line-height: 1.6;
  }


  .change-content a {
    display: inline-flex;

    align-items: center;

    gap: 7px;

    margin-top: 9px;

    color: #6952ee;

    font-size: 6px;

    font-weight: 800;
  }


  /* EMPTY */

  .changelog-empty {
    margin-top: 12px;

    padding:
      38px 20px;

    border:
      1px dashed #c3b9cd;

    border-radius: 15px;

    text-align: center;
  }


  .changelog-empty[hidden] {
    display: none;
  }


  .changelog-empty > span {
    display: grid;

    width: 39px;
    height: 39px;

    place-items: center;

    margin:
      0 auto 10px;

    border-radius: 11px;

    background: #e2dce9;

    color: #7b7186;

    font-size: 14px;
  }


  .changelog-empty strong {
    font-size: 9px;
  }


  @media (max-width: 720px) {

    .changelog-toolbar {
      align-items: stretch;

      flex-direction: column;
    }


    .changelog-filters {
      width: 100%;
    }


    .changelog-toolbar-actions {
      justify-content: flex-end;
    }


    .changelog-release {
      grid-template-columns:
        20px 1fr;
    }


    .release-details
    > summary {
      grid-template-columns: 1fr;
    }


    .release-summary-meta {
      justify-content: flex-start;
    }

  }


  @media (max-width: 540px) {

    .changelog-filters {
      grid-template-columns:
        1fr 1fr;
    }


    .release-heading {
      grid-template-columns: 1fr;
    }


    .change-item {
      grid-template-columns: 1fr;

      gap: 8px;
    }

  }

</style>
