---
const roadmapItems = [
  {
    id: "cross-page-context",
    status: "available",
    area: "MANGA",
    icon: "↺",
    title: "Cross-page Manga Context",
    titleVi: "Context Manga qua nhiều trang",
    descriptionVi:
      "Trang hiện tại có thể sử dụng recent context phù hợp từ những trang trước trong cùng workflow.",
    descriptionEn:
      "The current page can use relevant recent context from previous pages in the same workflow.",
    guide: "/guide/manga",
    tags: ["Manga", "Context"],
  },

  {
    id: "translation-profiles",
    status: "available",
    area: "CONTROL",
    icon: "✦",
    title: "Translation Profiles",
    titleVi: "Translation Profiles",
    descriptionVi:
      "Tách quy tắc dịch theo từng loại nội dung với Glossary, Character Rules và các cấu hình liên quan.",
    descriptionEn:
      "Separate translation rules by content type using Glossary entries, Character Rules and related settings.",
    guide: "/guide/profile",
    tags: ["Profiles", "Glossary"],
  },

  {
    id: "translation-memory",
    status: "available",
    area: "MEMORY",
    icon: "M",
    title: "Personal Translation Memory",
    titleVi: "Personal Translation Memory",
    descriptionVi:
      "Sử dụng những dữ liệu dịch phù hợp để hỗ trợ tính nhất quán mà không thay thế source hiện tại.",
    descriptionEn:
      "Use relevant translation data to support consistency without replacing the current source.",
    guide: "/guide/profile?tab=context",
    tags: ["Memory", "Context"],
  },

  {
    id: "manga-session",
    status: "available",
    area: "MANGA",
    icon: "漫",
    title: "Manga Session",
    titleVi: "Manga Session",
    descriptionVi:
      "Workflow dành cho việc dịch liên tục nhiều trang manga thay vì xử lý từng ảnh hoàn toàn độc lập.",
    descriptionEn:
      "A workflow for translating multiple manga pages continuously instead of treating every image as isolated.",
    guide: "/guide/manga",
    tags: ["Manga", "Session"],
  },

  {
    id: "batch-translation",
    status: "available",
    area: "TRANSLATION",
    icon: "▦",
    title: "Batch Translation",
    titleVi: "Batch Translation",
    descriptionVi:
      "Xử lý nhiều block trong cùng một batch để cải thiện tính nhất quán trong nội dung hiện tại.",
    descriptionEn:
      "Process multiple blocks in the same batch to improve consistency within the current content.",
    guide: "/guide/manga#manga-batch",
    tags: ["Batch", "Manga"],
  },

  {
    id: "automatic-character-consistency",
    status: "development",
    area: "MANGA",
    icon: "名",
    title: "Automatic Character Consistency",
    titleVi: "Tự động giữ tính nhất quán nhân vật",
    descriptionVi:
      "Mở rộng hệ thống continuity để giảm việc tên nhân vật thay đổi giữa các lần xuất hiện.",
    descriptionEn:
      "Expand continuity behavior to reduce character-name variation across repeated appearances.",
    tags: ["Characters", "Continuity"],
  },

  {
