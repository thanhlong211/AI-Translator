    id: "continuity-review",
    status: "development",
    area: "REVIEW",
    icon: "◎",
    title: "Continuity Review",
    titleVi: "Continuity Review",
    descriptionVi:
      "Cho phép người dùng xem và kiểm soát những mapping continuity quan trọng rõ ràng hơn.",
    descriptionEn:
      "Give users clearer visibility and control over important continuity mappings.",
    tags: ["Continuity", "Review"],
  },

  {
    id: "speaker-awareness",
    status: "planned",
    area: "CONTEXT",
    icon: "◉",
    title: "Speaker Awareness",
    titleVi: "Nhận biết người nói",
    descriptionVi:
      "Bổ sung tín hiệu speaker để AI có thêm thông tin khi xử lý hội thoại.",
    descriptionEn:
      "Add speaker signals so the AI has more information when processing dialogue.",
    tags: ["Speaker", "Context"],
  },

  {
    id: "vertical-japanese-ocr",
    status: "planned",
    area: "OCR",
    icon: "縦",
    title: "Better Vertical Japanese OCR",
    titleVi: "Cải thiện OCR tiếng Nhật dọc",
    descriptionVi:
      "Tăng độ ổn định khi nhận dạng văn bản tiếng Nhật viết theo chiều dọc.",
    descriptionEn:
      "Improve recognition stability for vertically written Japanese text.",
    tags: ["OCR", "Japanese"],
  },

  {
    id: "more-document-formats",
    status: "planned",
    area: "DOCUMENTS",
    icon: "＋",
    title: "More Document Formats",
    titleVi: "Thêm định dạng tài liệu",
    descriptionVi:
      "Mở rộng Document Reader ngoài những định dạng đang được hỗ trợ hiện tại.",
    descriptionEn:
      "Expand Document Reader beyond the currently supported document formats.",
    tags: ["Documents", "Reader"],
  },

  {
    id: "cloud-sync",
    status: "planned",
    area: "SYNC",
    icon: "☁",
    title: "Cloud Sync",
    titleVi: "Cloud Sync",
    descriptionVi:
      "Đồng bộ dữ liệu phù hợp giữa các môi trường sử dụng AitraNova trong tương lai.",
    descriptionEn:
      "Synchronize appropriate AitraNova data across environments in the future.",
    tags: ["Cloud", "Sync"],
  },
];

const counts = {
  all: roadmapItems.length,
  available: roadmapItems.filter(
    (item) => item.status === "available"
  ).length,
  development: roadmapItems.filter(
    (item) => item.status === "development"
  ).length,
  planned: roadmapItems.filter(
    (item) => item.status === "planned"
  ).length,
};

const filters = [
  {
    id: "all",
    vi: "Tất cả",
    en: "All",
    count: counts.all,
  },
  {
    id: "available",
    vi: "Đã có",
    en: "Available",
    count: counts.available,
  },
  {
    id: "development",
    vi: "Đang phát triển",
    en: "In Development",
    count: counts.development,
  },
  {
    id: "planned",
    vi: "Kế hoạch",
    en: "Planned",
    count: counts.planned,
  },
];

const statusText = {
  available: {
    vi: "Đã có",
    en: "Available",
  },
  development: {
    vi: "Đang phát triển",
    en: "In Development",
  },
  planned: {
    vi: "Kế hoạch",
    en: "Planned",
  },
};
---

<section
  class="roadmap-explorer"
  data-roadmap-explorer
>

  <!-- FILTER -->

  <div
    class="roadmap-filter"
    data-roadmap-filter
  >
    {
      filters.map((filter, index) => (

        <button
          type="button"
          class={index === 0 ? "active" : ""}
          data-roadmap-status={filter.id}
          aria-pressed={index === 0 ? "true" : "false"}
        >

          <span
            data-i18n
            data-vi={filter.vi}
            data-en={filter.en}
          >
            {filter.vi}
          </span>

          <small>
            {filter.count}
          </small>

        </button>

      ))
    }
  </div>


  <!-- RESULT META -->

  <div class="roadmap-result-meta">

    <span>

      <strong data-roadmap-count>
        {counts.all}
      </strong>

      <span
        data-i18n
        data-vi=" mục"
        data-en=" items"
      >
        {" "}mục
      </span>

    </span>


    <span
      data-i18n
      data-vi="Roadmap không phải lịch phát hành cam kết."
      data-en="The roadmap is not a committed release schedule."
    >
      Roadmap không phải lịch phát hành cam kết.
    </span>

  </div>


  <!-- CARDS -->

  <div
    class="roadmap-grid"
    data-roadmap-grid
  >

    {
      roadmapItems.map((item) => (

        <article
          class={`roadmap-item status-${item.status}`}
          data-roadmap-item
          data-status={item.status}
          id={item.id}
        >

          <header class="roadmap-item-top">

            <span class="roadmap-item-icon">
              {item.icon}
            </span>


            <div class="roadmap-item-status">

              <i></i>

              <span
                data-i18n
                data-vi={statusText[item.status].vi}
                data-en={statusText[item.status].en}
              >
                {statusText[item.status].vi}
              </span>

            </div>

          </header>


          <div class="roadmap-item-copy">

            <small>
              {item.area}
            </small>

            <h3
              data-i18n
              data-vi={item.titleVi}
              data-en={item.title}
            >
              {item.titleVi}
            </h3>

            <p
              data-i18n
              data-vi={item.descriptionVi}
              data-en={item.descriptionEn}
            >
              {item.descriptionVi}
            </p>

          </div>


          <div class="roadmap-tags">

            {
              item.tags.map((tag) => (
                <span>
                  {tag}
                </span>
              ))
            }

          </div>


          <footer class="roadmap-item-footer">

            {
              item.status === "available"
              && item.guide
              ? (
                <a href={item.guide}>

                  <span
                    data-i18n
                    data-vi="Xem tính năng"
                    data-en="Explore feature"
                  >
                    Xem tính năng
                  </span>

                  →

                </a>
              )
              : (
                <span class="roadmap-no-date">

                  <i></i>

                  <span
                    data-i18n
                    data-vi={
                      item.status === "development"
                        ? "Đang được phát triển"
                        : "Chưa có lịch phát hành"
                    }
                    data-en={
                      item.status === "development"
                        ? "Currently in development"
                        : "No release date yet"
                    }
                  >
                    {
                      item.status === "development"
                        ? "Đang được phát triển"
                        : "Chưa có lịch phát hành"
                    }
                  </span>

                </span>
              )
            }

          </footer>

        </article>

      ))
    }

  </div>


  <div
    class="roadmap-empty"
    data-roadmap-empty
    hidden
  >

    <span>?</span>

    <strong
      data-i18n
      data-vi="Không có mục Roadmap trong trạng thái này."
      data-en="There are no roadmap items in this state."
    >
      Không có mục Roadmap trong trạng thái này.
    </strong>

  </div>

</section>


<script>
  function initRoadmapExplorer() {

    const root =
      document.querySelector(
        "[data-roadmap-explorer]"
      );

    if (!root) {
      return;
    }


    const buttons =
      Array.from(
        root.querySelectorAll(
          "[data-roadmap-status]"
        )
      );


    const items =
      Array.from(
        root.querySelectorAll(
          "[data-roadmap-item]"
        )
      );


    const count =
      root.querySelector(
        "[data-roadmap-count]"
      );


    const empty =
      root.querySelector(
        "[data-roadmap-empty]"
      );


    const valid =
      buttons
        .map(
          button =>
            button.dataset.roadmapStatus
        )
        .filter(Boolean);


    const storageKey =
      "aitranova-roadmap-status";


    function showStatus(
      status,
      updateUrl = true
    ) {

      if (
        !valid.includes(status)
      ) {
        status = "all";
      }


      buttons.forEach(
        button => {

          const active =
            button.dataset.roadmapStatus
            === status;


          button.classList.toggle(
            "active",
            active
          );


          button.setAttribute(
            "aria-pressed",
            String(active)
          );

        }
      );


      let visible =
        0;


      items.forEach(
        item => {

          const show =
            status === "all"
            || item.dataset.status
              === status;


          item.hidden =
            !show;


          if (show) {

            visible++;


            if (
              typeof item.animate
              === "function"
            ) {

              item.animate(
                [
                  {
                    opacity: 0,
                    transform:
                      "translateY(8px)",
                  },
                  {
                    opacity: 1,
                    transform:
                      "translateY(0)",
                  },
                ],
                {
                  duration: 180,
                  easing: "ease-out",
                }
              );

            }

          }

        }
      );


      if (count) {
        count.textContent =
          String(visible);
      }


      if (empty) {
        empty.hidden =
          visible !== 0;
      }


      try {

        localStorage.setItem(
          storageKey,
          status
        );

      } catch {}


      if (updateUrl) {

        const url =
          new URL(
            window.location.href
          );


        if (
          status === "all"
        ) {

          url.searchParams.delete(
            "status"
          );

        } else {

          url.searchParams.set(
            "status",
            status
          );

        }


        history.replaceState(
          null,
          "",
          url
        );

      }

    }


    buttons.forEach(
      button => {

        button.addEventListener(
          "click",
          () => {

            const status =
              button.dataset.roadmapStatus;


            if (status) {
              showStatus(status);
            }

          }
        );


        button.addEventListener(
          "keydown",
          event => {

            if (
              event.key !== "ArrowLeft"
              && event.key !== "ArrowRight"
            ) {
              return;
            }


            event.preventDefault();


            const index =
              buttons.indexOf(
                button
              );


            const delta =
              event.key === "ArrowRight"
                ? 1
                : -1;


            const next =
              buttons[
                (
                  index
                  + delta
                  + buttons.length
                )
                % buttons.length
              ];


            next.focus();


            const status =
              next.dataset
                .roadmapStatus;


            if (status) {
              showStatus(status);
            }

          }
        );

      }
    );


    const params =
      new URLSearchParams(
        window.location.search
      );


    const requested =
      params.get(
        "status"
      );


    let stored = null;


    try {

      stored =
        localStorage.getItem(
          storageKey
        );

    } catch {}


    showStatus(
      requested
      || stored
      || "all",
      Boolean(requested)
    );

  }


  if (
    document.readyState
    === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initRoadmapExplorer,
      {
        once: true,
      }
    );

  } else {

    initRoadmapExplorer();

  }
</script>


<style>

  .roadmap-explorer {
    margin-top: 34px;
  }


  /* =========================================================
     FILTER
     ========================================================= */

  .roadmap-filter {
    display: grid;

    grid-template-columns:
      repeat(
        4,
        minmax(0, 1fr)
      );

    gap: 5px;

    max-width: 720px;

    padding: 6px;

    border:
      1px solid #c3bacd;

    border-radius: 14px;

    background:
      rgba(
        218,
        211,
        228,
        0.74
      );
  }


  .roadmap-filter button {
    display: flex;

    min-height: 43px;

    align-items: center;

    justify-content: center;

    gap: 7px;

    border: 0;

    border-radius: 9px;

    background: transparent;

    color: #756b7f;

    cursor: pointer;

    font-size: 7px;

    font-weight: 750;

    transition:
      transform 150ms ease,
      background 150ms ease,
      color 150ms ease,
      box-shadow 150ms ease;
  }


  .roadmap-filter button:hover {
    transform:
      translateY(-1px);

    background:
      rgba(
        255,
        255,
        255,
        0.36
      );
  }


  .roadmap-filter button.active {
    background: #6952ee;

    color: white;

    box-shadow:
      0 8px 20px
      rgba(
        105,
        82,
        238,
        0.22
      );
  }


  .roadmap-filter small {
    display: grid;

    min-width: 19px;
    height: 19px;

    place-items: center;

    padding:
      0 4px;

    border-radius: 999px;

    background:
      rgba(
        255,
        255,
        255,
        0.42
      );

    font-size: 5px;
  }


  .roadmap-filter button.active
  small {
    background:
      rgba(
        255,
        255,
        255,
        0.16
      );
  }


  /* =========================================================
     META
     ========================================================= */

  .roadmap-result-meta {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    gap: 20px;

    margin:
      18px 0 12px;

    color: #847a8f;

    font-size: 6px;
  }


  .roadmap-result-meta
  strong {
    color: #2d2635;

    font-size: 8px;
  }


  /* =========================================================
     GRID
     ========================================================= */

  .roadmap-grid {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 10px;
  }


  .roadmap-item {
    position: relative;

    display: flex;

    min-height: 300px;

    flex-direction: column;

    padding: 17px;

    overflow: hidden;

    border:
      1px solid #c7bed1;

    border-radius: 16px;

    background:
      rgba(
        241,
        236,
        246,
        0.68
      );

    box-shadow:
      0 10px 28px
      rgba(
        49,
        37,
        65,
        0.045
      );

    transition:
      transform 170ms ease,
      border-color 170ms ease,
      box-shadow 170ms ease;
  }


  .roadmap-item[hidden] {
    display: none !important;
  }


  .roadmap-item:hover {
    transform:
      translateY(-3px);

    box-shadow:
      0 18px 38px
      rgba(
        48,
        35,
        66,
        0.08
      );
  }


  .roadmap-item.status-available:hover {
    border-color:
      rgba(
        59,
        155,
        114,
        0.38
      );
  }


  .roadmap-item.status-development:hover {
    border-color:
      rgba(
        105,
        82,
        238,
        0.4
      );
  }


  .roadmap-item.status-planned:hover {
    border-color:
      rgba(
        85,
        127,
        220,
        0.36
      );
  }


  /* TOP */

  .roadmap-item-top {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    gap: 10px;
  }


  .roadmap-item-icon {
    display: grid;

    width: 37px;
    height: 37px;

    place-items: center;

    border-radius: 10px;

    font-size: 10px;

    font-weight: 850;
  }


  .status-available
  .roadmap-item-icon {
    background: #dcece4;
    color: #3b9b72;
  }


  .status-development
  .roadmap-item-icon {
    background: #e3dcfb;
    color: #6952ee;
  }


  .status-planned
  .roadmap-item-icon {
    background: #dce6f7;
    color: #557fdc;
  }


  .roadmap-item-status {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    min-height: 25px;

    padding:
      0 8px;

    border-radius: 999px;

    background:
      rgba(
        220,
        214,
        229,
        0.65
      );

    color: #716879;

    font-size: 5px;

    font-weight: 800;
  }


  .roadmap-item-status i {
    width: 5px;
    height: 5px;

    border-radius: 50%;
  }


  .status-available
  .roadmap-item-status i {
    background: #3b9b72;
  }


  .status-development
  .roadmap-item-status i {
    background: #6952ee;

    box-shadow:
      0 0 0 4px
      rgba(
        105,
        82,
        238,
        0.09
      );
  }


  .status-planned
  .roadmap-item-status i {
    border:
      1px solid #557fdc;

    background: transparent;
  }


  /* COPY */

  .roadmap-item-copy {
    margin-top: 25px;
  }


  .roadmap-item-copy small {
    color: #948a9f;

    font-size: 5px;

    font-weight: 850;

    letter-spacing:
      0.11em;
  }


  .roadmap-item-copy h3 {
    margin:
      6px 0 8px;

    color: #282130;

    font-size: 18px;

    line-height: 1.02;

    letter-spacing:
      -0.035em;
  }


  .roadmap-item-copy p {
    margin: 0;

    color: #796f83;

    font-size: 7px;

    line-height: 1.6;
  }


  /* TAGS */

  .roadmap-tags {
    display: flex;

    flex-wrap: wrap;

    gap: 5px;

    margin-top: 15px;
  }


  .roadmap-tags span {
    padding:
      4px 6px;

    border:
      1px solid #cbc2d5;

    border-radius: 999px;

    background:
      rgba(
        255,
        255,
        255,
        0.3
      );

    color: #80768a;

    font-size: 5px;

    font-weight: 700;
  }


  /* FOOTER */

  .roadmap-item-footer {
    display: flex;

    align-items: end;

    min-height: 42px;

    margin-top: auto;

    padding-top: 19px;
  }


  .roadmap-item-footer a {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    color: #6952ee;

    font-size: 6px;

    font-weight: 800;
  }


  .roadmap-no-date {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    color: #91879b;

    font-size: 5px;
  }


  .roadmap-no-date > i {
    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: #a198aa;
  }


  /* EMPTY */

  .roadmap-empty {
    margin-top: 12px;

    padding:
      40px 20px;

    border:
      1px dashed #c3b9cd;

    border-radius: 15px;

    text-align: center;
  }


  .roadmap-empty[hidden] {
    display: none;
  }


  .roadmap-empty > span {
    display: grid;

    width: 40px;
    height: 40px;

    place-items: center;

    margin:
      0 auto 10px;

    border-radius: 11px;

    background: #e3ddea;

    color: #7d7288;

    font-size: 14px;
  }


  .roadmap-empty strong {
