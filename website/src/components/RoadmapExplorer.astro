    status: "development",
    area: "OCR",
    icon: "⇢",
    title: "Improved Manga Reading Order",
    titleVi: "Cải thiện thứ tự đọc Manga",
    descriptionVi:
      "Cải thiện cách các bubble và text block được sắp xếp trước khi translation.",
    descriptionEn:
      "Improve how manga bubbles and text blocks are ordered before translation.",
    tags: ["Manga", "OCR"],
  },

