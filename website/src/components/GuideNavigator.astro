---

<aside
  class="guide-sidebar"
  data-guide-sidebar
>

  <div class="guide-sidebar-inner">

    <div class="guide-sidebar-top">

      <span class="guide-sidebar-kicker">
        DOCUMENTATION
      </span>

      <strong
        data-i18n
        data-vi="Hướng dẫn AitraNova"
        data-en="AitraNova Guide"
      >
        Hướng dẫn AitraNova
      </strong>

    </div>


    <div class="guide-search">

      <span>
        ⌕
      </span>

      <input
        type="search"
        placeholder="Tìm kiếm / Search"
        aria-label="Search guide"
        data-guide-search
      />

      <kbd>/</kbd>

    </div>


    <nav
      class="guide-navigation"
      aria-label="Guide navigation"
    >

      {
        groups.map((group) => (
          <div class="guide-nav-group">

            <span
              class="guide-nav-title"
              data-i18n
              data-vi={group.vi}
              data-en={group.en}
            >
              {group.vi}
            </span>

            <div class="guide-nav-items">

              {
                group.items.map((item) => (
                  <a
                    href={getGuideHref(item.id)}
                    data-guide-nav={item.id}
                    data-search-label={`${item.vi} ${item.en}`}
                  >

                    <span class="guide-nav-icon">
                      {item.icon}
                    </span>

                    <span
                      data-i18n
                      data-vi={item.vi}
                      data-en={item.en}
                    >
                      {item.vi}
                    </span>

                  </a>
                ))
              }

            </div>

          </div>
        ))
      }

    </nav>


    <div class="guide-sidebar-bottom">

