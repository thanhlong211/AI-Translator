<script>
  function initGuideNavigation() {

    const sidebar =
      document.querySelector(
        "[data-guide-sidebar]"
      );

    const toggle =
      document.querySelector(
        "[data-guide-mobile-toggle]"
      );

    const backdrop =
      document.querySelector(
        "[data-guide-backdrop]"
      );

    const search =
      document.querySelector(
        "[data-guide-search]"
      );

    const navLinks =
      Array.from(
        document.querySelectorAll(
          "[data-guide-nav]"
        )
      );

    const searchable =
      Array.from(
        document.querySelectorAll(
          "[data-guide-search-item]"
        )
      );


    /* -----------------------------------------
       MOBILE NAV
       ----------------------------------------- */

    function closeSidebar() {

      sidebar?.classList.remove(
        "open"
      );

      backdrop?.classList.remove(
        "visible"
      );

      document.body.classList.remove(
        "guide-menu-open"
      );

    }


    function openSidebar() {

      sidebar?.classList.add(
        "open"
      );

      backdrop?.classList.add(
        "visible"
      );

      document.body.classList.add(
        "guide-menu-open"
      );

    }


    toggle?.addEventListener(
      "click",
      () => {

        if (
          sidebar?.classList.contains(
            "open"
          )
        ) {
          closeSidebar();
        } else {
          openSidebar();
        }

      }
    );


    backdrop?.addEventListener(
      "click",
      closeSidebar
    );


    navLinks.forEach(
      link => {

        link.addEventListener(
          "click",
          () => {

            if (
              window.innerWidth
              < 1000
            ) {
              closeSidebar();
            }

          }
        );

      }
    );


    /* -----------------------------------------
       SEARCH
       ----------------------------------------- */

    function normalize(value) {

      return value
        .toLocaleLowerCase()
        .normalize("NFD")
        .replace(
          /[\u0300-\u036f]/g,
          ""
        )
        .trim();

    }


    function runSearch() {

      const query =
        normalize(
          search?.value || ""
        );


      searchable.forEach(
        item => {

          const haystack =
            normalize(
              item.getAttribute(
                "data-guide-search-item"
              ) || ""
            );

          item.hidden =
            query.length > 0
            && !haystack.includes(
              query
            );

        }
      );


      navLinks.forEach(
        link => {

          const label =
            normalize(
              link.getAttribute(
                "data-search-label"
              ) || ""
            );

          link.hidden =
            query.length > 0
            && !label.includes(
              query
            );

        }
      );

    }


    search?.addEventListener(
      "input",
      runSearch
    );


    document.addEventListener(
      "keydown",
      event => {

        const target =
          event.target;

        const typing =
          target instanceof
          HTMLInputElement
          || target instanceof
          HTMLTextAreaElement
          || target?.isContentEditable;


        if (
          event.key === "/"
          && !typing
        ) {

          event.preventDefault();

          search?.focus();

        }


        if (
          event.key === "Escape"
          && document.activeElement
          === search
        ) {

          search.value = "";

          runSearch();

          search.blur();

        }

      }
    );


    /* -----------------------------------------
       ACTIVE SECTION
       ----------------------------------------- */

    const sections =
      navLinks
        .map(
          link => {

            const id =
              link.dataset
                .guideNav;

            return id
              ? document.getElementById(
                  id
                )
              : null;

          }
        )
        .filter(Boolean);


    function activate(id) {

      navLinks.forEach(
        link => {

          const active =
            link.dataset
              .guideNav === id;

          link.classList.toggle(
            "active",
            active
          );

        }
      );

    }


    if (
      "IntersectionObserver"
      in window
    ) {

      const observer =
        new IntersectionObserver(
          entries => {

            const visible =
              entries
                .filter(
                  entry =>
                    entry.isIntersecting
                )
                .sort(
                  (a, b) =>
                    b.intersectionRatio
                    - a.intersectionRatio
                );

            if (
              visible.length === 0
            ) {
              return;
            }

            activate(
              visible[0]
                .target
                .id
            );

          },
          {
            rootMargin:
              "-20% 0px -63% 0px",

            threshold: [
              0,
              0.05,
              0.15,
            ],
          }
        );


      sections.forEach(
        section =>
          observer.observe(
            section
          )
      );

    }


    /* -----------------------------------------
       LANGUAGE-AWARE PLACEHOLDER
       ----------------------------------------- */

    function updateSearchLanguage() {

      if (!search) {
        return;
      }

      const language =
        document.documentElement
          .dataset.language
        || "vi";

      search.placeholder =
        language === "en"
          ? "Search the guide..."
          : "Tìm trong hướng dẫn...";

    }


    updateSearchLanguage();


    const languageObserver =
      new MutationObserver(
        updateSearchLanguage
      );


    languageObserver.observe(
      document.documentElement,
      {
        attributes: true,
        attributeFilter: [
          "data-language",
        ],
      }
    );

  }


  if (
    document.readyState
    === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initGuideNavigation,
      {
        once: true,
      }
    );

  } else {

    initGuideNavigation();

  }
</script>







<script>
  function initStableGuideNavigation() {

    const TARGET_KEY =
      "aitranova-guide-target";

    const ROUTE_KEY =
      "aitranova-guide-route";


    const overviewPath = pathname =>
      /^\/guide\/?$/.test(
        pathname
      );


    const guidePath = pathname =>
      /^\/guide(?:\/|$)/.test(
        pathname
      );


    function getTopOffset() {

      const header =
        document.querySelector(
          "header"
        );

      const navbarHeight =
        header
          ? header.getBoundingClientRect()
              .height
          : 70;

      return (
        navbarHeight
        + 24
      );

    }


    function flashSection(
      element
    ) {

      element.classList.remove(
        "guide-focus"
      );

      void element.offsetWidth;

      element.classList.add(
        "guide-focus"
      );


      window.setTimeout(
        () => {

          element.classList.remove(
            "guide-focus"
          );

        },
        1000
      );

    }


    function scrollToSection(
      id,
      behavior = "smooth"
    ) {

      const element =
        document.getElementById(
          id
        );

      if (!element) {
        return false;
      }


      const top =
        element
          .getBoundingClientRect()
          .top
        + window.scrollY
        - getTopOffset();


      window.scrollTo({
        top: Math.max(
          0,
          top
        ),
        behavior,
      });


      flashSection(
        element
      );

      return true;

    }


    function afterLayout(
      callback
    ) {

      requestAnimationFrame(
        () => {

          requestAnimationFrame(
            callback
          );

        }
      );

    }


    /* -----------------------------------------------------
       Disable browser scroll restoration for Guide
       navigation that we control ourselves.
       ----------------------------------------------------- */

    if (
      "scrollRestoration"
      in history
    ) {
      history.scrollRestoration =
        "manual";
    }


    /* -----------------------------------------------------
       HANDLE CLICKS
       ----------------------------------------------------- */

    document.addEventListener(
      "click",
      event => {

        const target =
          event.target;

        if (
          !(target instanceof Element)
        ) {
          return;
        }


        const anchor =
          target.closest(
            "a[href]"
          );

        if (!anchor) {
          return;
        }


        const url =
          new URL(
            anchor.href,
            window.location.href
          );


        if (
          url.origin
          !== window.location.origin
        ) {
          return;
        }


        if (
          !guidePath(
            url.pathname
          )
        ) {
          return;
        }


        const currentIsOverview =
          overviewPath(
            window.location.pathname
          );

        const targetIsOverview =
          overviewPath(
            url.pathname
          );


        /* -----------------------------------------------
           /guide#something

           Do not allow browser native hash jumping.
           ----------------------------------------------- */

        if (
          targetIsOverview
          && url.hash
        ) {

          const id =
            decodeURIComponent(
              url.hash.slice(1)
            );

          event.preventDefault();
          event.stopPropagation();


          if (currentIsOverview) {

            history.pushState(
              null,
              "",
              `/guide#${encodeURIComponent(id)}`
            );


            scrollToSection(
              id,
              "smooth"
            );

          } else {

            sessionStorage.setItem(
              TARGET_KEY,
              id
            );


            window.location.assign(
              "/guide"
            );

          }

          return;
        }


        /* -----------------------------------------------
           Real guide route:
           /guide/quick
           /guide/installation

           Remember that the user explicitly navigated
           there so the next page starts at top.
           ----------------------------------------------- */

        if (
          url.pathname
          !== window.location.pathname
        ) {

          sessionStorage.setItem(
            ROUTE_KEY,
            url.pathname
          );

        }

      },
      true
    );



    /* -----------------------------------------------------
       BROWSER BACK / FORWARD
       ----------------------------------------------------- */

    const guideHistoryScroll = () => {

      if (
        !overviewPath(
          window.location.pathname
        )
      ) {
        return;
      }


      const id =
        decodeURIComponent(
          window.location.hash
            .replace(/^#/, "")
        )
        || "getting-started";


      afterLayout(
        () => {

          scrollToSection(
            id,
            "auto"
          );

        }
      );

    };


    window.addEventListener(
      "popstate",
      guideHistoryScroll
    );


    /* -----------------------------------------------------
       PAGE ARRIVAL
       ----------------------------------------------------- */

    const pendingRoute =
      sessionStorage.getItem(
        ROUTE_KEY
      );


    if (
      pendingRoute
      === window.location.pathname
    ) {

      sessionStorage.removeItem(
        ROUTE_KEY
      );


      afterLayout(
        () => {

          window.scrollTo({
            top: 0,
            behavior: "auto",
          });

        }
      );

    }


    /* -----------------------------------------------------
       ARRIVING AT GUIDE OVERVIEW
       FROM AN ARTICLE
       ----------------------------------------------------- */

    if (
      overviewPath(
        window.location.pathname
      )
    ) {

      const pendingTarget =
        sessionStorage.getItem(
          TARGET_KEY
        );


      if (pendingTarget) {

        sessionStorage.removeItem(
          TARGET_KEY
        );


        history.replaceState(
          null,
          "",
          `/guide#${encodeURIComponent(
            pendingTarget
          )}`
        );


        afterLayout(
          () => {

            scrollToSection(
              pendingTarget,
              "auto"
            );

          }
        );


        return;
      }


      /* -------------------------------------------------
         Direct visit:
         /guide#fullscreen

         Correct browser's initial native hash position
         after layout.
         ------------------------------------------------- */

      if (
        window.location.hash
      ) {

        const id =
          decodeURIComponent(
            window.location.hash
              .slice(1)
          );


        afterLayout(
          () => {

            scrollToSection(
              id,
              "auto"
            );

          }
        );

      }

    }

  }


  if (
    document.readyState
    === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initStableGuideNavigation,
      {
        once: true,
      }
    );

  } else {

    initStableGuideNavigation();

  }
</script>



<script>
  function initGuideRouteState() {

    const links =
      Array.from(
        document.querySelectorAll(
          "[data-guide-nav]"
        )
      );


    if (!links.length) {
      return;
    }


    function normalizePath(
      value
    ) {

      if (
        value.length > 1
        && value.endsWith("/")
      ) {
        return value.slice(
          0,
          -1
        );
      }

      return value;
    }


    function resolveActiveKey() {

      const path =
        normalizePath(
          window.location.pathname
        );


      const params =
        new URLSearchParams(
          window.location.search
        );


      const tab =
        params.get("tab");


      const hash =
        decodeURIComponent(
          window.location.hash
            .replace(/^#/, "")
        );


      if (
        path === "/guide"
      ) {

        return (
          hash === "getting-started"
            ? "getting-started"
            : hash || "getting-started"
        );

      }


      if (
        path === "/guide/installation"
      ) {
        return "installation";
      }


      if (
        path === "/guide/quick"
      ) {

        if (
          hash === "shortcuts"
        ) {
          return "shortcuts";
        }

        return "quick";

      }


      if (
        path === "/guide/manga"
      ) {
        return "manga";
      }


      if (
        path === "/guide/documents"
      ) {
        return "documents";
      }


      if (
        path === "/guide/profile"
      ) {

        if (
          tab === "glossary"
        ) {
          return "glossary";
        }


        if (
          tab === "characters"
        ) {
          return "characters";
        }


        return "profile";

      }


      if (
        path === "/guide/learning"
      ) {

        if (
          tab === "vocabulary"
        ) {
          return "vocabulary";
        }


        if (
          tab === "review"
        ) {
          return "review";
        }


        return "learning";

      }


      if (
        path === "/guide/troubleshooting"
      ) {
        return "troubleshooting";
      }


      return "";
    }


    function sync() {

      const activeKey =
        resolveActiveKey();


      links.forEach(
        link => {

          const key =
            link.getAttribute(
              "data-guide-nav"
            );


          const active =
            key === activeKey;


          link.classList.toggle(
            "is-route-active",
            active
          );


          if (active) {

            link.setAttribute(
              "aria-current",
              "page"
            );

          } else if (
            link.getAttribute(
              "aria-current"
            )
            === "page"
          ) {

            link.removeAttribute(
              "aria-current"
            );

          }

        }
      );

    }


    sync();


    window.addEventListener(
      "popstate",
      sync
    );


    window.addEventListener(
      "hashchange",
      sync
    );


    /*
      Profile and Learning change query string
      with history.replaceState(), so no popstate
      event is fired. Sync after their tabs are clicked.
    */

    document.addEventListener(
      "click",
      event => {

        const target =
          event.target;


        if (
          !(target instanceof Element)
        ) {
          return;
        }


        const tab =
          target.closest(
            [
              "[data-profile-tab]",
              "[data-learning-tab]",
              'a[href^="/guide#"]',
              'a[href^="#"]',
            ].join(",")
          );


        if (!tab) {
          return;
        }


        window.setTimeout(
          sync,
          0
        );

      }
    );

  }


  if (
    document.readyState
    === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initGuideRouteState,
      {
        once: true,
      }
    );

  } else {

    initGuideRouteState();

  }
</script>


