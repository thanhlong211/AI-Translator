---
import {
  releaseInfo,
} from "../data/release";
---

<div class="release-card">

  <div class="release-card-top">

    <div class="release-platform">

      <span class="windows-mark">
        <i></i>
        <i></i>
        <i></i>
        <i></i>
      </span>

      <div>
        <small>DESKTOP APP</small>

        <strong>
          AitraNova for Windows
        </strong>
      </div>

    </div>


    <span class="release-status">
      <i></i>
      {releaseInfo.channel}
    </span>

  </div>


  <div class="release-main">

    <div>

      <span class="release-version-label">
        CURRENT RELEASE
      </span>

      <h2>
        {releaseInfo.version}
      </h2>

      <p
        data-i18n
        data-vi="Quick Translate, Manga, Documents, Translation Profiles và Learning trong cùng ứng dụng desktop."
        data-en="Quick Translate, Manga, Documents, Translation Profiles and Learning in one desktop application."
      >
        Quick Translate, Manga, Documents,
        Translation Profiles và Learning
        trong cùng ứng dụng desktop.
      </p>

    </div>


    <div class="release-download-area">

      <a
        href={releaseInfo.downloadUrl}
        class="release-download-button"
        target={
          releaseInfo.hasDirectDownload
            ? undefined
            : "_blank"
        }
        rel={
          releaseInfo.hasDirectDownload
            ? undefined
            : "noreferrer"
        }
      >

        <span class="release-download-icon">
          ↓
        </span>

        <span>

          <strong
            data-i18n
            data-vi={
              releaseInfo.hasDirectDownload
                ? "Tải AitraNova"
                : "Xem GitHub Releases"
            }
            data-en={
              releaseInfo.hasDirectDownload
                ? "Download AitraNova"
                : "Open GitHub Releases"
            }
          >
            {
              releaseInfo.hasDirectDownload
                ? "Tải AitraNova"
                : "Xem GitHub Releases"
            }
          </strong>

          <small>
            {
              releaseInfo.hasDirectDownload
                ? "Windows"
                : "Latest available builds"
            }
          </small>

        </span>

        <i>
          →
        </i>

      </a>


      {
        !releaseInfo.hasDirectDownload
        && (
          <p class="release-fallback-note">

            <span>i</span>

            <span
              data-i18n
              data-vi="Installer trực tiếp chưa được cấu hình cho website. Bạn sẽ được chuyển tới GitHub Releases."
              data-en="A direct installer has not been configured for the website yet. You will be sent to GitHub Releases."
            >
              Installer trực tiếp chưa được cấu hình.
              Bạn sẽ được chuyển tới GitHub Releases.
            </span>

          </p>
        )
      }

    </div>

  </div>


  <div class="release-meta">

    <div>

      <small
        data-i18n
        data-vi="Nền tảng"
        data-en="Platform"
      >
        Nền tảng
      </small>

      <strong>
        {releaseInfo.platform}
      </strong>

    </div>


    <span></span>


    <div>

      <small
        data-i18n
        data-vi="Kênh phát hành"
        data-en="Release channel"
      >
        Kênh phát hành
      </small>

      <strong>
        {releaseInfo.channel}
      </strong>

    </div>


    <span></span>


    <div>

      <small>VERSION</small>

      <strong>
        {releaseInfo.version}
      </strong>

    </div>

  </div>


  <div class="release-security">

    <div>

      <span class="security-icon">
        ✓
      </span>

      <div>
        <small>SHA-256</small>

        {
          releaseInfo.hasChecksum
          ? (
            <code data-release-checksum>
              {releaseInfo.sha256}
            </code>
          )
          : (
            <strong
              data-i18n
              data-vi="Được công bố cùng release"
              data-en="Published with the release"
            >
              Được công bố cùng release
            </strong>
          )
        }
      </div>

    </div>


    {
      releaseInfo.hasChecksum
      && (
        <button
          type="button"
          data-copy-checksum
        >
          <span
            data-copy-label
            data-i18n
            data-vi="Sao chép"
            data-en="Copy"
          >
            Sao chép
          </span>
        </button>
      )
    }

  </div>

</div>


<script>
  function initReleaseCard() {

    const button =
      document.querySelector(
        "[data-copy-checksum]"
      );


    const checksum =
      document.querySelector(
        "[data-release-checksum]"
      );


    if (
      !button
      || !checksum
    ) {
      return;
    }


    button.addEventListener(
      "click",
      async () => {

        const value =
          checksum.textContent
            ?.trim();


        if (!value) {
          return;
        }


        try {

          await navigator.clipboard
            .writeText(
              value
            );


          const label =
            button.querySelector(
              "[data-copy-label]"
            );


          if (!label) {
            return;
          }


          const language =
            document.documentElement
              .dataset.language
            || "vi";


          const original =
            language === "en"
              ? "Copy"
              : "Sao chép";


          label.textContent =
            language === "en"
              ? "Copied"
              : "Đã sao chép";


          button.classList.add(
            "copied"
          );


          window.setTimeout(
            () => {

              label.textContent =
                original;

              button.classList.remove(
                "copied"
              );

            },
            1100
          );

        } catch {

          console.warn(
            "Unable to copy checksum."
          );

        }

      }
    );

  }


  if (
    document.readyState
    === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initReleaseCard,
      {
        once: true,
      }
    );

  } else {

    initReleaseCard();

  }
</script>


<style>

  .release-card {
    overflow: hidden;

    border:
      1px solid #bbb1c7;

    border-radius: 22px;

    background:
      rgba(
        240,
        235,
        246,
        0.76
      );

    box-shadow:
      0 26px 70px
      rgba(
        48,
        35,
        67,
        0.11
      );
  }


  .release-card-top {
    display: flex;

    min-height: 67px;

    align-items: center;

    justify-content:
      space-between;

    gap: 20px;

    padding:
      0 22px;

    border-bottom:
      1px solid #c7bdcf;
  }


  .release-platform {
    display: flex;

    align-items: center;

    gap: 11px;
  }


  .release-platform small {
    display: block;

    color: #948a9f;

    font-size: 5px;

    font-weight: 850;

    letter-spacing:
      0.1em;
  }


  .release-platform strong {
    display: block;

    margin-top: 3px;

    color: #282130;

    font-size: 9px;
  }


  .windows-mark {
    display: grid;

    width: 34px;
    height: 34px;

    grid-template-columns:
      1fr 1fr;

    grid-template-rows:
      1fr 1fr;

    gap: 2px;

    padding: 7px;

    border-radius: 9px;

    background: #6952ee;

    transform:
      perspective(60px)
      rotateY(-6deg);
  }


  .windows-mark i {
    background:
      rgba(
        255,
        255,
        255,
        0.94
      );
  }


  .release-status {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    min-height: 26px;

    padding:
      0 9px;

    border:
      1px solid
      rgba(
        105,
        82,
        238,
        0.25
      );

    border-radius: 999px;

    background: #e6e0fa;

    color: #6952ee;

    font-size: 6px;

    font-weight: 850;
  }


  .release-status i {
    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: #6952ee;

    box-shadow:
      0 0 0 4px
      rgba(
        105,
        82,
        238,
        0.1
      );
  }


  .release-main {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(280px, 0.55fr);

    align-items: center;

    gap: 45px;

    padding: 31px 26px;
  }


  .release-version-label {
    color: #6952ee;

    font-size: 6px;

    font-weight: 850;

    letter-spacing:
      0.12em;
  }


  .release-main h2 {
    margin:
      7px 0 9px;

    color: #201a29;

    font-size:
      clamp(
        37px,
        5vw,
        55px
      );

    line-height: 0.95;

    letter-spacing:
      -0.055em;
  }


  .release-main p {
    max-width: 560px;

    margin: 0;

    color: #71687b;

    font-size: 8px;

    line-height: 1.65;
  }


  .release-download-button {
    display: grid;

    grid-template-columns:
      auto 1fr auto;

    align-items: center;

    gap: 11px;

    min-height: 65px;

    padding:
      0 14px;

    border-radius: 13px;

    background:
      linear-gradient(
        135deg,
        #6952ee,
        #5d48dd
      );

    color: white;

    box-shadow:
      0 13px 30px
      rgba(
        105,
        82,
        238,
        0.24
      );

    transition:
      transform 160ms ease,
      box-shadow 160ms ease;
  }


  .release-download-button:hover {
    transform:
      translateY(-2px);

    box-shadow:
      0 18px 36px
      rgba(
        105,
        82,
        238,
        0.29
      );
  }


  .release-download-icon {
    display: grid;

    width: 37px;
    height: 37px;

    place-items: center;

    border-radius: 10px;

    background:
      rgba(
        255,
        255,
        255,
        0.13
      );

    font-size: 15px;
  }


  .release-download-button
  strong {
    display: block;

    color: white;

    font-size: 9px;
  }


  .release-download-button
  small {
    display: block;

    margin-top: 2px;

    color:
      rgba(
        255,
        255,
        255,
        0.66
      );

    font-size: 5px;
  }


  .release-download-button
  > i {
    font-style: normal;

    font-size: 13px;
  }


  .release-fallback-note {
    display: grid;

    grid-template-columns:
      auto 1fr;

    gap: 7px;

    margin-top:
      9px !important;

    font-size:
      6px !important;
  }


  .release-fallback-note
  > span:first-child {
    display: grid;

    width: 18px;
    height: 18px;

    place-items: center;

    border-radius: 5px;

    background: #e3dcfb;

    color: #6952ee;
  }


  .release-meta {
    display: flex;

    align-items: center;

    gap: 22px;

    padding:
      17px 25px;

    border-top:
      1px solid #c7bdcf;

    border-bottom:
      1px solid #c7bdcf;

    background:
      rgba(
        218,
        211,
        228,
        0.45
      );
  }


  .release-meta
  > span {
    width: 1px;
    height: 26px;

    background: #c3b9cb;
  }


  .release-meta small {
    display: block;

    color: #968ca0;

    font-size: 5px;
  }


  .release-meta strong {
    display: block;

    margin-top: 3px;

    color: #36303e;

    font-size: 7px;
  }


  .release-security {
    display: flex;

    min-height: 66px;

    align-items: center;

    justify-content:
      space-between;

    gap: 18px;

    padding:
      0 24px;
  }


  .release-security
  > div {
    display: grid;

    grid-template-columns:
      auto 1fr;

    align-items: center;

    gap: 10px;

    min-width: 0;
  }


  .security-icon {
    display: grid;

    width: 30px;
    height: 30px;

    place-items: center;

    border-radius: 9px;

    background: #dcece4;

    color: #3b9b72;

    font-size: 8px;

    font-weight: 850;
  }


  .release-security small {
    display: block;

    color: #978da1;

    font-size: 5px;
  }


  .release-security strong {
    display: block;

    margin-top: 3px;

    color: #46404e;

    font-size: 7px;
  }


  .release-security code {
    display: block;

    overflow: hidden;

    max-width: 520px;

    margin-top: 3px;

    color: #4a4353;

    font-size: 6px;

    text-overflow: ellipsis;

    white-space: nowrap;
  }


  .release-security button {
    min-height: 30px;

    padding:
      0 10px;

    border:
      1px solid #c5bbcf;

    border-radius: 8px;

    background: #e7e1ed;

    color: #665d71;

    cursor: pointer;

    font-size: 6px;

    font-weight: 750;
  }


  .release-security
  button.copied {
    border-color:
      rgba(
        59,
        155,
        114,
        0.3
      );

    background: #dcece4;

    color: #3b9b72;
  }


  @media (max-width: 760px) {

    .release-main {
      grid-template-columns: 1fr;
    }


    .release-meta {
      overflow-x: auto;
    }


    .release-meta > div {
      min-width: 110px;
    }

  }


  @media (max-width: 520px) {

    .release-card-top,
    .release-security {
      align-items: flex-start;

      flex-direction: column;

      padding:
        15px 18px;
    }


    .release-main {
      padding:
        25px 18px;
    }


    .release-security code {
      max-width: 250px;
    }

  }

</style>
