---
import GuideArticleLayout from "../../components/GuideArticleLayout.astro";
---

<GuideArticleLayout
  title="Quick Translate"
  section="Screen Translation"
  description="Dịch nhanh một vùng bất kỳ trên màn hình bằng OCR và AI mà không cần copy nội dung sang ứng dụng khác."
>


  <!-- 01 -->

  <section
    id="quick"
    class="article-section-block"
    data-guide-search-item="Quick Translate dịch màn hình screen translation"
  >

    <span class="section-number">
      01
    </span>

    <h2
      data-i18n
      data-vi="Quick Translate dùng để làm gì?"
      data-en="What is Quick Translate for?"
    >
      Quick Translate dùng để làm gì?
    </h2>


    <p
      data-i18n
      data-vi="Quick Translate dành cho những lúc bạn chỉ cần dịch nhanh một phần nội dung đang xuất hiện trên màn hình."
      data-en="Quick Translate is designed for moments when you only need to quickly translate part of what is currently visible on your screen."
    >
      Quick Translate dành cho những lúc
      bạn chỉ cần dịch nhanh một phần nội dung
      đang xuất hiện trên màn hình.
    </p>


    <div class="guide-checklist">

      <div>
        <span>✓</span>

        <div>
          <strong
            data-i18n
            data-vi="Menu hoặc đoạn hội thoại trong game"
            data-en="Game menus or dialogue"
          >
            Menu hoặc đoạn hội thoại trong game
          </strong>
        </div>
      </div>


      <div>
        <span>✓</span>

        <div>
          <strong
            data-i18n
            data-vi="Subtitle hoặc chữ trong video"
            data-en="Subtitles or text inside videos"
          >
            Subtitle hoặc chữ trong video
          </strong>
        </div>
      </div>


      <div>
        <span>✓</span>

        <div>
          <strong
            data-i18n
            data-vi="Website không thể copy text"
            data-en="Websites where text cannot be copied"
          >
            Website không thể copy text
          </strong>
        </div>
      </div>


      <div>
        <span>✓</span>

        <div>
          <strong
            data-i18n
            data-vi="Ảnh hoặc giao diện ứng dụng"
            data-en="Images or application interfaces"
          >
            Ảnh hoặc giao diện ứng dụng
          </strong>
        </div>
      </div>

    </div>

  </section>


  <!-- 02 -->

  <section
    id="installation"
    class="article-section-block"
    data-guide-search-item="before start app running profile language"
  >

    <span class="section-number">
      02
    </span>

    <h2
      data-i18n
      data-vi="Trước khi bắt đầu"
      data-en="Before you start"
    >
      Trước khi bắt đầu
    </h2>


    <p
      data-i18n
      data-vi="Trước khi sử dụng phím tắt, hãy đảm bảo AitraNova đang chạy và Translation Profile phù hợp đã được chọn nếu bạn muốn áp dụng quy tắc dịch riêng."
      data-en="Before using the shortcut, make sure AitraNova is running and that an appropriate Translation Profile is selected if you want custom translation rules."
    >
      Đảm bảo AitraNova đang chạy và
      Translation Profile phù hợp đã được chọn.
    </p>


    <div class="guide-checklist">

      <div>
        <span>✓</span>

        <div>
          <strong>
            AitraNova Desktop
          </strong>

          <p
            data-i18n
            data-vi="Ứng dụng phải đang chạy."
            data-en="The application must be running."
          >
            Ứng dụng phải đang chạy.
          </p>
        </div>
      </div>


      <div>
        <span>✓</span>

        <div>
          <strong>
            Source / Target Language
          </strong>

          <p>
            Japanese → Vietnamese
          </p>
        </div>
      </div>


      <div>
        <span>✓</span>

        <div>
          <strong>
            Translation Profile
          </strong>

          <p
            data-i18n
            data-vi="Ví dụ: Manga Natural hoặc profile bạn đang sử dụng."
            data-en="For example, Manga Natural or another profile you use."
          >
            Ví dụ: Manga Natural.
          </p>
        </div>
      </div>

    </div>


    <div class="guide-callout info">

      <span>
        i
      </span>

      <div>
        <strong>
          Translation Profile
        </strong>

        <p
          data-i18n
          data-vi="Nếu không cần Glossary hoặc Character Rules riêng, bạn vẫn có thể sử dụng Quick Translate với cấu hình mặc định."
          data-en="If you do not need a custom Glossary or Character Rules, you can still use Quick Translate with the default configuration."
        >
          Nếu không cần quy tắc riêng,
          bạn vẫn có thể dùng cấu hình mặc định.
        </p>
      </div>

    </div>

  </section>


  <!-- 03 -->

  <section
    id="shortcuts"
    class="article-section-block"
    data-guide-search-item="Ctrl Shift Q shortcut keyboard"
  >

    <span class="section-number">
      03
    </span>

    <h2
      data-i18n
      data-vi="Bắt đầu bằng phím tắt"
      data-en="Start with the shortcut"
    >
      Bắt đầu bằng phím tắt
    </h2>


    <p
      data-i18n
      data-vi="Mở cửa sổ có nội dung cần dịch, sau đó sử dụng phím tắt Quick Translate."
      data-en="Open the window containing the content you want to translate, then use the Quick Translate shortcut."
    >
      Mở cửa sổ có nội dung cần dịch,
      sau đó dùng:
    </p>


    <div class="shortcut-display">

      <kbd>Ctrl</kbd>

      <span>
        +
      </span>

      <kbd>Shift</kbd>

      <span>
        +
      </span>

      <kbd>Q</kbd>

    </div>


    <div class="guide-callout tip">

      <span>
        ✦
      </span>

      <div>

        <strong
          data-i18n
          data-vi="Mẹo"
          data-en="Tip"
        >
          Mẹo
        </strong>

        <p
          data-i18n
          data-vi="Không cần click vào AitraNova trước. Hãy giữ cửa sổ chứa nội dung bạn muốn dịch ở phía trước rồi nhấn phím tắt."
          data-en="You do not need to click AitraNova first. Keep the content you want to translate visible, then press the shortcut."
        >
          Không cần mở AitraNova lên trước mặt.
          Giữ nội dung cần dịch đang hiển thị
          rồi nhấn phím tắt.
        </p>

      </div>

    </div>

  </section>


  <!-- 04 -->

  <section
    id="select-area"
    class="article-section-block"
    data-guide-search-item="select region area drag mouse OCR"
  >

    <span class="section-number">
      04
    </span>

    <h2
      data-i18n
      data-vi="Chọn vùng cần dịch"
      data-en="Select the area to translate"
    >
      Chọn vùng cần dịch
    </h2>


    <p
      data-i18n
      data-vi="Sau khi nhấn phím tắt, màn hình chuyển sang chế độ chọn vùng. Giữ chuột trái và kéo quanh phần văn bản cần dịch."
      data-en="After pressing the shortcut, the screen enters area-selection mode. Hold the left mouse button and drag around the text you want to translate."
    >
      Giữ chuột trái và kéo quanh
      phần văn bản cần dịch.
    </p>


    <div class="guide-steps">

      <div class="guide-step">

        <span class="guide-step-number">
          1
        </span>

        <div>
          <strong
            data-i18n
            data-vi="Đặt chuột ở góc của vùng text"
            data-en="Place the cursor at one corner of the text"
          >
            Đặt chuột ở góc của vùng text
          </strong>
        </div>

      </div>


      <div class="guide-step">

        <span class="guide-step-number">
          2
        </span>

        <div>
          <strong
            data-i18n
            data-vi="Giữ chuột trái"
            data-en="Hold the left mouse button"
          >
            Giữ chuột trái
          </strong>
        </div>

      </div>


      <div class="guide-step">

        <span class="guide-step-number">
          3
        </span>

        <div>
          <strong
            data-i18n
            data-vi="Kéo quanh phần chữ"
            data-en="Drag around the text"
          >
            Kéo quanh phần chữ
          </strong>

          <p
            data-i18n
            data-vi="Không cần chọn cả màn hình nếu bạn chỉ dịch một câu."
            data-en="You do not need to select the entire screen when translating a single sentence."
          >
            Không cần chọn cả màn hình
            nếu chỉ dịch một câu.
          </p>
        </div>

      </div>


      <div class="guide-step">

        <span class="guide-step-number">
          4
        </span>

        <div>
          <strong
            data-i18n
            data-vi="Thả chuột"
            data-en="Release the mouse button"
          >
            Thả chuột
          </strong>

          <p
            data-i18n
            data-vi="AitraNova sẽ tiếp tục xử lý vùng vừa chọn."
            data-en="AitraNova will continue processing the selected area."
          >
            AitraNova sẽ xử lý vùng vừa chọn.
          </p>
        </div>

      </div>

    </div>


    <div class="guide-callout warning">

      <span>
        !
      </span>

      <div>

        <strong
          data-i18n
          data-vi="Đừng chọn vùng quá rộng"
          data-en="Avoid selecting an unnecessarily large area"
        >
          Đừng chọn vùng quá rộng
        </strong>

        <p
          data-i18n
          data-vi="Nếu chỉ cần một câu, hãy chọn sát quanh câu đó. Điều này thường giúp OCR dễ nhận dạng hơn."
          data-en="If you only need one sentence, select closely around it. This usually makes OCR recognition easier."
        >
          Chọn sát quanh phần chữ cần dịch.
        </p>

      </div>

    </div>

  </section>


  <!-- 05 -->

  <section
    id="ocr"
    class="article-section-block"
    data-guide-search-item="OCR optical character recognition text"
  >

    <span class="section-number">
      05
    </span>

    <h2>
      OCR
    </h2>


    <p
      data-i18n
      data-vi="AitraNova chụp vùng vừa chọn và OCR nhận dạng văn bản có trong vùng đó."
      data-en="AitraNova captures the selected region and OCR recognizes the text inside it."
    >
      AitraNova chụp vùng vừa chọn
      và OCR nhận dạng văn bản.
    </p>


    <div class="guide-example">

      <div>

        <small>
          SCREEN
        </small>

        <strong>
          また明日ここで会おう。
        </strong>

      </div>


      <span>
        →
      </span>


      <div>

        <small>
          OCR
        </small>

        <strong>
          また明日ここで会おう。
        </strong>

      </div>

    </div>


    <div class="guide-callout tip">

      <span>
        ✦
      </span>

      <div>

        <strong
          data-i18n
          data-vi="Để OCR chính xác hơn"
          data-en="For better OCR accuracy"
        >
          Để OCR chính xác hơn
        </strong>

        <p
          data-i18n
          data-vi="Ưu tiên chữ rõ, vùng chọn sát text và tránh chọn quá nhiều chi tiết hình ảnh không cần thiết."
          data-en="Prefer clear text, select closely around it, and avoid including unnecessary visual detail."
        >
          Ưu tiên chữ rõ và vùng chọn sát text.
        </p>

      </div>

    </div>

  </section>


  <!-- 06 -->

  <section
    id="profile"
    class="article-section-block"
    data-guide-search-item="translation profile glossary characters rules"
  >

    <span class="section-number">
      06
    </span>

    <h2
      data-i18n
      data-vi="Translation Profile được áp dụng"
      data-en="Translation Profile is applied"
    >
      Translation Profile được áp dụng
    </h2>


    <p
      data-i18n
      data-vi="Nếu profile hiện tại có Glossary, Character Rules hoặc các chỉ dẫn dịch khác, chúng có thể được đưa vào quá trình tạo bản dịch."
      data-en="If the active profile contains Glossary entries, Character Rules or other translation instructions, they can be used during translation."
    >
      Nếu profile hiện tại có Glossary,
      Character Rules hoặc chỉ dẫn dịch khác,
      chúng có thể hỗ trợ bản dịch.
    </p>


    <div class="guide-example">

      <div>

        <small>
          SOURCE
        </small>

        <strong>
          魔王
        </strong>

      </div>


      <span>
        →
      </span>


      <div>

        <small>
          GLOSSARY
        </small>

        <strong>
          Ma Vương
        </strong>

      </div>

    </div>


    <div class="guide-callout info">

      <span>
        i
      </span>

      <div>

        <strong>
          Character Rules
        </strong>

        <p
          data-i18n
          data-vi="Nếu tên riêng thường bị dịch sai hoặc thay đổi giữa các lần dịch, hãy thêm Character Rule thay vì sửa thủ công mỗi lần."
          data-en="If a character name is frequently translated incorrectly or inconsistently, add a Character Rule instead of correcting it manually every time."
        >
          Nếu tên riêng thường bị sai,
          hãy thêm Character Rule.
        </p>

      </div>

    </div>

  </section>


  <!-- 07 -->

  <section
    id="translation"
    class="article-section-block"
    data-guide-search-item="AI translation context result"
  >

    <span class="section-number">
      07
    </span>

    <h2
      data-i18n
      data-vi="AI tạo bản dịch"
      data-en="AI generates the translation"
    >
      AI tạo bản dịch
    </h2>


    <p
      data-i18n
      data-vi="Sau OCR, văn bản cùng các thông tin phù hợp từ profile và context được sử dụng để tạo bản dịch."
      data-en="After OCR, the text together with relevant profile and context information is used to generate the translation."
    >
      Sau OCR, văn bản cùng profile
      và context phù hợp được dùng
      để tạo bản dịch.
    </p>


    <div class="guide-example">

      <div>

        <small>
          JAPANESE
        </small>

        <strong>
          また明日ここで会おう。
        </strong>

      </div>


      <span>
        →
      </span>


      <div>

        <small>
          VIETNAMESE
        </small>

        <strong
          data-i18n
          data-vi="Ngày mai chúng ta gặp lại ở đây nhé."
          data-en="Let's meet here again tomorrow."
        >
          Ngày mai chúng ta gặp lại ở đây nhé.
        </strong>

      </div>

    </div>

  </section>


  <!-- 08 -->

  <section
    id="overlay"
    class="article-section-block"
    data-guide-search-item="overlay result translation"
  >

    <span class="section-number">
      08
    </span>

    <h2
      data-i18n
      data-vi="Đọc kết quả trên Overlay"
      data-en="Read the result in the Overlay"
    >
      Đọc kết quả trên Overlay
    </h2>


    <p
      data-i18n
      data-vi="Kết quả được hiển thị để bạn có thể tiếp tục xem game, website, video hoặc ứng dụng hiện tại mà không phải chuyển sang một trang dịch riêng."
      data-en="The result is displayed so you can continue using the current game, website, video or application without switching to a separate translator."
    >
      Kết quả được hiển thị để bạn
      không phải chuyển sang một trang dịch khác.
    </p>


    <div class="guide-checklist">

      <div>

        <span>✓</span>

        <div>

          <strong
            data-i18n
            data-vi="Xem source text"
            data-en="View source text"
          >
            Xem source text
          </strong>

        </div>

      </div>


      <div>

        <span>✓</span>

        <div>

          <strong
            data-i18n
            data-vi="Xem bản dịch"
            data-en="View translation"
          >
            Xem bản dịch
          </strong>

        </div>

      </div>


      <div>

        <span>✓</span>

        <div>

          <strong
            data-i18n
            data-vi="Tiếp tục nội dung đang xem"
            data-en="Continue what you were viewing"
          >
            Tiếp tục nội dung đang xem
          </strong>

        </div>

      </div>

    </div>

  </section>


  <!-- 09 -->

  <section
    id="example"
    class="article-section-block"
    data-guide-search-item="example practical game manga subtitle"
  >

    <span class="section-number">
      09
    </span>

    <h2
      data-i18n
      data-vi="Ví dụ thực tế"
      data-en="Practical example"
    >
      Ví dụ thực tế
    </h2>


    <p
      data-i18n
      data-vi="Bạn đang chơi game tiếng Nhật và gặp một dòng hội thoại không hiểu."
      data-en="You are playing a Japanese game and encounter a line of dialogue you do not understand."
    >
      Bạn đang chơi game tiếng Nhật
      và gặp một dòng hội thoại không hiểu.
    </p>


    <div class="guide-steps">

      <div class="guide-step">

        <span class="guide-step-number">
          1
        </span>

        <div>

          <strong>
            Ctrl + Shift + Q
          </strong>

        </div>

      </div>


      <div class="guide-step">

        <span class="guide-step-number">
          2
        </span>

        <div>

          <strong
            data-i18n
            data-vi="Kéo quanh dòng hội thoại"
            data-en="Drag around the dialogue"
          >
            Kéo quanh dòng hội thoại
          </strong>

        </div>

      </div>


      <div class="guide-step">

        <span class="guide-step-number">
          3
        </span>

        <div>

          <strong
            data-i18n
            data-vi="Chờ OCR + AI xử lý"
            data-en="Wait for OCR + AI"
          >
            Chờ OCR + AI xử lý
          </strong>

        </div>

      </div>


      <div class="guide-step">

        <span class="guide-step-number">
          4
        </span>

        <div>

          <strong
            data-i18n
            data-vi="Đọc bản dịch trên Overlay"
            data-en="Read the translation in the Overlay"
          >
            Đọc bản dịch trên Overlay
          </strong>

        </div>

      </div>

    </div>

  </section>


  <!-- 10 -->

  <section
    id="troubleshooting"
    class="article-section-block"
    data-guide-search-item="troubleshooting OCR error wrong name translation overlay"
  >

    <span class="section-number">
      10
    </span>

    <h2
      data-i18n
      data-vi="Nếu kết quả chưa đúng"
      data-en="If the result is not correct"
    >
      Nếu kết quả chưa đúng
    </h2>


    <div class="trouble-list">

      <details class="trouble-item">

        <summary>

          <span>
            !
          </span>

          <span
            data-i18n
            data-vi="OCR nhận sai chữ"
            data-en="OCR recognized the text incorrectly"
          >
            OCR nhận sai chữ
          </span>

          <span>
            +
          </span>

        </summary>

        <div class="trouble-body">

          <p
            data-i18n
            data-vi="Chọn lại vùng sát chữ hơn, tránh ảnh mờ và tăng kích thước chữ nếu ứng dụng cho phép."
            data-en="Select the area more closely around the text, avoid blurry images, and increase the text size if the application allows it."
          >
            Chọn vùng sát chữ hơn,
            tránh ảnh mờ và tăng kích thước chữ
            nếu có thể.
          </p>

        </div>

      </details>


      <details class="trouble-item">

        <summary>

          <span>
            !
          </span>

          <span
            data-i18n
            data-vi="Tên nhân vật bị dịch sai"
            data-en="A character name is translated incorrectly"
          >
            Tên nhân vật bị dịch sai
          </span>

          <span>
            +
          </span>

        </summary>

        <div class="trouble-body">

          <p
            data-i18n
            data-vi="Nếu đây là tên thường xuyên xuất hiện, hãy thêm Character Rule hoặc sửa translation để tạo mapping đáng tin cậy."
            data-en="If this name appears frequently, add a Character Rule or correct the translation to establish a trusted mapping."
          >
            Thêm Character Rule hoặc
            sử dụng correction.
          </p>

        </div>

      </details>


      <details class="trouble-item">

        <summary>

          <span>
            !
          </span>

          <span
            data-i18n
            data-vi="Thuật ngữ bị dịch không đúng"
            data-en="A term is translated incorrectly"
          >
            Thuật ngữ bị dịch không đúng
