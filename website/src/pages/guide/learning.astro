---
import GuideArticleLayout from "../../components/GuideArticleLayout.astro";
---

<GuideArticleLayout
  title="Learning"
  section="Learning System"
  description="Biến nội dung bạn đang đọc thành Vocabulary, Grammar và Review để học trực tiếp từ manga, tài liệu và bản dịch thực tế."
>

  <section
    id="learning"
    class="article-section-block learning-guide-main"
    data-guide-search-item="learning vocabulary grammar review SRS study"
  >

    <span class="section-number">01</span>

    <h2
      data-i18n
      data-vi="Đừng chỉ dịch. Học từ nội dung bạn đang đọc."
      data-en="Don't just translate. Learn from what you read."
    >
      Đừng chỉ dịch. Học từ nội dung bạn đang đọc.
    </h2>

    <p
      data-i18n
      data-vi="Learning giúp bạn biến từ vựng, cấu trúc và ví dụ gặp trong nội dung thật thành dữ liệu học thay vì phải ghi chép thủ công ở một ứng dụng khác."
      data-en="Learning turns vocabulary, grammar and examples from real content into study material without requiring manual notes in another application."
    >
      Learning biến nội dung thật thành dữ liệu học
      mà không cần ghi chú thủ công ở ứng dụng khác.
    </p>


    <!-- TABS -->

    <div
      class="learning-tabs"
      data-learning-tabs
      role="tablist"
    >

      <button
        type="button"
        class="active"
        data-learning-tab="dashboard"
        aria-selected="true"
      >
        <span>⌂</span>
        Dashboard
      </button>

      <button
        type="button"
        data-learning-tab="vocabulary"
        aria-selected="false"
      >
        <span>単</span>
        Vocabulary
      </button>

      <button
        type="button"
        data-learning-tab="grammar"
        aria-selected="false"
      >
        <span>文</span>
        Grammar
      </button>

      <button
        type="button"
        data-learning-tab="review"
        aria-selected="false"
      >
        <span>↻</span>
        Review / SRS
      </button>

    </div>


    <!-- =====================================================
         DASHBOARD
         ===================================================== -->

    <article
      class="learning-panel active"
      data-learning-panel="dashboard"
    >

      <div class="learning-panel-head">

        <span class="learning-panel-icon purple">
          学
        </span>

        <div>
          <small>LEARNING DASHBOARD</small>

          <h3
            data-i18n
            data-vi="Theo dõi những gì bạn đang học"
            data-en="Track what you're learning"
          >
            Theo dõi những gì bạn đang học
          </h3>

          <p
            data-i18n
            data-vi="Dashboard tổng hợp Vocabulary, Grammar và những mục cần Review."
            data-en="The Dashboard summarizes Vocabulary, Grammar and items due for Review."
          >
            Dashboard tổng hợp dữ liệu học của bạn.
          </p>
        </div>

      </div>


      <div class="learning-stats">

        <div>
          <span class="stat-icon purple">単</span>

          <div>
            <small>VOCABULARY</small>
            <strong>128</strong>
            <p
              data-i18n
              data-vi="từ đã lưu"
              data-en="saved words"
            >
              từ đã lưu
            </p>
          </div>
        </div>

        <div>
          <span class="stat-icon blue">文</span>

          <div>
            <small>GRAMMAR</small>
            <strong>24</strong>
            <p
              data-i18n
              data-vi="mẫu ngữ pháp"
              data-en="grammar items"
            >
              mẫu ngữ pháp
            </p>
          </div>
        </div>

        <div>
          <span class="stat-icon orange">↻</span>

          <div>
            <small>REVIEW</small>
            <strong>18</strong>
            <p
              data-i18n
              data-vi="cần ôn hôm nay"
              data-en="due today"
            >
              cần ôn hôm nay
            </p>
          </div>
        </div>

        <div>
          <span class="stat-icon green">✦</span>

          <div>
            <small>STREAK</small>
            <strong>7</strong>
            <p
              data-i18n
              data-vi="ngày"
              data-en="days"
            >
              ngày
            </p>
          </div>
        </div>

      </div>


      <h3
        data-i18n
        data-vi="Từ gần đây"
        data-en="Recent vocabulary"
      >
        Từ gần đây
      </h3>


      <div class="recent-vocabulary">

        <div>
          <span class="word-level">N4</span>

          <div>
            <strong>約束</strong>
            <small>やくそく</small>
          </div>

          <p
            data-i18n
            data-vi="lời hứa"
            data-en="promise"
          >
            lời hứa
          </p>
        </div>


        <div>
          <span class="word-level">N2</span>

          <div>
            <strong>決意</strong>
            <small>けつい</small>
          </div>

          <p
            data-i18n
            data-vi="quyết tâm"
            data-en="determination"
          >
            quyết tâm
          </p>
        </div>


        <div>
          <span class="word-level">N4</span>

          <div>
            <strong>守る</strong>
            <small>まもる</small>
          </div>

          <p
            data-i18n
            data-vi="bảo vệ / giữ"
            data-en="protect / keep"
          >
            bảo vệ / giữ
          </p>
        </div>

      </div>


      <div class="guide-callout info">
        <span>i</span>

        <div>
          <strong
            data-i18n
            data-vi="Dashboard là nơi tổng quan"
            data-en="Dashboard is the overview"
          >
            Dashboard là nơi tổng quan
          </strong>

          <p
            data-i18n
            data-vi="Việc thêm, chỉnh sửa hoặc review nội dung được thực hiện trong từng khu vực tương ứng."
            data-en="Adding, editing or reviewing content happens in the corresponding sections."
          >
            Mỗi loại dữ liệu có khu vực riêng để quản lý.
          </p>
        </div>
      </div>

    </article>


    <!-- =====================================================
         VOCABULARY
         ===================================================== -->

    <article
      id="vocabulary"
      class="learning-panel"
      data-learning-panel="vocabulary"
      hidden
    >

      <div class="learning-panel-head">

        <span class="learning-panel-icon purple">
          単
        </span>

        <div>
          <small>VOCABULARY</small>

          <h3
            data-i18n
            data-vi="Lưu từ ngay trong ngữ cảnh thật"
            data-en="Save words from real context"
          >
            Lưu từ ngay trong ngữ cảnh thật
          </h3>

          <p
            data-i18n
            data-vi="Thay vì học một danh sách từ rời rạc, Vocabulary có thể lưu từ cùng cách đọc, nghĩa và context bạn thực sự gặp."
            data-en="Instead of studying isolated word lists, Vocabulary can preserve the word, reading, meaning and the context where you encountered it."
          >
            Vocabulary lưu từ cùng thông tin
            bạn gặp trong nội dung thật.
          </p>
        </div>

      </div>


      <div class="vocabulary-card-demo">

        <div class="vocabulary-word">
          <small>VOCABULARY</small>
          <strong>約束</strong>
          <span>やくそく</span>
        </div>

        <div class="vocabulary-definition">
          <small>MEANING</small>

          <strong
            data-i18n
            data-vi="lời hứa; sự hẹn ước"
            data-en="promise; commitment"
          >
            lời hứa; sự hẹn ước
          </strong>
        </div>

        <div class="vocabulary-example">
          <small>CONTEXT</small>

          <strong>
            約束を守る。
          </strong>

          <span
            data-i18n
            data-vi="Giữ lời hứa."
            data-en="Keep a promise."
          >
            Giữ lời hứa.
          </span>
        </div>

      </div>


      <h3
        data-i18n
        data-vi="Workflow lưu từ"
        data-en="Saving workflow"
      >
        Workflow lưu từ
      </h3>


      <div class="guide-steps">

        <div class="guide-step">
          <span class="guide-step-number">1</span>

          <div>
            <strong
              data-i18n
              data-vi="Gặp một từ đáng học"
              data-en="Encounter a useful word"
            >
              Gặp một từ đáng học
            </strong>

            <p>
              Manga / Documents / Translation
            </p>
          </div>
        </div>


        <div class="guide-step">
          <span class="guide-step-number">2</span>

          <div>
            <strong
              data-i18n
              data-vi="Chọn từ"
              data-en="Select the word"
            >
              Chọn từ
            </strong>
          </div>
        </div>


        <div class="guide-step">
          <span class="guide-step-number">3</span>

          <div>
            <strong
              data-i18n
              data-vi="Lưu vào Vocabulary"
              data-en="Save to Vocabulary"
            >
              Lưu vào Vocabulary
            </strong>
          </div>
        </div>


        <div class="guide-step">
          <span class="guide-step-number">4</span>

          <div>
            <strong
              data-i18n
              data-vi="Ôn lại trong Review"
              data-en="Review it later"
            >
              Ôn lại trong Review
            </strong>
          </div>
        </div>

      </div>


      <div class="guide-callout tip">
        <span>✦</span>

        <div>
          <strong
            data-i18n
            data-vi="Context quan trọng hơn một nghĩa rời rạc"
            data-en="Context is more useful than an isolated definition"
          >
            Context quan trọng hơn một nghĩa rời rạc
          </strong>

          <p
            data-i18n
            data-vi="Giữ câu ví dụ nơi bạn gặp từ sẽ giúp việc nhớ lại cách sử dụng dễ hơn."
            data-en="Keeping the sentence where you encountered the word makes it easier to remember how it was actually used."
          >
            Nên giữ câu ví dụ thực tế khi có thể.
          </p>
        </div>
      </div>

    </article>


    <!-- =====================================================
         GRAMMAR
         ===================================================== -->

    <article
      id="grammar"
      class="learning-panel"
      data-learning-panel="grammar"
      hidden
    >

      <div class="learning-panel-head">

        <span class="learning-panel-icon blue">
          文
        </span>

        <div>
          <small>GRAMMAR</small>

          <h3
            data-i18n
            data-vi="Học cấu trúc từ câu bạn thực sự đọc"
            data-en="Learn grammar from sentences you actually read"
          >
            Học cấu trúc từ câu bạn thực sự đọc
          </h3>

          <p
            data-i18n
            data-vi="Grammar giúp lưu lại những cấu trúc xuất hiện trong manga, light novel hoặc tài liệu thay vì chỉ học ví dụ nhân tạo."
            data-en="Grammar helps preserve structures encountered in manga, light novels or documents instead of relying only on artificial examples."
          >
            Grammar tập trung vào cấu trúc
            xuất hiện trong nội dung thực tế.
          </p>
        </div>

      </div>


      <div class="grammar-demo">

        <span class="grammar-level">N4</span>

        <div>
          <small>PATTERN</small>
          <strong>〜ことになる</strong>
        </div>

        <div>
          <small>MEANING</small>

          <strong
            data-i18n
            data-vi="được quyết định là / trở thành"
            data-en="it is decided that / come to"
          >
            được quyết định là / trở thành
          </strong>
        </div>

        <div>
          <small>EXAMPLE</small>
          <strong>日本へ行くことになった。</strong>

          <span
            data-i18n
            data-vi="Tôi đã được quyết định sẽ đi Nhật."
            data-en="It was decided that I would go to Japan."
          >
            Tôi đã được quyết định sẽ đi Nhật.
          </span>
        </div>

      </div>


      <div class="guide-checklist">

        <div>
          <span>✓</span>

          <div>
            <strong
              data-i18n
              data-vi="Mẫu ngữ pháp"
              data-en="Grammar pattern"
            >
              Mẫu ngữ pháp
            </strong>
          </div>
        </div>


        <div>
          <span>✓</span>

          <div>
            <strong
              data-i18n
              data-vi="Ý nghĩa"
              data-en="Meaning"
            >
              Ý nghĩa
            </strong>
          </div>
        </div>


        <div>
          <span>✓</span>

          <div>
            <strong
              data-i18n
              data-vi="Ví dụ thực tế"
              data-en="Real example"
            >
              Ví dụ thực tế
            </strong>
          </div>
        </div>


        <div>
          <span>✓</span>

          <div>
            <strong
              data-i18n
              data-vi="Nguồn context"
              data-en="Source context"
            >
              Nguồn context
            </strong>
          </div>
        </div>

      </div>

    </article>


    <!-- =====================================================
         REVIEW
         ===================================================== -->

    <article
      id="review"
      class="learning-panel"
      data-learning-panel="review"
      hidden
    >

      <div class="learning-panel-head">

        <span class="learning-panel-icon orange">
          ↻
        </span>

        <div>
          <small>REVIEW / SRS</small>

          <h3
            data-i18n
            data-vi="Ôn lại theo lịch thay vì ngẫu nhiên"
            data-en="Review on a schedule instead of randomly"
          >
            Ôn lại theo lịch thay vì ngẫu nhiên
          </h3>

          <p
            data-i18n
            data-vi="Review giúp đưa các mục học trở lại đúng lúc thay vì yêu cầu bạn tự nhớ khi nào cần ôn."
            data-en="Review brings study items back at appropriate times instead of requiring you to remember when to study them."
          >
            Review quản lý những mục
            cần ôn lại theo thời gian.
          </p>
        </div>

      </div>


      <div class="review-card-demo">

        <div class="review-top">

          <span>
            REVIEW
          </span>

          <strong>
            12 / 18
          </strong>

        </div>


        <div class="review-word">

          <small>VOCABULARY</small>

          <strong>約束</strong>

          <span>やくそく</span>

        </div>


        <div class="review-answer">

          <small>ANSWER</small>

          <strong
            data-i18n
            data-vi="Lời hứa; sự hẹn ước"
            data-en="Promise; commitment"
          >
            Lời hứa; sự hẹn ước
          </strong>

          <p>
            約束を守る。
          </p>

        </div>


        <div class="review-actions">

          <button
            type="button"
            data-review-demo="again"
          >
            <span>Again</span>
            <small>1m</small>
          </button>

          <button
            type="button"
            data-review-demo="hard"
          >
            <span>Hard</span>
            <small>6h</small>
          </button>

          <button
            type="button"
            class="good"
            data-review-demo="good"
          >
            <span>Good</span>
            <small>1d</small>
          </button>

        </div>


        <div
          class="review-feedback"
          data-review-feedback
        >
          <span>i</span>

          <p
            data-i18n
            data-vi="Đây là mô phỏng giao diện để giải thích cách đánh giá độ nhớ."
            data-en="This is an interface mock used to explain how recall ratings work."
          >
            Đây là mô phỏng cách đánh giá độ nhớ.
          </p>
        </div>

      </div>


      <div class="review-meaning-grid">

        <div>
          <span class="rating-dot again"></span>

          <strong>Again</strong>

          <p
            data-i18n
            data-vi="Bạn chưa nhớ được mục này."
            data-en="You could not recall this item."
          >
            Chưa nhớ.
          </p>
        </div>


        <div>
          <span class="rating-dot hard"></span>

          <strong>Hard</strong>

          <p
            data-i18n
            data-vi="Nhớ được nhưng khá khó."
            data-en="You remembered it, but with difficulty."
          >
            Nhớ nhưng còn khó.
          </p>
        </div>


        <div>
          <span class="rating-dot good"></span>

          <strong>Good</strong>

          <p
            data-i18n
            data-vi="Bạn nhớ được bình thường."
            data-en="You recalled it normally."
          >
            Nhớ tốt.
          </p>
        </div>

      </div>


      <div class="guide-callout info">
        <span>i</span>

        <div>
          <strong
            data-i18n
            data-vi="Không cần cố đoán lịch ôn"
            data-en="You do not need to manually guess the review schedule"
          >
            Không cần cố đoán lịch ôn
          </strong>

          <p
            data-i18n
            data-vi="Hãy đánh giá mức độ nhớ của bạn một cách thực tế. Hệ thống Review sử dụng kết quả đó để hỗ trợ lịch ôn."
            data-en="Rate your recall realistically. Review uses that feedback to help determine when an item should return."
          >
            Hãy đánh giá đúng mức độ bạn thực sự nhớ.
          </p>
        </div>
      </div>

    </article>

  </section>


  <!-- =======================================================
       LEARNING WORKFLOW
       ======================================================= -->

  <section
    id="learning-workflow"
    class="article-section-block"
    data-guide-search-item="learning workflow manga document vocabulary review"
  >

    <span class="section-number">02</span>

    <h2
      data-i18n
      data-vi="Từ bản dịch đến Review"
      data-en="From translation to Review"
    >
      Từ bản dịch đến Review
    </h2>


    <div class="learning-flow">

      <div>
        <span>01</span>
        <small>SOURCE</small>

        <strong
          data-i18n
          data-vi="Manga / Tài liệu"
          data-en="Manga / Document"
        >
          Manga / Tài liệu
        </strong>
      </div>

      <i>→</i>

      <div>
        <span>02</span>
        <small>TRANSLATION</small>
        <strong>約束</strong>
      </div>

      <i>→</i>

      <div>
        <span>03</span>
        <small>LEARNING</small>
        <strong>Vocabulary</strong>
      </div>

      <i>→</i>

      <div>
        <span>04</span>
        <small>SRS</small>
        <strong>Review</strong>
      </div>

    </div>


    <div class="guide-callout tip">

      <span>✦</span>

      <div>
        <strong
          data-i18n
          data-vi="Học từ nội dung bạn quan tâm"
          data-en="Learn from content you care about"
        >
          Học từ nội dung bạn quan tâm
        </strong>

        <p
          data-i18n
          data-vi="Những từ xuất hiện trong manga hoặc tài liệu bạn thực sự đang đọc thường có context dễ nhớ hơn một danh sách từ ngẫu nhiên."
          data-en="Words encountered in manga or documents you are actually reading often provide more memorable context than a random word list."
        >
          Context thật giúp bạn nhớ vì sao
          từ đó xuất hiện và được sử dụng thế nào.
        </p>
      </div>

    </div>

  </section>


  <!-- =======================================================
       TROUBLESHOOTING
       ======================================================= -->

  <section
    id="learning-troubleshooting"
    class="article-section-block"
    data-guide-search-item="learning vocabulary review troubleshooting duplicate wrong meaning"
  >

    <span class="section-number">03</span>

    <h2
      data-i18n
      data-vi="Lỗi và tình huống thường gặp"
      data-en="Common issues"
    >
      Lỗi và tình huống thường gặp
    </h2>


    <div class="trouble-list">

      <details class="trouble-item">
        <summary>

          <span>!</span>

          <span
            data-i18n
            data-vi="Từ đã lưu nhưng nghĩa chưa phù hợp context"
            data-en="The saved meaning does not match the context"
          >
            Từ đã lưu nhưng nghĩa chưa phù hợp context
          </span>

          <span>+</span>

        </summary>

        <div class="trouble-body">

          <p
            data-i18n
            data-vi="Một từ có thể có nhiều nghĩa. Hãy ưu tiên nghĩa phù hợp với câu nơi bạn gặp từ đó."
            data-en="A word may have several meanings. Prefer the meaning that matches the sentence where you encountered it."
          >
            Ưu tiên nghĩa phù hợp với context gốc.
          </p>

        </div>

      </details>


      <details class="trouble-item">
        <summary>

          <span>!</span>

          <span
            data-i18n
            data-vi="Đã có quá nhiều từ cần Review"
            data-en="Too many items are due for Review"
          >
            Đã có quá nhiều từ cần Review
          </span>

          <span>+</span>

        </summary>

        <div class="trouble-body">

          <p
            data-i18n
