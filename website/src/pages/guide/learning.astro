<script>
  function initLearningGuide() {

    const root =
      document.querySelector(
        "[data-learning-tabs]"
      );

    if (!root) {
      return;
    }


    const buttons =
      Array.from(
        root.querySelectorAll(
          "[data-learning-tab]"
        )
      );


    const panels =
      Array.from(
        document.querySelectorAll(
          "[data-learning-panel]"
        )
      );


    const valid =
      buttons
        .map(
          button =>
            button.dataset.learningTab
        )
        .filter(Boolean);


    const storageKey =
      "aitranova-learning-guide-tab";


    function showTab(
      tab,
      updateUrl = true
    ) {

      if (!valid.includes(tab)) {
        tab = "dashboard";
      }


      buttons.forEach(
        button => {

          const active =
            button.dataset.learningTab
            === tab;

          button.classList.toggle(
            "active",
            active
          );

          button.setAttribute(
            "aria-selected",
            String(active)
          );

        }
      );


      panels.forEach(
        panel => {

          const active =
            panel.dataset.learningPanel
            === tab;

          panel.hidden =
            !active;

          panel.classList.toggle(
            "active",
            active
          );


          if (
            active
            && typeof panel.animate
            === "function"
          ) {

            panel.animate(
              [
                {
                  opacity: 0,
                  transform:
                    "translateY(8px)",
                },
                {
                  opacity: 1,
                  transform:
                    "translateY(0)",
                },
              ],
              {
                duration: 190,
                easing: "ease-out",
              }
            );

          }

        }
      );


      try {
        localStorage.setItem(
          storageKey,
          tab
        );
      } catch {}


      if (updateUrl) {

        const url =
          new URL(
            window.location.href
          );

        url.searchParams.set(
          "tab",
          tab
        );

        url.hash = "";

        history.replaceState(
          null,
          "",
          url
        );

      }

    }


    buttons.forEach(
      button => {

        button.addEventListener(
          "click",
          () => {

            const tab =
              button.dataset.learningTab;

            if (tab) {
              showTab(tab);
            }

          }
        );


        button.addEventListener(
          "keydown",
          event => {

            if (
              event.key !== "ArrowLeft"
              && event.key !== "ArrowRight"
            ) {
              return;
            }


            event.preventDefault();


            const index =
              buttons.indexOf(button);


            const delta =
              event.key === "ArrowRight"
                ? 1
                : -1;


            const next =
              buttons[
                (
                  index
                  + delta
                  + buttons.length
                )
                % buttons.length
              ];


            next.focus();


            const tab =
              next.dataset.learningTab;

            if (tab) {
              showTab(tab);
            }

          }
        );

      }
    );


    /*
      Allow sidebar / overview links to change
      tabs without reloading when already here.
    */

    document.addEventListener(
      "click",
      event => {

        const target =
          event.target;

        if (
          !(target instanceof Element)
        ) {
          return;
        }


        const link =
          target.closest(
            'a[href*="/guide/learning?tab="]'
          );

        if (!link) {
          return;
        }


        const url =
          new URL(
            link.href,
            window.location.href
          );


        if (
          url.pathname
          !== window.location.pathname
        ) {
          return;
        }


        const tab =
          url.searchParams.get(
            "tab"
          );


        if (
          !tab
          || !valid.includes(tab)
        ) {
          return;
        }


        event.preventDefault();

        showTab(tab);

      }
    );


    const params =
      new URLSearchParams(
        window.location.search
      );


    const requested =
      params.get("tab");


    let stored = null;

    try {
      stored =
        localStorage.getItem(
          storageKey
        );
    } catch {}


    showTab(
      requested
      || stored
      || "dashboard",
      Boolean(requested)
    );


    /* -----------------------------------------
       REVIEW DEMO
       ----------------------------------------- */

    const feedback =
      document.querySelector(
        "[data-review-feedback] p"
      );


    document.querySelectorAll(
      "[data-review-demo]"
    )
    .forEach(
      button => {

        button.addEventListener(
          "click",
          () => {

            if (!feedback) {
              return;
            }


            const language =
              document.documentElement
                .dataset.language
              || "vi";


            const value =
              button.dataset.reviewDemo;


            const messages = {

              again: {
                vi:
                  "Again: mục này sẽ cần được ôn lại sớm hơn.",
                en:
                  "Again: this item should return sooner.",
              },

              hard: {
                vi:
                  "Hard: bạn nhớ được nhưng vẫn còn khó.",
                en:
                  "Hard: you recalled it, but with difficulty.",
              },

              good: {
                vi:
                  "Good: bạn nhớ được mục này khá ổn.",
                en:
                  "Good: you recalled this item successfully.",
              },

            };


            const message =
              messages[value];


            if (!message) {
              return;
            }


            feedback.textContent =
              language === "en"
                ? message.en
                : message.vi;

          }
        );

      }
    );

  }


  if (
    document.readyState
    === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initLearningGuide,
      {
        once: true,
      }
    );

  } else {

    initLearningGuide();

  }
</script>


