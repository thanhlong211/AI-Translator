---
import GuideArticleLayout from "../../components/GuideArticleLayout.astro";

const issues = [
  {
    id: "shortcut-not-working",
    category: "app",
    keywords: "shortcut hotkey ctrl shift q quick translate phím tắt không hoạt động",
    icon: "⌨",
    titleVi: "Ctrl + Shift + Q không phản hồi",
    titleEn: "Ctrl + Shift + Q does not respond",
    descVi: "Quick Translate không chuyển sang chế độ chọn vùng.",
    descEn: "Quick Translate does not enter area-selection mode.",
    stepsVi: [
      "Kiểm tra AitraNova có đang chạy hay không.",
      "Thử đưa cửa sổ cần dịch ra phía trước rồi dùng lại phím tắt.",
      "Đóng và mở lại AitraNova nếu phím tắt vẫn không phản hồi.",
      "Nếu lỗi tiếp tục xảy ra, kiểm tra xem phím tắt có đang bị ứng dụng khác chiếm dụng hay không.",
    ],
    stepsEn: [
      "Check that AitraNova is running.",
      "Bring the content window to the foreground and try the shortcut again.",
      "Restart AitraNova if the shortcut still does not respond.",
      "If the issue continues, check whether another application is using the same shortcut.",
    ],
  },

  {
    id: "ocr-wrong",
    category: "ocr",
    keywords: "ocr sai chữ nhận dạng text image blurry mờ japanese",
    icon: "眼",
    titleVi: "OCR nhận sai nhiều ký tự",
    titleEn: "OCR recognizes many characters incorrectly",
    descVi: "Source text được nhận dạng khác đáng kể so với nội dung trên màn hình.",
    descEn: "The recognized source differs significantly from the visible text.",
    stepsVi: [
      "Chọn vùng sát quanh phần chữ cần nhận dạng hơn.",
      "Thử với hình ảnh hoặc trang có độ phân giải cao hơn.",
      "Tránh đưa quá nhiều nền, hiệu ứng hoặc chi tiết không liên quan vào vùng chọn.",
      "Nếu ứng dụng cho phép, tăng kích thước chữ trước khi OCR.",
    ],
    stepsEn: [
      "Select more closely around the text.",
      "Try a higher-resolution image or page.",
      "Avoid including unnecessary backgrounds, effects or visual details.",
      "Increase text size before OCR when possible.",
    ],
  },

  {
    id: "ocr-empty",
    category: "ocr",
    keywords: "ocr empty no text không có chữ blank source",
    icon: "□",
    titleVi: "OCR không nhận được text",
    titleEn: "OCR returns no text",
    descVi: "Vùng đã chọn nhưng không có source text hữu ích.",
    descEn: "The selected region produces no usable source text.",
    stepsVi: [
      "Kiểm tra vùng chọn có thực sự chứa chữ hay không.",
      "Thử chọn một vùng nhỏ hơn và tập trung vào một dòng rõ ràng.",
      "Kiểm tra Source Language đang sử dụng.",
      "Thử một hình ảnh rõ khác để xác định lỗi có phụ thuộc nội dung hiện tại hay không.",
    ],
    stepsEn: [
      "Check that the selected region actually contains text.",
      "Try a smaller region focused on one clear line.",
      "Verify the selected Source Language.",
      "Try another clear image to determine whether the problem is content-specific.",
    ],
  },

  {
    id: "translation-style",
    category: "translation",
    keywords: "translation style wrong phong cách dịch profile natural technical",
    icon: "文",
    titleVi: "Bản dịch đúng nghĩa nhưng sai phong cách",
    titleEn: "The translation is accurate but the style is wrong",
    descVi: "Nội dung hiểu được nhưng cách diễn đạt không phù hợp với mục đích của bạn.",
    descEn: "The meaning is understandable but the wording does not match your intended style.",
    stepsVi: [
      "Kiểm tra Translation Profile đang được sử dụng.",
      "Đảm bảo profile phù hợp với loại nội dung như Manga, Novel hoặc Technical.",
      "Kiểm tra các instruction liên quan tới style trong profile.",
      "Thử lại bản dịch sau khi chuyển đúng profile.",
    ],
    stepsEn: [
      "Check the active Translation Profile.",
      "Make sure the profile matches the content type such as Manga, Novel or Technical.",
      "Review style-related instructions in the profile.",
      "Translate again after selecting the appropriate profile.",
    ],
  },

  {
    id: "term-inconsistent",
    category: "profile",
    keywords: "glossary terminology inconsistent thuật ngữ không nhất quán profile",
    icon: "語",
    titleVi: "Thuật ngữ bị dịch không nhất quán",
    titleEn: "Terminology is translated inconsistently",
    descVi: "Cùng một thuật ngữ xuất hiện nhiều lần nhưng bản dịch thay đổi.",
    descEn: "The same term appears multiple times but its translation changes.",
    stepsVi: [
      "Xác định cách dịch bạn muốn giữ cố định.",
      "Thêm thuật ngữ vào Glossary của Translation Profile phù hợp.",
      "Kiểm tra đang sử dụng đúng profile khi dịch.",
      "Dịch lại đoạn liên quan để kiểm tra.",
    ],
    stepsEn: [
      "Decide which translation should remain consistent.",
      "Add the term to the appropriate Translation Profile Glossary.",
      "Verify that the correct profile is active.",
      "Translate the relevant content again to verify the result.",
    ],
  },

  {
    id: "character-name",
    category: "profile",
    keywords: "character name wrong inconsistent tên nhân vật sai character rule continuity",
    icon: "名",
    titleVi: "Tên nhân vật thay đổi giữa các lần dịch",
    titleEn: "A character name changes between translations",
    descVi: "Một nhân vật bị romanize hoặc dịch bằng nhiều tên khác nhau.",
    descEn: "The same character is romanized or translated using different names.",
    stepsVi: [
      "Nếu bạn biết mapping chính xác, thêm Character Rule.",
      "Nếu bản dịch hiện tại sai, sử dụng correction cho block tương ứng.",
      "Kiểm tra Translation Profile hiện tại có đúng Character Rules hay không.",
      "Với Manga Session, tiếp tục theo dõi continuity ở các trang sau.",
    ],
    stepsEn: [
      "If you know the correct mapping, add a Character Rule.",
      "If the current translation is wrong, correct the corresponding block.",
      "Verify that the active Translation Profile contains the expected Character Rules.",
      "For Manga Session, monitor continuity on subsequent pages.",
    ],
  },

  {
    id: "manga-context",
    category: "manga",
    keywords: "manga context previous page wrong new chapter continuity trang trước chương mới",
    icon: "漫",
    titleVi: "Context manga không còn phù hợp",
    titleEn: "Manga context is no longer relevant",
    descVi: "Bản dịch mới có vẻ bị ảnh hưởng bởi tình huống ở những trang trước.",
    descEn: "A new translation appears influenced by events from earlier pages.",
    stepsVi: [
      "Kiểm tra bạn có vừa chuyển sang chapter hoặc cảnh hoàn toàn mới hay không.",
      "Nếu đã sang chapter mới, sử dụng workflow New Chapter.",
      "Kiểm tra source hiện tại trước khi quy lỗi cho context.",
      "Nếu tên riêng sai, xử lý bằng Character Rule hoặc correction thay vì chỉ reset context.",
    ],
    stepsEn: [
      "Check whether you moved to a new chapter or an entirely new scene.",
      "Use the New Chapter workflow when appropriate.",
      "Verify the current source before attributing the problem to context.",
      "For incorrect names, use Character Rules or corrections instead of only resetting context.",
    ],
  },

  {
    id: "manga-one-bubble",
    category: "manga",
    keywords: "manga bubble one wrong block correction OCR",
    icon: "●",
    titleVi: "Chỉ một bubble manga bị sai",
    titleEn: "Only one manga bubble is incorrect",
    descVi: "Các bubble khác ổn nhưng một block có OCR hoặc translation không đúng.",
    descEn: "Other bubbles are correct, but one block has incorrect OCR or translation.",
    stepsVi: [
      "Kiểm tra source OCR của chính bubble đó.",
      "Nếu OCR sai, xử lý chất lượng nhận dạng trước.",
      "Nếu OCR đúng nhưng translation sai, correction đúng block đó.",
      "Không cần sửa toàn bộ page nếu chỉ một bubble gặp vấn đề.",
    ],
    stepsEn: [
      "Check the OCR source for that specific bubble.",
      "If OCR is wrong, address recognition quality first.",
      "If OCR is correct but translation is wrong, correct that specific block.",
      "There is no need to redo the entire page for a single problematic bubble.",
    ],
  },

  {
    id: "pdf-no-text",
    category: "documents",
    keywords: "pdf text scan cannot select OCR document không chọn được chữ",
    icon: "PDF",
    titleVi: "PDF mở được nhưng không đọc được text",
    titleEn: "The PDF opens but text cannot be read",
    descVi: "Tài liệu có thể là PDF scan thay vì PDF chứa text thật.",
    descEn: "The document may be a scanned PDF rather than a PDF containing real text.",
    stepsVi: [
      "Thử chọn hoặc copy một đoạn chữ trong PDF.",
      "Nếu không thể chọn chữ, tài liệu có thể là dạng scan.",
      "Chuyển sang PDF OCR.",
      "Nếu OCR kém, kiểm tra chất lượng bản scan.",
    ],
    stepsEn: [
      "Try selecting or copying text inside the PDF.",
      "If text cannot be selected, the document may be scanned.",
      "Switch to PDF OCR.",
      "If OCR quality is poor, check the scan quality.",
    ],
  },

  {
    id: "pdf-ocr-bad",
    category: "documents",
    keywords: "pdf ocr scan blurry rotation contrast sai chữ",
    icon: "OCR",
    titleVi: "PDF OCR cho kết quả kém",
    titleEn: "PDF OCR produces poor results",
    descVi: "Nhiều ký tự bị sai sau khi nhận dạng PDF scan.",
    descEn: "Many characters are incorrect after recognizing a scanned PDF.",
    stepsVi: [
      "Kiểm tra độ phân giải của bản scan.",
      "Kiểm tra trang có bị nghiêng hoặc xoay sai không.",
      "Ưu tiên tài liệu có độ tương phản chữ và nền tốt.",
      "Nếu PDF có text thật, sử dụng PDF Text thay vì OCR.",
    ],
    stepsEn: [
      "Check the scan resolution.",
      "Check whether the page is tilted or rotated incorrectly.",
      "Prefer documents with good text/background contrast.",
      "If the PDF contains real text, use PDF Text instead of OCR.",
    ],
  },

  {
    id: "profile-wrong",
    category: "profile",
    keywords: "profile wrong active glossary character incorrect không đúng profile",
    icon: "P",
    titleVi: "Profile không tạo ra kết quả mong muốn",
    titleEn: "The Profile does not produce the expected result",
    descVi: "Glossary hoặc Character Rules dường như không ảnh hưởng bản dịch.",
    descEn: "Glossary entries or Character Rules do not appear to affect the translation.",
    stepsVi: [
      "Kiểm tra profile đang thực sự được sử dụng.",
      "Kiểm tra Glossary hoặc Character Rule có nằm trong đúng profile.",
      "Đảm bảo source của rule khớp với nội dung được nhận dạng.",
      "Kiểm tra OCR nếu rule đúng nhưng source text đã bị nhận sai.",
    ],
    stepsEn: [
      "Verify which profile is actually active.",
      "Check that the Glossary entry or Character Rule belongs to that profile.",
      "Ensure the rule source matches the recognized content.",
      "Check OCR if the rule is correct but the source text was recognized incorrectly.",
    ],
  },

  {
    id: "network-error",
    category: "app",
    keywords: "network internet connection ai service error timeout mạng kết nối",
    icon: "↯",
    titleVi: "Translation không hoàn tất do kết nối",
    titleEn: "Translation does not complete because of connectivity",
    descVi: "OCR có thể hoạt động nhưng bước dịch không hoàn tất.",
    descEn: "OCR may work while translation does not complete.",
    stepsVi: [
      "Kiểm tra kết nối Internet.",
      "Thử lại sau khi kết nối ổn định.",
      "Khởi động lại AitraNova nếu trạng thái xử lý không trở lại bình thường.",
      "Nếu nhiều chức năng online cùng lỗi, có thể cần kiểm tra trạng thái dịch vụ.",
    ],
    stepsEn: [
      "Check your Internet connection.",
      "Try again after the connection becomes stable.",
      "Restart AitraNova if processing does not return to normal.",
      "If multiple online features fail together, service status may need to be checked.",
    ],
  },
];

const categories = [
  { id: "all", vi: "Tất cả", en: "All" },
  { id: "app", vi: "Ứng dụng", en: "App" },
  { id: "ocr", vi: "OCR", en: "OCR" },
  { id: "translation", vi: "Bản dịch", en: "Translation" },
  { id: "manga", vi: "Manga", en: "Manga" },
  { id: "documents", vi: "Tài liệu", en: "Documents" },
  { id: "profile", vi: "Profile", en: "Profile" },
];
---

<GuideArticleLayout
  title="Troubleshooting"
  section="Help Center"
  description="Tìm nhanh nguyên nhân và cách xử lý các vấn đề thường gặp với AitraNova, OCR, Translation, Manga, Documents và Translation Profile."
>

  <section
    id="troubleshooting"
    class="article-section-block troubleshooting-center"
  >

    <span class="section-number">01</span>

    <h2
      data-i18n
      data-vi="Bạn đang gặp vấn đề gì?"
      data-en="What problem are you having?"
    >
      Bạn đang gặp vấn đề gì?
    </h2>

    <p
      data-i18n
      data-vi="Tìm bằng từ khóa hoặc chọn một nhóm bên dưới. Ví dụ: OCR sai, phím tắt, manga, PDF hoặc tên nhân vật."
      data-en="Search by keyword or choose a category below. For example: OCR, shortcut, manga, PDF or character name."
    >
      Tìm bằng từ khóa hoặc chọn một nhóm bên dưới.
    </p>


    <!-- SEARCH -->

    <div class="troubleshooting-search">

      <span>⌕</span>

      <input
        type="search"
        data-trouble-search
        placeholder="Tìm lỗi: OCR, phím tắt, Manga..."
        autocomplete="off"
        spellcheck="false"
        aria-label="Search troubleshooting"
      />

      <kbd>/</kbd>

      <button
        type="button"
        data-trouble-clear
        aria-label="Clear search"
        hidden
      >
        ×
      </button>

    </div>


    <!-- CATEGORY FILTER -->

    <div
      class="trouble-filters"
      data-trouble-filters
    >

      {
        categories.map((category) => (

          <button
            type="button"
            class={category.id === "all" ? "active" : ""}
            data-trouble-filter={category.id}
            aria-pressed={category.id === "all" ? "true" : "false"}
          >

            <span
              data-i18n
              data-vi={category.vi}
              data-en={category.en}
            >
              {category.vi}
            </span>

          </button>

        ))
      }

    </div>


    <!-- RESULT META -->

    <div class="trouble-result-meta">

      <span>
        <strong data-trouble-count>
          {issues.length}
        </strong>

        <span
          data-i18n
          data-vi=" hướng xử lý"
          data-en=" solutions"
        >
          {" "}hướng xử lý
        </span>
      </span>

      <button
        type="button"
        data-trouble-reset
      >
        <span
          data-i18n
          data-vi="Đặt lại"
          data-en="Reset"
        >
          Đặt lại
        </span>
      </button>

    </div>


    <!-- ISSUES -->

    <div
      class="troubleshooting-list"
      data-trouble-list
    >

      {
        issues.map((issue) => (

          <details
            class="troubleshooting-item"
            id={issue.id}
            data-trouble-item
            data-category={issue.category}
            data-search={`${issue.keywords} ${issue.titleVi} ${issue.titleEn} ${issue.descVi} ${issue.descEn}`}
          >

            <summary>

              <span class="trouble-icon">
                {issue.icon}
              </span>

              <div>
                <strong
                  data-i18n
                  data-vi={issue.titleVi}
                  data-en={issue.titleEn}
                >
                  {issue.titleVi}
                </strong>

                <p
                  data-i18n
                  data-vi={issue.descVi}
                  data-en={issue.descEn}
                >
                  {issue.descVi}
                </p>
              </div>

              <span class="trouble-toggle">
                +
              </span>

            </summary>


            <div class="troubleshooting-solution">

              <small
                data-i18n
                data-vi="THỬ THEO THỨ TỰ"
                data-en="TRY IN THIS ORDER"
              >
                THỬ THEO THỨ TỰ
              </small>


              <div class="trouble-solution-steps">

                {
                  issue.stepsVi.map((stepVi, index) => (

                    <div>

                      <span>
                        {String(index + 1).padStart(2, "0")}
                      </span>

                      <p
                        data-i18n
                        data-vi={stepVi}
                        data-en={issue.stepsEn[index]}
                      >
                        {stepVi}
                      </p>

                    </div>

                  ))
                }

              </div>


              <a
                href={`#${issue.id}`}
                class="trouble-copy-link"
                data-copy-issue-link={issue.id}
              >
                <span>⌁</span>

                <span
                  data-i18n
                  data-vi="Sao chép link lỗi này"
                  data-en="Copy link to this issue"
                >
                  Sao chép link lỗi này
                </span>
              </a>

            </div>

          </details>

        ))
      }

    </div>


    <!-- EMPTY -->

    <div
      class="trouble-empty"
      data-trouble-empty
      hidden
    >

      <span>?</span>

      <strong
        data-i18n
        data-vi="Chưa tìm thấy hướng xử lý phù hợp"
        data-en="No matching solution found"
      >
        Chưa tìm thấy hướng xử lý phù hợp
      </strong>

      <p
        data-i18n
        data-vi="Thử từ khóa ngắn hơn như OCR, Manga, PDF, Profile hoặc phím tắt."
        data-en="Try a shorter keyword such as OCR, Manga, PDF, Profile or shortcut."
      >
        Thử từ khóa ngắn hơn.
      </p>

      <button
        type="button"
        data-trouble-empty-reset
      >
        <span
          data-i18n
          data-vi="Xóa bộ lọc"
          data-en="Clear filters"
        >
          Xóa bộ lọc
        </span>
      </button>

    </div>

  </section>


  <!-- DIAGNOSTIC FLOW -->

  <section
    id="diagnostic-flow"
    class="article-section-block"
    data-guide-search-item="diagnostic source OCR translation profile workflow"
  >

    <span class="section-number">02</span>

    <h2
      data-i18n
      data-vi="Xác định lỗi nằm ở đâu"
      data-en="Identify where the problem occurs"
    >
      Xác định lỗi nằm ở đâu
    </h2>

    <p
      data-i18n
      data-vi="Khi bản dịch có vấn đề, đừng sửa mọi thứ cùng lúc. Hãy kiểm tra workflow từ trái sang phải."
      data-en="When a translation has a problem, do not change everything at once. Check the workflow from left to right."
    >
      Kiểm tra workflow từ trái sang phải.
    </p>


    <div class="diagnostic-flow">

      <div>
        <span>01</span>
        <small>INPUT</small>

        <strong
          data-i18n
          data-vi="Ảnh / tài liệu"
          data-en="Image / document"
        >
          Ảnh / tài liệu
        </strong>

        <p
          data-i18n
          data-vi="Source có rõ không?"
          data-en="Is the source clear?"
        >
          Source có rõ không?
        </p>
      </div>

      <i>→</i>

      <div>
        <span>02</span>
        <small>OCR</small>

        <strong>Source Text</strong>

        <p
          data-i18n
          data-vi="OCR có đúng không?"
          data-en="Is OCR correct?"
        >
          OCR có đúng không?
        </p>
      </div>

      <i>→</i>

      <div>
        <span>03</span>
        <small>RULES</small>

        <strong>Profile</strong>

        <p>
          Glossary / Characters
        </p>
      </div>

      <i>→</i>

      <div>
        <span>04</span>
        <small>CONTEXT</small>

        <strong>Memory</strong>

        <p
          data-i18n
          data-vi="Context có phù hợp?"
          data-en="Is the context relevant?"
        >
          Context có phù hợp?
        </p>
      </div>

      <i>→</i>

      <div>
        <span>05</span>
        <small>OUTPUT</small>

        <strong>Translation</strong>

        <p
          data-i18n
          data-vi="Kiểm tra kết quả"
          data-en="Review the result"
        >
          Kiểm tra kết quả
        </p>
      </div>

    </div>


    <div class="guide-callout tip">

      <span>✦</span>

      <div>

        <strong
          data-i18n
          data-vi="Nếu OCR đã sai"
          data-en="If OCR is already wrong"
        >
          Nếu OCR đã sai
        </strong>

        <p
          data-i18n
          data-vi="Hãy xử lý OCR trước. Thay đổi Glossary hoặc Prompt thường không giải quyết được source text bị nhận dạng sai."
          data-en="Fix OCR first. Changing the Glossary or prompt usually cannot solve incorrectly recognized source text."
        >
          Hãy sửa nguồn lỗi sớm nhất trong workflow trước.
        </p>

      </div>

    </div>

  </section>


  <!-- STILL NEED HELP -->

  <section
    id="still-need-help"
    class="article-section-block"
  >

    <span class="section-number">03</span>

    <h2
      data-i18n
      data-vi="Vẫn chưa xác định được lỗi?"
      data-en="Still unable to identify the issue?"
    >
      Vẫn chưa xác định được lỗi?
    </h2>

    <p
      data-i18n
