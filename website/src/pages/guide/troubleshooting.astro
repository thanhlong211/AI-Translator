<script>
  function initTroubleshootingCenter() {

    const search =
      document.querySelector(
        "[data-trouble-search]"
      );

    if (
      !(search instanceof HTMLInputElement)
    ) {
      return;
    }


    const items =
      Array.from(
        document.querySelectorAll(
          "[data-trouble-item]"
        )
      );


    const filterButtons =
      Array.from(
        document.querySelectorAll(
          "[data-trouble-filter]"
        )
      );


    const count =
      document.querySelector(
        "[data-trouble-count]"
      );


    const empty =
      document.querySelector(
        "[data-trouble-empty]"
      );


    const clearButton =
      document.querySelector(
        "[data-trouble-clear]"
      );


    let activeCategory =
      "all";


    function normalize(
      value
    ) {

      return String(value || "")
        .normalize("NFD")
        .replace(
          /[\u0300-\u036f]/g,
          ""
        )
        .toLowerCase()
        .trim();

    }


    function applyFilters() {

      const query =
        normalize(
          search.value
        );


      let visible =
        0;


      items.forEach(
        item => {

          const category =
            item.getAttribute(
              "data-category"
            )
            || "";


          const searchable =
            normalize(
              item.getAttribute(
                "data-search"
              )
            );


          const categoryMatch =
            activeCategory === "all"
            || category === activeCategory;


          const queryMatch =
            !query
            || searchable.includes(
              query
            );


          const show =
            categoryMatch
            && queryMatch;


          item.hidden =
            !show;


          if (show) {
            visible++;
          } else if (
            item instanceof HTMLDetailsElement
          ) {
            item.open =
              false;
          }

        }
      );


      if (count) {
        count.textContent =
          String(visible);
      }


      if (empty) {
        empty.hidden =
          visible !== 0;
      }


      if (clearButton) {
        clearButton.hidden =
          !search.value;
      }


      const url =
        new URL(
          window.location.href
        );


      if (search.value.trim()) {
        url.searchParams.set(
          "q",
          search.value.trim()
        );
      } else {
        url.searchParams.delete(
          "q"
        );
      }


      if (
        activeCategory !== "all"
      ) {
        url.searchParams.set(
          "category",
          activeCategory
        );
      } else {
        url.searchParams.delete(
          "category"
        );
      }


      history.replaceState(
        null,
        "",
        url
      );

    }


    function setCategory(
      category
    ) {

      activeCategory =
        category;


      filterButtons.forEach(
        button => {

          const active =
            button.getAttribute(
              "data-trouble-filter"
            )
            === category;


          button.classList.toggle(
            "active",
            active
          );


          button.setAttribute(
            "aria-pressed",
            String(active)
          );

        }
      );


      applyFilters();

    }


    function reset() {

      search.value =
        "";

      activeCategory =
        "all";


      filterButtons.forEach(
        button => {

          const active =
            button.getAttribute(
              "data-trouble-filter"
            )
            === "all";


          button.classList.toggle(
            "active",
            active
          );


          button.setAttribute(
            "aria-pressed",
            String(active)
          );

        }
      );


      applyFilters();

      search.focus();

    }


    search.addEventListener(
      "input",
      applyFilters
    );


    filterButtons.forEach(
      button => {

        button.addEventListener(
          "click",
          () => {

            const category =
              button.getAttribute(
                "data-trouble-filter"
              );

            if (category) {
              setCategory(
                category
              );
            }

          }
        );

      }
    );


    clearButton
      ?.addEventListener(
        "click",
        () => {

          search.value =
            "";

          applyFilters();

          search.focus();

        }
      );


    document
      .querySelector(
        "[data-trouble-reset]"
      )
      ?.addEventListener(
        "click",
        reset
      );


    document
      .querySelector(
        "[data-trouble-empty-reset]"
      )
      ?.addEventListener(
        "click",
        reset
      );


    /*
      "/" focuses search.
      Esc clears current query.
    */

    document.addEventListener(
      "keydown",
      event => {

        const target =
          event.target;


        const editing =
          target instanceof HTMLInputElement
          || target instanceof HTMLTextAreaElement;


        if (
          event.key === "/"
          && !editing
        ) {

          event.preventDefault();

          search.focus();

          return;
        }


        if (
          event.key === "Escape"
          && document.activeElement
            === search
        ) {

          if (search.value) {

            search.value =
              "";

            applyFilters();

          } else {

            search.blur();

          }

        }

      }
    );


    /*
      Copy direct URL to one troubleshooting item.
    */

    document.querySelectorAll(
      "[data-copy-issue-link]"
    )
    .forEach(
      link => {

        link.addEventListener(
          "click",
          async event => {

            event.preventDefault();


            const id =
              link.getAttribute(
                "data-copy-issue-link"
              );


            if (!id) {
              return;
            }


            const url =
              new URL(
                window.location.href
              );


            url.search =
              "";

            url.hash =
              id;


            try {

              await navigator.clipboard
                .writeText(
                  url.toString()
                );


              link.classList.add(
                "copied"
              );


              window.setTimeout(
                () => {

                  link.classList.remove(
                    "copied"
                  );

                },
                900
              );

            } catch {

              window.location.hash =
                id;

            }

          }
        );

      }
    );


    /*
      Restore query/filter from URL.
    */

    const params =
      new URLSearchParams(
        window.location.search
      );


    const query =
      params.get("q");


    const category =
      params.get("category");


    if (query) {
      search.value =
        query;
    }


    const categoryExists =
      filterButtons.some(
        button =>
          button.getAttribute(
            "data-trouble-filter"
          )
          === category
      );


    if (
      category
      && categoryExists
    ) {
      activeCategory =
        category;
    }


    setCategory(
      activeCategory
    );


    /*
      Direct issue URL:
      /guide/troubleshooting#ocr-wrong
    */

    if (window.location.hash) {

      const id =
        decodeURIComponent(
          window.location.hash
            .slice(1)
        );


      const issue =
        document.getElementById(
          id
        );


      if (
        issue
        instanceof HTMLDetailsElement
      ) {

        issue.hidden =
          false;

        issue.open =
          true;

      }

    }

  }


  if (
    document.readyState
    === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initTroubleshootingCenter,
      {
        once: true,
      }
    );

  } else {

    initTroubleshootingCenter();

  }
</script>


