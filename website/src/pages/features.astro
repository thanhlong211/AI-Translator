---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureExplorer from "../components/FeatureExplorer.astro";
import FeaturesPremiumMotion from "../components/FeaturesPremiumMotion.astro";
import "../styles/features-premium.css";
---

<BaseLayout
  title="Features — AitraNova"
  description="Khám phá Quick Translate, Manga Session, Documents, Translation Profiles và Learning trong AitraNova."
>

  <main class="features-v8">

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="features-v8-hero">

      <div class="features-v8-glow glow-a"></div>
      <div class="features-v8-glow glow-b"></div>

      <div class="container features-v8-hero-inner">

        <div class="features-v8-copy">

          <span class="features-v8-kicker">
            PRODUCT FEATURES
          </span>

          <h1>

            <span
              data-i18n
              data-vi="Một ứng dụng."
              data-en="One application."
            >
              Một ứng dụng.
            </span>

            <br />

            <em
              data-i18n
              data-vi="Nhiều cách để dịch."
              data-en="Multiple ways to translate."
            >
              Nhiều cách để dịch.
            </em>

          </h1>


          <p
            data-i18n
            data-vi="AitraNova kết hợp dịch màn hình, manga, tài liệu, Translation Profiles và Learning trong cùng một workflow."
            data-en="AitraNova combines screen translation, manga, documents, Translation Profiles and Learning in one workflow."
          >
            AitraNova kết hợp dịch màn hình,
            manga, tài liệu, Translation Profiles
            và Learning trong cùng một workflow.
          </p>


          <div class="features-v8-actions">

            <a
              href="/download"
              class="features-v8-primary"
            >
              <span
                data-i18n
                data-vi="Tải cho Windows"
                data-en="Download for Windows"
              >
                Tải cho Windows
              </span>

              ↓
            </a>


            <a
              href="/guide"
              class="features-v8-secondary"
            >
              <span
                data-i18n
                data-vi="Xem Guide"
                data-en="Open Guide"
              >
                Xem Guide
              </span>

              →
            </a>

          </div>

        </div>


        <div class="features-v8-summary">

          <div>
            <small>SCREEN</small>
            <strong>Quick Translate</strong>
          </div>

          <span></span>

          <div>
            <small>MANGA</small>
            <strong>Cross-page Context</strong>
          </div>

          <span></span>

          <div>
            <small>DOCUMENTS</small>
            <strong>TXT · EPUB · PDF</strong>
          </div>

          <span></span>

          <div>
            <small>CONTROL</small>
            <strong>Profiles · Memory</strong>
          </div>

          <span></span>

          <div>
            <small>LEARNING</small>
            <strong>Vocabulary · Review</strong>
          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         EXPLORER
         ===================================================== -->

    <section class="features-v8-explorer">

      <div class="container">

        <header class="features-v8-section-head">

          <div>

            <span>
              EXPLORE
            </span>

            <h2
              data-i18n
              data-vi="Chọn cách bạn muốn sử dụng AitraNova."
              data-en="Choose how you want to use AitraNova."
            >
              Chọn cách bạn muốn sử dụng AitraNova.
            </h2>

          </div>


          <p
            data-i18n
            data-vi="Mỗi workflow giải quyết một loại nội dung khác nhau nhưng cùng sử dụng nền tảng context và translation control của AitraNova."
            data-en="Each workflow targets a different kind of content while sharing AitraNova's context and translation-control foundation."
          >
            Mỗi workflow giải quyết
            một loại nội dung khác nhau.
          </p>

        </header>


        <FeatureExplorer />

      </div>

    </section>


    <!-- =====================================================
         CONTEXT FIRST
         ===================================================== -->

    <section class="features-v8-context">

      <div class="container features-v8-context-inner">

        <div>

          <span>CONTEXT FIRST</span>

          <h2
            data-i18n
            data-vi="Điểm chung của mọi workflow là context."
            data-en="Every workflow shares the same context-first idea."
          >
            Điểm chung của mọi workflow là context.
          </h2>

          <p
            data-i18n
            data-vi="AitraNova được xây dựng để sử dụng nhiều tín hiệu phù hợp thay vì coi từng câu là một bản dịch hoàn toàn độc lập."
            data-en="AitraNova is designed to use relevant signals instead of treating every sentence as an entirely isolated translation."
          >
            AitraNova không chỉ nhìn
            một câu rồi quên mọi thứ xung quanh.
          </p>

        </div>


        <div class="features-context-stack">

          <div>
            <span>01</span>

            <div>
              <small>SOURCE</small>

              <strong
                data-i18n
                data-vi="Nội dung hiện tại"
                data-en="Current content"
              >
                Nội dung hiện tại
              </strong>
            </div>
          </div>


          <div>
            <span>02</span>

            <div>
              <small>PROFILE</small>

              <strong>
                Glossary + Character Rules
              </strong>
            </div>
          </div>


          <div>
            <span>03</span>

            <div>
              <small>CONTEXT</small>

              <strong>
                Recent Context + Memory
              </strong>
            </div>
          </div>


          <div>
            <span>04</span>

            <div>
              <small>RESULT</small>

              <strong
                data-i18n
                data-vi="Bản dịch phù hợp hơn"
                data-en="A more informed translation"
              >
                Bản dịch phù hợp hơn
              </strong>
            </div>
          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         FINAL CTA
         ===================================================== -->

    <section class="features-v8-final">

      <div class="container">

        <div class="features-v8-final-card">

          <div>

            <span>
              AITRANOVA FOR WINDOWS
            </span>

            <h2
              data-i18n
              data-vi="Bắt đầu với Quick Translate."
              data-en="Start with Quick Translate."
            >
              Bắt đầu với Quick Translate.
            </h2>

            <p
              data-i18n
              data-vi="Sau đó mở rộng sang Manga, Documents, Profiles và Learning khi bạn cần."
              data-en="Then expand into Manga, Documents, Profiles and Learning as you need them."
            >
              Sau đó mở rộng sang các workflow
              khác khi bạn cần.
            </p>

          </div>


          <div>

            <a href="/download">

              <span
                data-i18n
                data-vi="Tải AitraNova"
                data-en="Download AitraNova"
              >
                Tải AitraNova
              </span>

              ↓

            </a>


            <a href="/guide/quick">

              <span
                data-i18n
                data-vi="Hướng dẫn Quick Translate"
                data-en="Quick Translate Guide"
              >
                Hướng dẫn Quick Translate
              </span>

              →

            </a>

          </div>

        </div>

      </div>

    </section>

  </main>


  <FeaturesPremiumMotion />

</BaseLayout>


<style>

  .features-v8 {
    overflow: hidden;

    background:
      linear-gradient(
        180deg,
        #ded9e9,
        #d7d1e1
      );
  }


  /* =========================================================
     HERO
     ========================================================= */

  .features-v8-hero {
    position: relative;

    padding:
      83px 0 54px;

    overflow: hidden;

    border-bottom:
      1px solid #c8bfd2;
  }


  .features-v8-glow {
    position: absolute;

    border-radius: 50%;

    pointer-events: none;

    filter: blur(1px);
  }


  .features-v8-glow.glow-a {
    top: -360px;
    left: -190px;

    width: 720px;
    height: 720px;

    background:
      radial-gradient(
        circle,
        rgba(
          105,
          82,
          238,
          0.2
        ),
        transparent 67%
      );
  }


  .features-v8-glow.glow-b {
    right: -220px;
    bottom: -430px;

    width: 780px;
    height: 780px;

    background:
      radial-gradient(
        circle,
        rgba(
          85,
          127,
          220,
          0.14
        ),
        transparent 68%
      );
  }


  .features-v8-hero-inner {
    position: relative;

    z-index: 2;
  }


  .features-v8-copy {
    max-width: 900px;
  }


  .features-v8-kicker {
    color: #6952ee;

    font-size: 7px;

    font-weight: 850;

    letter-spacing: 0.13em;
  }


  .features-v8-copy h1 {
    margin:
      16px 0 18px;

    color: #1d1827;

    font-size:
      clamp(
        54px,
        8vw,
        92px
      );

    line-height: 0.88;

    letter-spacing:
      -0.07em;
  }


  .features-v8-copy
  h1 em {
    color: #6952ee;

    font-style: normal;
  }


  .features-v8-copy > p {
    max-width: 700px;

    margin: 0;

    color: #706779;

    font-size: 12px;

    line-height: 1.7;
  }


  .features-v8-actions {
    display: flex;

    flex-wrap: wrap;

    gap: 8px;

    margin-top: 24px;
  }


  .features-v8-actions a {
    display: inline-flex;

    min-height: 42px;

    align-items: center;
    justify-content: center;

    gap: 9px;

    padding:
      0 15px;

    border-radius: 10px;

    font-size: 7px;

    font-weight: 800;
  }


  .features-v8-primary {
    background: #6952ee;

    color: white;

    box-shadow:
      0 10px 26px
      rgba(
        105,
        82,
        238,
        0.21
      );
  }


  .features-v8-secondary {
    border:
      1px solid #c4bacf;

    background:
      rgba(
        255,
        255,
        255,
        0.32
      );

    color: #302938;
  }


  .features-v8-summary {
    display: grid;

    grid-template-columns:
      repeat(
        9,
        auto
      );

    align-items: center;

    justify-content: start;

    gap: 18px;

    margin-top: 50px;

    padding-top: 20px;

    border-top:
      1px solid #c9c0d3;
  }


  .features-v8-summary
  > div {
    min-width: 125px;
  }


  .features-v8-summary small {
    display: block;

    color: #998fa3;

    font-size: 5px;

    letter-spacing: 0.1em;
  }


  .features-v8-summary strong {
    display: block;

    margin-top: 4px;

    color: #393140;

    font-size: 7px;
  }


  .features-v8-summary
  > span {
    width: 1px;
    height: 27px;

    background: #c7bdcf;
  }


  /* =========================================================
     EXPLORER
     ========================================================= */

  .features-v8-explorer {
    padding:
      68px 0 72px;
  }


  .features-v8-section-head {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      minmax(260px, 0.55fr);

    align-items: end;

    gap: 40px;
  }


  .features-v8-section-head
  span {
    color: #6952ee;

    font-size: 6px;

    font-weight: 850;

    letter-spacing: 0.12em;
  }


  .features-v8-section-head
  h2 {
    max-width: 720px;

    margin:
      10px 0 0;

    color: #211b2a;

    font-size:
      clamp(
        34px,
        4.5vw,
        52px
      );

    line-height: 0.98;

    letter-spacing:
      -0.055em;
  }


  .features-v8-section-head
  > p {
    margin: 0;

    color: #776d81;

    font-size: 9px;

    line-height: 1.65;
  }


  /* =========================================================
     CONTEXT
     ========================================================= */

  .features-v8-context {
    padding:
      70px 0;

    background: #17131f;

    color: white;
  }


  .features-v8-context-inner {
    display: grid;

    grid-template-columns:
      0.8fr 1.2fr;

    align-items: center;

    gap: 70px;
  }


  .features-v8-context
  span {
    color: #9b8cff;

    font-size: 6px;

    font-weight: 850;

    letter-spacing: 0.12em;
  }


  .features-v8-context h2 {
    max-width: 550px;

    margin:
      11px 0;

    color: #f4f0f7;

    font-size:
      clamp(
        34px,
        4vw,
        50px
      );

    line-height: 0.98;

    letter-spacing:
      -0.055em;
  }


  .features-v8-context p {
    max-width: 520px;

    margin: 0;

    color: #8f8798;

    font-size: 9px;

    line-height: 1.7;
  }


  .features-context-stack {
    display: grid;

    gap: 8px;
  }


  .features-context-stack
  > div {
    display: grid;

    grid-template-columns:
      auto 1fr;

    align-items: center;

    gap: 12px;

    min-height: 67px;

    padding:
      0 15px;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.08
      );

    border-radius: 11px;

    background:
      rgba(
        255,
        255,
        255,
        0.025
      );
  }


  .features-context-stack
  > div > span {
    display: grid;

    width: 32px;
    height: 32px;

    place-items: center;

    border-radius: 8px;

    background:
      rgba(
        105,
        82,
        238,
        0.17
      );

    color: #a99aff;

    font-size: 6px;
  }


  .features-context-stack small {
    display: block;

    color: #6f6878;

    font-size: 5px;
  }


  .features-context-stack strong {
    display: block;

    margin-top: 3px;

    color: #dcd6e2;

    font-size: 8px;
  }


  /* =========================================================
     FINAL CTA
     ========================================================= */

  .features-v8-final {
    padding:
      68px 0 82px;
  }


  .features-v8-final-card {
    display: grid;

    grid-template-columns:
      1fr auto;

    align-items: center;

    gap: 45px;

    padding: 34px;

    border:
      1px solid #c4bacf;

    border-radius: 22px;

    background:
      linear-gradient(
        135deg,
        #e7e1ef,
        #d8d3e5
      );

    box-shadow:
      0 22px 50px
      rgba(
        49,
        37,
        65,
        0.08
      );
  }


  .features-v8-final-card
  > div:first-child > span {
    color: #6952ee;

    font-size: 6px;

    font-weight: 850;

    letter-spacing: 0.12em;
  }


  .features-v8-final-card h2 {
    margin:
      9px 0 7px;

    color: #211b2a;

    font-size:
      clamp(
        31px,
        4vw,
        46px
      );

    line-height: 0.98;

    letter-spacing:
      -0.05em;
  }


  .features-v8-final-card p {
    margin: 0;

    color: #776d81;

    font-size: 8px;
  }


  .features-v8-final-card
  > div:last-child {
    display: flex;

    flex-direction: column;

    gap: 7px;
  }


  .features-v8-final-card
  a {
    display: flex;

    min-width: 180px;
    min-height: 40px;

    align-items: center;

    justify-content:
      space-between;

    gap: 14px;

    padding:
      0 13px;

    border-radius: 10px;

    font-size: 7px;

    font-weight: 800;
  }


  .features-v8-final-card
  a:first-child {
    background: #6952ee;

    color: white;
  }


  .features-v8-final-card
  a:last-child {
    border:
      1px solid #c4bacf;

    background:
      rgba(
        255,
        255,
        255,
        0.35
      );

    color: #393141;
  }


  @media (max-width: 900px) {

    .features-v8-summary {
      display: flex;

      overflow-x: auto;
    }


    .features-v8-summary
    > span {
      flex: 0 0 1px;
    }


    .features-v8-section-head,
    .features-v8-context-inner,
    .features-v8-final-card {
      grid-template-columns: 1fr;
    }

  }


  @media (max-width: 600px) {

    .features-v8-hero {
      padding-top: 62px;
    }


    .features-v8-copy h1 {
      font-size:
        clamp(
          47px,
          15vw,
          68px
        );
    }


    .features-v8-final-card {
      padding: 24px;
    }


    .features-v8-final-card
    > div:last-child {
      width: 100%;
    }


    .features-v8-final-card
    a {
      width: 100%;
    }

  }

</style>
