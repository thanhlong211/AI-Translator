---
import BaseLayout from "../layouts/BaseLayout.astro";
import DownloadReleaseCard from "../components/DownloadReleaseCard.astro";
import DownloadPremiumMotion from "../components/DownloadPremiumMotion.astro";
import "../styles/download-premium.css";
import "../styles/download-text-contrast-fix.css";
import "../styles/download-install-system-night.css";
import "../styles/download-final-rhythm.css";
---

<BaseLayout
  title="Download AitraNova — Windows"
  description="Tải AitraNova cho Windows và bắt đầu với Quick Translate, Manga, Documents, Profiles và Learning."
>

  <main class="download-v8">

    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="download-hero">

      <div class="download-glow glow-one"></div>
      <div class="download-glow glow-two"></div>

      <div class="container download-hero-inner">

        <div class="download-copy">

          <span class="download-kicker">
            DESKTOP APP · WINDOWS
          </span>


          <h1>

            <span
              data-i18n
              data-vi="AitraNova,"
              data-en="AitraNova,"
            >
              AitraNova,
            </span>

            <br />

            <em
              data-i18n
              data-vi="ngay trên desktop."
              data-en="right on your desktop."
            >
              ngay trên desktop.
            </em>

          </h1>


          <p
            data-i18n
            data-vi="Dịch màn hình, manga và tài liệu. Kiểm soát terminology bằng Profiles và tiếp tục học từ chính nội dung bạn đang đọc."
            data-en="Translate screens, manga and documents. Control terminology with Profiles and continue learning from the content you actually read."
          >
            Dịch màn hình, manga và tài liệu.
            Kiểm soát terminology bằng Profiles
            và học từ chính nội dung bạn đang đọc.
          </p>


          <div class="download-hero-tags">

            <span>
              ✓ Windows
            </span>

            <span>
              ✓ Quick Translate
            </span>

            <span>
              ✓ Manga
            </span>

            <span>
              ✓ Documents
            </span>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         RELEASE
         ===================================================== -->

    <section class="download-release">

      <div class="container">

        <DownloadReleaseCard />

      </div>

    </section>


    <!-- =====================================================
         INSTALL FLOW
         ===================================================== -->

    <section class="download-install">

      <div class="container">

        <header class="download-section-head">

          <div>

            <span>INSTALLATION</span>

            <h2
              data-i18n
              data-vi="Từ download đến bản dịch đầu tiên."
              data-en="From download to your first translation."
            >
              Từ download đến bản dịch đầu tiên.
            </h2>

          </div>


          <a href="/guide/installation">

            <span
              data-i18n
              data-vi="Xem hướng dẫn đầy đủ"
              data-en="Full installation guide"
            >
              Xem hướng dẫn đầy đủ
            </span>

            →

          </a>

        </header>


        <div class="install-flow">

          <div>
            <span>01</span>

            <small>DOWNLOAD</small>

            <strong
              data-i18n
              data-vi="Tải release"
              data-en="Download the release"
            >
              Tải release
            </strong>

            <p
              data-i18n
              data-vi="Lấy phiên bản Windows từ nguồn phát hành chính thức."
              data-en="Get the Windows version from the official release source."
            >
              Tải từ nguồn phát hành chính thức.
            </p>
          </div>

          <i>→</i>

          <div>
            <span>02</span>

            <small>INSTALL</small>

            <strong
              data-i18n
              data-vi="Cài AitraNova"
              data-en="Install AitraNova"
            >
              Cài AitraNova
            </strong>

            <p
              data-i18n
              data-vi="Mở installer và hoàn tất quá trình cài đặt."
              data-en="Open the installer and complete installation."
            >
              Hoàn tất quá trình cài đặt.
            </p>
          </div>

          <i>→</i>

          <div>
            <span>03</span>

            <small>CONFIGURE</small>

            <strong>
              Language + Profile
            </strong>

            <p
              data-i18n
              data-vi="Chọn cặp ngôn ngữ và Translation Profile phù hợp."
              data-en="Choose the language pair and an appropriate Translation Profile."
            >
              Chọn ngôn ngữ và Profile.
            </p>
          </div>

          <i>→</i>

          <div>
            <span>04</span>

            <small>TRANSLATE</small>

            <strong>
              Ctrl + Shift + Q
            </strong>

            <p
              data-i18n
              data-vi="Thử Quick Translate với một dòng text rõ trên màn hình."
              data-en="Try Quick Translate with a clear line of text on screen."
            >
              Thử bản dịch đầu tiên.
            </p>
          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         REQUIREMENTS
         ===================================================== -->

    <section class="download-requirements">

      <div class="container requirements-layout">

        <div class="requirements-copy">

          <span>SYSTEM</span>

          <h2
            data-i18n
            data-vi="Trước khi cài."
            data-en="Before installing."
          >
            Trước khi cài.
          </h2>

          <p
            data-i18n
            data-vi="AitraNova Desktop hiện tập trung vào Windows. Yêu cầu chi tiết có thể thay đổi trong giai đoạn Beta và sẽ được công bố cùng từng release."
            data-en="AitraNova Desktop currently focuses on Windows. Detailed requirements may change during Beta and will be published with each release."
          >
            AitraNova Desktop hiện tập trung
            vào Windows. Yêu cầu chi tiết có thể
            thay đổi trong giai đoạn Beta.
          </p>

        </div>


        <div class="requirements-grid">

          <div>

            <span>OS</span>

            <div>
              <small>PLATFORM</small>
              <strong>Windows</strong>
            </div>

          </div>


          <div>

            <span>NET</span>

            <div>
              <small>AI SERVICES</small>

              <strong
                data-i18n
                data-vi="Kết nối Internet"
                data-en="Internet connection"
              >
                Kết nối Internet
              </strong>
            </div>

          </div>


          <div>

            <span>OCR</span>

            <div>
              <small>INPUT QUALITY</small>

              <strong
                data-i18n
                data-vi="Text / ảnh đủ rõ"
                data-en="Clear text / images"
              >
                Text / ảnh đủ rõ
              </strong>
            </div>

          </div>


          <div>

            <span>β</span>

            <div>
              <small>CHANNEL</small>

              <strong>
                Beta
              </strong>
            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         BETA NOTICE
         ===================================================== -->

    <section class="download-beta">

      <div class="container">

        <div class="beta-card">

          <span class="beta-symbol">
            β
          </span>


          <div>

            <small>BETA SOFTWARE</small>

            <h2
              data-i18n
              data-vi="AitraNova vẫn đang được phát triển."
              data-en="AitraNova is still evolving."
            >
              AitraNova vẫn đang được phát triển.
            </h2>

            <p
              data-i18n
              data-vi="UI, workflow và yêu cầu hệ thống có thể thay đổi giữa các release. Changelog và Roadmap là nơi theo dõi những thay đổi công khai."
              data-en="UI, workflows and system requirements may change between releases. Changelog and Roadmap provide public updates."
            >
              UI và workflow có thể thay đổi
              giữa các release.
            </p>

          </div>


          <div class="beta-links">

            <a href="/changelog">
              Changelog
              →
            </a>

            <a href="/roadmap">
              Roadmap
              →
            </a>

          </div>

        </div>

      </div>

    </section>


    <!-- =====================================================
         WHAT NEXT
         ===================================================== -->

    <section class="download-next">

      <div class="container">

        <div class="download-next-card">

          <div>

            <span>AFTER INSTALLATION</span>

            <h2
              data-i18n
              data-vi="Bắt đầu bằng một vùng nhỏ."
              data-en="Start with one small area."
            >
              Bắt đầu bằng một vùng nhỏ.
            </h2>

            <p
              data-i18n
              data-vi="Quick Translate là cách đơn giản nhất để kiểm tra AitraNova đã hoạt động đúng trước khi chuyển sang Manga hoặc Documents."
              data-en="Quick Translate is the simplest way to verify AitraNova is working before moving on to Manga or Documents."
            >
              Quick Translate là cách đơn giản nhất
              để kiểm tra cài đặt.
            </p>

          </div>


          <div>

            <a
              href="/guide/quick"
              class="next-primary"
            >
              Quick Translate Guide
              →
            </a>

            <a href="/features">
              Features
              →
            </a>

          </div>

        </div>

      </div>

    </section>

  </main>


  <DownloadPremiumMotion />

</BaseLayout>


<style>

  .download-v8 {
    overflow: hidden;

    background:
      linear-gradient(
        180deg,
        #dfdae9,
        #d7d1e1
      );
  }


  /* =========================================================
     HERO
     ========================================================= */

  .download-hero {
    position: relative;

    overflow: hidden;

    padding:
      84px 0 69px;

    border-bottom:
      1px solid #c6bdcf;
  }


  .download-glow {
    position: absolute;

    border-radius: 50%;

    pointer-events: none;
  }


  .download-glow.glow-one {
    top: -400px;
    right: -160px;

    width: 760px;
    height: 760px;

    background:
      radial-gradient(
        circle,
        rgba(
          105,
          82,
          238,
          0.19
        ),
        transparent 68%
      );
  }


  .download-glow.glow-two {
    bottom: -430px;
    left: -250px;

    width: 780px;
    height: 780px;

    background:
      radial-gradient(
        circle,
        rgba(
          85,
          127,
          220,
          0.12
        ),
        transparent 69%
      );
  }


  .download-hero-inner {
    position: relative;

    z-index: 2;
  }


  .download-copy {
    max-width: 900px;
  }


  .download-kicker {
    color: #6952ee;

    font-size: 7px;

    font-weight: 850;

    letter-spacing:
      0.13em;
  }


  .download-copy h1 {
    margin:
      15px 0 18px;

    color: #1d1827;

    font-size:
      clamp(
        56px,
        8vw,
        94px
      );

    line-height: 0.87;

    letter-spacing:
      -0.07em;
  }


  .download-copy
  h1 em {
    color: #6952ee;

    font-style: normal;
  }


  .download-copy > p {
    max-width: 700px;

    margin: 0;

    color: #706779;

    font-size: 11px;

    line-height: 1.7;
  }


  .download-hero-tags {
    display: flex;

    flex-wrap: wrap;

    gap: 7px;

    margin-top: 24px;
  }


  .download-hero-tags span {
    display: inline-flex;

    min-height: 28px;

    align-items: center;

    padding:
      0 9px;

    border:
      1px solid #c5bbcf;

    border-radius: 999px;

    background:
      rgba(
        255,
        255,
        255,
        0.28
      );

    color: #675e71;

    font-size: 6px;

    font-weight: 750;
  }


  /* =========================================================
     RELEASE
     ========================================================= */

  .download-release {
    padding:
      58px 0 71px;
  }


  /* =========================================================
     SECTION HEAD
     ========================================================= */

  .download-install {
    padding:
      66px 0;

    border-top:
      1px solid #c7bed1;

    background:
      rgba(
        226,
        220,
        234,
        0.5
      );
  }


  .download-section-head {
    display: flex;

    align-items: end;

    justify-content:
      space-between;

    gap: 35px;
  }


  .download-section-head span {
    color: #6952ee;

    font-size: 6px;

    font-weight: 850;

    letter-spacing:
      0.12em;
  }


  .download-section-head h2 {
    max-width: 660px;

    margin:
      9px 0 0;

    color: #211b2b;

    font-size:
      clamp(
        34px,
        4.5vw,
        52px
      );

    line-height: 0.98;

    letter-spacing:
      -0.055em;
  }


  .download-section-head > a {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    color: #6952ee;

    font-size: 7px;

    font-weight: 800;
  }


  /* INSTALL FLOW */

  .install-flow {
    display: grid;

    grid-template-columns:
      1fr auto 1fr auto 1fr auto 1fr;

    align-items: center;

    gap: 8px;

    margin-top: 30px;
  }


  .install-flow > div {
    min-height: 145px;

    padding: 16px;

    border:
      1px solid #c7bed1;

    border-radius: 13px;

    background:
      rgba(
        243,
        239,
        247,
        0.48
      );
  }


  .install-flow
  > div > span {
    display: grid;

    width: 29px;
    height: 29px;

    place-items: center;

    border-radius: 8px;

    background: #e3dcfb;

    color: #6952ee;

    font-size: 6px;

    font-weight: 850;
  }


  .install-flow small {
    display: block;

    margin-top: 15px;

    color: #978da1;

    font-size: 5px;
  }


  .install-flow strong {
    display: block;

    margin-top: 4px;

    color: #302938;

    font-size: 9px;
  }


  .install-flow p {
    margin:
      5px 0 0;

    color: #7d7387;

    font-size: 7px;

    line-height: 1.55;
  }


  .install-flow > i {
    color: #6952ee;

    font-style: normal;
  }


  /* =========================================================
     REQUIREMENTS
     ========================================================= */

  .download-requirements {
    padding:
      72px 0;

    background: #17131f;

    color: white;
  }


  .requirements-layout {
    display: grid;

    grid-template-columns:
      0.7fr 1.3fr;

    align-items: center;

    gap: 65px;
  }


  .requirements-copy > span {
    color: #9f91ff;

    font-size: 6px;

    font-weight: 850;

    letter-spacing:
      0.12em;
  }


  .requirements-copy h2 {
    margin:
      9px 0;

    color: #f2eef5;

    font-size:
      clamp(
        36px,
        4.5vw,
        53px
      );

    line-height: 0.98;

    letter-spacing:
      -0.055em;
  }


  .requirements-copy p {
    margin: 0;

    color: #8e8697;

    font-size: 9px;

    line-height: 1.7;
  }


  .requirements-grid {
    display: grid;

    grid-template-columns:
      1fr 1fr;

    gap: 8px;
  }


  .requirements-grid > div {
    display: grid;

    grid-template-columns:
      auto 1fr;

    align-items: center;

    gap: 11px;

    min-height: 78px;

    padding:
      0 14px;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.08
      );

    border-radius: 11px;

    background:
      rgba(
        255,
        255,
        255,
        0.025
      );
  }


  .requirements-grid
  > div > span {
    display: grid;

    width: 36px;
    height: 36px;

    place-items: center;

    border-radius: 9px;

    background:
      rgba(
        105,
        82,
        238,
        0.17
      );

    color: #a99aff;

    font-size: 7px;

    font-weight: 850;
  }


  .requirements-grid small {
    display: block;

    color: #6f6878;

    font-size: 5px;
  }


  .requirements-grid strong {
    display: block;

    margin-top: 3px;

    color: #ded8e4;

    font-size: 8px;
  }


  /* =========================================================
     BETA
     ========================================================= */

  .download-beta {
    padding:
      67px 0 0;
  }


  .beta-card {
    display: grid;

    grid-template-columns:
      auto 1fr auto;

    align-items: center;

    gap: 22px;

    padding: 25px;

    border:
      1px solid #c5bbcf;

    border-radius: 17px;

    background:
      rgba(
        238,
        233,
        244,
        0.56
      );
  }


  .beta-symbol {
    display: grid;

    width: 53px;
    height: 53px;

    place-items: center;

    border-radius: 14px;

    background: #6952ee;

    color: white;

    font-size: 19px;

    font-weight: 850;
  }


  .beta-card small {
    color: #6952ee;

    font-size: 5px;

    font-weight: 850;

    letter-spacing:
      0.1em;
  }


  .beta-card h2 {
    margin:
      4px 0;

    color: #2a2332;

    font-size: 19px;

    letter-spacing:
      -0.035em;
  }


  .beta-card p {
    margin: 0;

    color: #7b7185;

    font-size: 7px;

    line-height: 1.55;
  }


  .beta-links {
    display: flex;

    flex-direction: column;

    gap: 6px;
  }


  .beta-links a {
    display: flex;

    min-width: 125px;
    min-height: 34px;

    align-items: center;

    justify-content:
      space-between;

    gap: 14px;

    padding:
      0 10px;

    border:
      1px solid #c5bbcf;

    border-radius: 8px;

    color: #514958;

    font-size: 6px;

    font-weight: 750;
  }


  /* =========================================================
     NEXT
     ========================================================= */

  .download-next {
    padding:
      24px 0 80px;
  }


  .download-next-card {
    display: grid;

    grid-template-columns:
      1fr auto;

    align-items: center;

    gap: 50px;

    padding: 30px;

    border-radius: 20px;

    background: #17131f;

    color: white;

    box-shadow:
      0 26px 55px
      rgba(
        38,
        28,
        52,
        0.15
      );
  }


  .download-next-card
  > div:first-child > span {
    color: #9d8fff;

    font-size: 6px;

    font-weight: 850;

    letter-spacing:
      0.12em;
  }


  .download-next-card h2 {
    margin:
      8px 0 6px;

    color: #f2eef5;

    font-size:
      clamp(
        31px,
        4vw,
        45px
      );

    line-height: 0.98;

    letter-spacing:
      -0.05em;
  }


  .download-next-card p {
    margin: 0;

    color: #8d8696;

    font-size: 8px;

    line-height: 1.6;
  }


  .download-next-card
  > div:last-child {
    display: flex;

    flex-direction: column;

    gap: 7px;
  }


  .download-next-card a {
    display: flex;

    min-width: 185px;
    min-height: 39px;

    align-items: center;

    justify-content:
      space-between;

    gap: 15px;

    padding:
      0 12px;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.1
      );

    border-radius: 9px;

    color: #d9d3df;

    font-size: 7px;

    font-weight: 750;
  }


  .download-next-card
  .next-primary {
    border-color: #6952ee;

    background: #6952ee;

    color: white;
  }


  @media (max-width: 850px) {

    .install-flow,
    .requirements-layout,
    .download-next-card {
      grid-template-columns: 1fr;
    }


    .install-flow > i {
      transform:
        rotate(90deg);

      justify-self: center;
    }


    .download-section-head {
      align-items: flex-start;

      flex-direction: column;
    }


    .beta-card {
      grid-template-columns:
        auto 1fr;
    }


    .beta-links {
      grid-column:
        1 / -1;

      flex-direction: row;
    }

  }


  @media (max-width: 560px) {

    .download-hero {
      padding-top: 63px;
    }


    .download-copy h1 {
      font-size:
        clamp(
          48px,
          15vw,
          68px
        );
    }


    .requirements-grid {
      grid-template-columns: 1fr;
    }


    .beta-card {
      grid-template-columns: 1fr;
    }


    .beta-links {
      flex-direction: column;
    }


    .beta-links a {
      width: 100%;
    }

  }

</style>
