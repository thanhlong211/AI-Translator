    display: flex;

    align-items: center;

    justify-content:
      space-between;
  }

  .result-top small {
    display: block;

    color:
      var(--muted-2);

    font-size: 6px;
  }

  .result-top strong {
    display: block;

    margin-top: 2px;

    font-size: 9px;
  }

