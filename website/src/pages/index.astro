  .process-row i.full {
    width: 100%;
  }

  .context-progress {
    width: 100%;
  }

  .ai-progress {
    width: 72%;
  }

  .process-row b {
    color:
      var(--green);

    font-size: 8px;
  }

  .process-row b.processing {
    color:
      var(--primary);
  }

  /* RESULT */

  .result-card {
    position: absolute;

    z-index: 8;

    right: 34px;
    bottom: 32px;

    width: 300px;

    padding: 17px;

    border:
      1px solid var(--border);

