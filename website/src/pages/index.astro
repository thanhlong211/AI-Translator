  .processing-head small {
    display: block;

    color:
      var(--muted-2);

    font-size: 6px;

    letter-spacing:
      0.1em;
  }

  .processing-head strong {
    display: block;

    margin-top: 2px;

    color:
      var(--text);

    font-size: 9px;
  }

  .process-row {
    display: grid;

    grid-template-columns:
