  /* =========================================================
     V5.3A — HOW IT WORKS
     ========================================================= */

  .how-section {
    position: relative;

    background:
      #ffffff;
  }

  .how-heading {
    display: grid;

    grid-template-columns:
      1.15fr 0.85fr;

    align-items: end;

    gap: 80px;

    margin-bottom: 50px;
  }

  .how-intro {
    padding-bottom: 4px;
  }

  .how-intro p {
    margin: 0;

    color:
      var(--muted);

    font-size: 15px;

    line-height: 1.75;
  }

  .how-intro a {
    display: inline-flex;

    align-items: center;

    gap: 9px;

    margin-top: 14px;

    color:
      var(--primary);

    font-size: 12px;

    font-weight: 750;
  }

  .how-workspace {
    display: grid;

    grid-template-columns:
      300px minmax(0, 1fr);

    gap: 22px;
  }

  /* STEP NAV */

  .how-steps {
    display: grid;

    align-content: start;

    gap: 8px;
  }

  .how-step {
    position: relative;

    display: grid;

    grid-template-columns:
      auto 1fr auto;

    align-items: center;

    gap: 12px;

    min-height: 92px;

    padding:
      16px;

    border:
      1px solid var(--border);

    border-radius: 15px;

    background:
      #fafbfe;

    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease;
  }

  .how-step:hover {
    transform:
      translateX(3px);

    border-color:
      rgba(99, 91, 255, 0.22);

    background: white;

    box-shadow:
      var(--shadow-xs);
  }

  .how-step.active {
    border-color:
      rgba(99, 91, 255, 0.23);

    background:
      linear-gradient(
        135deg,
        #f4f2ff,
        #f8f7ff
      );

    box-shadow:
      0 10px 26px
      rgba(99, 91, 255, 0.08);
  }

  .step-number {
    display: grid;

    width: 35px;
    height: 35px;

    place-items: center;

    border-radius: 10px;

    background:
      white;

    color:
      var(--muted-2);

    box-shadow:
      var(--shadow-xs);

    font-size: 9px;

    font-weight: 850;
  }

  .how-step.active
  .step-number {
    background:
      var(--primary);

    color: white;
  }

  .how-step strong {
    display: block;

    color:
      var(--text);

    font-size: 12px;
  }

  .how-step p {
    margin:
      3px 0 0;

    color:
      var(--muted);

    font-size: 9px;

    line-height: 1.5;
  }

  .step-state {
    display: grid;

    width: 22px;
    height: 22px;

    place-items: center;

    border-radius: 50%;

    background:
      #eafaf3;

    color:
      var(--green);

    font-size: 9px;

    font-weight: 850;
  }

