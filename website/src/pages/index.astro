---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroProductPreview from "../components/HeroProductPreview.astro";

const features = [
  {
    code: "01",
    vi: "Dịch nhanh màn hình",
    en: "Quick screen translation",
    viDesc:
      "Chọn bất kỳ vùng nào trên màn hình, OCR và nhận bản dịch mà không cần đổi ứng dụng.",
    enDesc:
      "Select any area on your screen, OCR it and get a translation without switching applications.",
    className: "quick",
  },
  {
    code: "02",
    vi: "Manga Session",
    en: "Manga Session",
    viDesc:
      "Dịch nhiều bubble cùng lúc và giữ context giữa các trang manga.",
    enDesc:
      "Translate multiple bubbles together while preserving context across manga pages.",
    className: "manga",
  },
  {
    code: "03",
    vi: "Translation Profile",
    en: "Translation Profile",
    viDesc:
      "Kiểm soát văn phong, Glossary, Character Rules, honorific và context.",
    enDesc:
      "Control style, Glossary, Character Rules, honorifics and context.",
    className: "profile",
  },
  {
    code: "04",
    vi: "Document Reader",
    en: "Document Reader",
    viDesc:
      "Đọc và dịch TXT, EPUB, PDF trong một workflow dành cho nội dung dài.",
    enDesc:
      "Read and translate TXT, EPUB and PDF in a workflow designed for longer content.",
    className: "document",
  },
  {
    code: "05",
    vi: "Translation Memory",
    en: "Translation Memory",
    viDesc:
      "Sử dụng lại những bản dịch và correction đáng tin cậy khi phù hợp.",
    enDesc:
      "Reuse trusted translations and corrections when appropriate.",
    className: "memory",
  },
];
import MangaShowcase from "../components/MangaShowcase.astro";
import HomeSectionSwitcher from "../components/HomeSectionSwitcher.astro";
import CompactFeatureNav from "../components/CompactFeatureNav.astro";
import HomeEnhancements from "../components/HomeEnhancements.astro";
import CompactGuidePreview from "../components/CompactGuidePreview.astro";
import HomeHeroMotion from "../components/HomeHeroMotion.astro";
import "../styles/home-hero-motion.css";
import HomeHeroPremium from "../components/HomeHeroPremium.astro";
import "../styles/home-hero-premium.css";
import HomeVisualRhythm from "../components/HomeVisualRhythm.astro";
import "../styles/home-visual-rhythm.css";
import "../styles/home-hero-contrast-exact.css";
import "../styles/home-night-shell.css";
import "../styles/home-light-card-text-lock.css";
---

<BaseLayout>

  <!-- HERO -->

  <section class="hero-v5 home-hero-production-lock">

    <div class="hero-orb hero-orb-purple"></div>
    <div class="hero-orb hero-orb-blue"></div>

    <div class="container hero-v5-grid">

      <!-- COPY -->

      <div class="hero-v5-copy">

        <div class="product-chip">

          <span class="product-chip-dot"></span>

          <span
            data-i18n
            data-vi="AitraNova dành cho Windows"
            data-en="AitraNova for Windows"
          >
            AitraNova dành cho Windows
          </span>

          <b>
            BETA
          </b>

        </div>

        <h1>

          <span
            data-i18n
            data-vi="Dịch ngay"
            data-en="Translate directly"
          >
            Dịch ngay
          </span>

          <span
            data-i18n
            data-vi="trên màn hình."
            data-en="on your screen."
          >
            trên màn hình.
          </span>

          <em
            data-i18n
            data-vi="Giữ nguyên ngữ cảnh."
            data-en="Keep the context."
          >
            Giữ nguyên ngữ cảnh.
          </em>

        </h1>

        <p
          data-i18n
          data-vi="AitraNova kết hợp OCR, AI theo ngữ cảnh, Translation Profile và Memory để dịch màn hình, manga và tài liệu mà không làm gián đoạn việc bạn đang đọc."
          data-en="AitraNova combines OCR, contextual AI, Translation Profiles and Memory to translate screens, manga and documents without interrupting what you're reading."
        >
          AitraNova kết hợp OCR, AI theo ngữ cảnh,
          Translation Profile và Memory để dịch
          màn hình, manga và tài liệu mà không làm
          gián đoạn việc bạn đang đọc.
        </p>

        <div class="hero-v5-actions">

          <a
            href="/download"
            class="button button-primary hero-download"
          >

            <span class="windows-icon">
              ⊞
            </span>

            <span
              data-i18n
              data-vi="Tải cho Windows"
              data-en="Download for Windows"
            >
              Tải cho Windows
            </span>

            <span>
              ↓
            </span>

          </a>

          <a
            href="/guide"
            class="button button-secondary"
          >

            <span
              data-i18n
              data-vi="Xem cách sử dụng"
              data-en="See how it works"
            >
              Xem cách sử dụng
            </span>

            <span>
              →
            </span>

          </a>

        </div>

        <!-- CAPABILITIES -->

        <div class="hero-capabilities">

          <div>
            <span class="capability-icon purple">
              ⌘
            </span>

            <div>
              <strong>
                Screen OCR
              </strong>

              <small
                data-i18n
                data-vi="Chọn và dịch vùng màn hình"
                data-en="Select and translate screen areas"
              >
                Chọn và dịch vùng màn hình
              </small>
            </div>
          </div>

          <div>
            <span class="capability-icon blue">
              漫
            </span>

            <div>
              <strong>
                Manga Context
              </strong>

              <small
                data-i18n
                data-vi="Giữ context qua nhiều trang"
                data-en="Keep context across pages"
              >
                Giữ context qua nhiều trang
              </small>
            </div>
          </div>

          <div>
            <span class="capability-icon green">
              ↺
            </span>

            <div>
              <strong>
                Memory
              </strong>

              <small
                data-i18n
                data-vi="Nhớ correction đáng tin cậy"
                data-en="Remember trusted corrections"
              >
                Nhớ correction đáng tin cậy
              </small>
            </div>
          </div>

        </div>

      </div>

      <!-- PRODUCT -->

      <div class="hero-v5-product">

        <div class="product-heading">

          <span>
            LIVE PRODUCT PREVIEW
          </span>

          <div></div>

          <span>
            AITRANOVA DESKTOP
          </span>

        </div>

        <HeroProductPreview />

      </div>

    </div>

    <!-- TRUST STRIP -->

    <div class="container hero-trust">

      <span
        data-i18n
        data-vi="Thiết kế cho nhiều workflow"
        data-en="Built for multiple workflows"
      >
        Thiết kế cho nhiều workflow
      </span>

      <div></div>

      <b>
        Quick Translate
      </b>

      <i>•</i>

      <b>
        Manga
      </b>

      <i>•</i>

      <b>
        TXT
      </b>

      <i>•</i>

      <b>
        EPUB
      </b>

      <i>•</i>

      <b>
        PDF
      </b>

      <i>•</i>

      <b>
        Learning
      </b>

    </div>

  </section>


  <!-- HOW IT WORKS -->

  <section class="how-section section home-how-production-lock">

    <div class="container">

      <div class="how-heading">

        <div>

          <span class="section-label">

            <span
              data-i18n
              data-vi="Cách hoạt động"
              data-en="How it works"
            >
              Cách hoạt động
            </span>

          </span>

          <h2 class="section-title">

            <span
              data-i18n
              data-vi="Từ màn hình đến bản dịch chỉ trong vài bước."
              data-en="From your screen to a translation in just a few steps."
            >
              Từ màn hình đến bản dịch chỉ
              trong vài bước.
            </span>

          </h2>

        </div>

        <div class="how-intro">

          <p
            data-i18n
            data-vi="Bạn không cần copy chữ, mở trình duyệt hay chuyển sang ứng dụng dịch khác."
            data-en="You don't need to copy text, open a browser or switch to another translation app."
          >
            Bạn không cần copy chữ,
            mở trình duyệt hay chuyển sang
            ứng dụng dịch khác.
          </p>

          <a href="/guide#quick">

            <span
              data-i18n
              data-vi="Xem hướng dẫn Quick Translate"
              data-en="View Quick Translate guide"
            >
              Xem hướng dẫn Quick Translate
            </span>

            <span>→</span>

          </a>

        </div>

      </div>


      <div class="how-workspace">

        <!-- LEFT STEP NAV -->

        <div class="how-steps">

          <article class="how-step active">

            <span class="step-number">
              01
            </span>

            <div>

              <strong
                data-i18n
                data-vi="Nhấn phím tắt"
                data-en="Press the shortcut"
              >
                Nhấn phím tắt
              </strong>

              <p>
                Ctrl + Shift + Q
              </p>

            </div>

            <span class="step-state">
              ✓
            </span>

          </article>


          <article class="how-step">

            <span class="step-number">
              02
            </span>

            <div>

              <strong
                data-i18n
                data-vi="Chọn vùng màn hình"
                data-en="Select a screen area"
              >
                Chọn vùng màn hình
              </strong>

              <p
                data-i18n
                data-vi="Kéo chuột quanh phần chữ cần dịch."
                data-en="Drag around the text you want to translate."
              >
                Kéo chuột quanh phần chữ
                cần dịch.
              </p>

            </div>

          </article>


          <article class="how-step">

            <span class="step-number">
              03
            </span>

            <div>

              <strong>
                OCR + Context
              </strong>

              <p
                data-i18n
                data-vi="AitraNova nhận dạng chữ và lấy context phù hợp."
                data-en="AitraNova recognizes the text and gathers relevant context."
              >
                AitraNova nhận dạng chữ và
                lấy context phù hợp.
              </p>

            </div>

          </article>


          <article class="how-step">

            <span class="step-number">
              04
            </span>

            <div>

              <strong
                data-i18n
                data-vi="Nhận bản dịch"
                data-en="Get the translation"
              >
                Nhận bản dịch
              </strong>

              <p
                data-i18n
                data-vi="Kết quả xuất hiện ngay trên overlay."
                data-en="The result appears directly in an overlay."
              >
                Kết quả xuất hiện ngay
                trên overlay.
              </p>

            </div>

          </article>

        </div>


        <!-- RIGHT PRODUCT DEMO -->

        <div class="workflow-demo">

          <div class="demo-toolbar">

            <div>

              <span class="demo-dot red"></span>
              <span class="demo-dot yellow"></span>
              <span class="demo-dot green"></span>

            </div>

            <strong>
              Quick Translate
            </strong>

            <span>
              AitraNova
            </span>

          </div>


          <div class="demo-screen">

            <!-- FAKE APP -->

            <div class="source-app">

              <div class="source-toolbar">

                <span></span>

                <span></span>

                <span></span>

                <div></div>

              </div>

              <div class="source-content">

                <div class="source-avatar"></div>

                <div class="source-lines">

                  <span></span>
                  <span></span>

                  <strong>
                    また明日ここで会おう。
                  </strong>

                  <span></span>

                </div>

              </div>

            </div>


            <!-- SELECTION -->

            <div class="selection-box">

              <span class="selection-label">
                OCR AREA
              </span>

              <div class="corner top-left"></div>
              <div class="corner top-right"></div>
              <div class="corner bottom-left"></div>
              <div class="corner bottom-right"></div>

            </div>


            <!-- PROCESS -->

            <div class="processing-card">

              <div class="processing-head">

                <span class="processing-icon">
                  ✦
                </span>

                <div>

                  <small>
                    AITRANOVA
                  </small>

                  <strong
                    data-i18n
                    data-vi="Đang phân tích..."
                    data-en="Analyzing..."
                  >
                    Đang phân tích...
                  </strong>

                </div>

              </div>

              <div class="process-row">

                <span>
                  OCR
                </span>

                <div>
                  <i class="full"></i>
                </div>

                <b>
                  ✓
                </b>

              </div>

              <div class="process-row">

                <span>
                  Context
                </span>

                <div>
                  <i class="context-progress"></i>
                </div>

                <b>
                  ✓
                </b>

              </div>

              <div class="process-row">

                <span>
                  AI
                </span>

                <div>
                  <i class="ai-progress"></i>
                </div>

                <b class="processing">
                  •••
                </b>

              </div>

            </div>


            <!-- RESULT -->

            <div class="result-card">

              <div class="result-top">

                <div>

                  <small>
                    JA → VI
                  </small>

                  <strong
                    data-i18n
                    data-vi="Bản dịch"
                    data-en="Translation"
                  >
                    Bản dịch
                  </strong>

                </div>

                <span>
                  ✦ AI
                </span>

              </div>

              <p class="result-source">
                また明日ここで会おう。
              </p>

              <p class="result-target">

                <span
                  data-i18n
                  data-vi="Ngày mai chúng ta gặp lại ở đây nhé."
                  data-en="Let's meet here again tomorrow."
                >
                  Ngày mai chúng ta gặp
                  lại ở đây nhé.
                </span>

              </p>

              <div class="result-meta">

                <span>
                  ✓ Context
                </span>

                <span>
                  Manga Natural
                </span>

              </div>

            </div>


            <!-- SHORTCUT -->

            <div class="demo-shortcut">

              <span
                data-i18n
                data-vi="Bắt đầu bằng"
                data-en="Start with"
              >
                Bắt đầu bằng
              </span>

              <kbd>Ctrl</kbd>
              <i>+</i>
              <kbd>Shift</kbd>
              <i>+</i>
              <kbd>Q</kbd>

            </div>

          </div>

        </div>

      </div>


      <!-- DETAIL STRIP -->

      <div class="how-details">

        <article>

          <span class="detail-icon purple">
            ⌘
          </span>

          <div>

            <strong
              data-i18n
              data-vi="Không cần copy text"
              data-en="No text copying"
            >
              Không cần copy text
            </strong>

            <p
              data-i18n
              data-vi="Dịch trực tiếp từ vùng màn hình."
              data-en="Translate directly from a screen area."
            >
              Dịch trực tiếp từ vùng màn hình.
            </p>

          </div>

        </article>


        <article>

          <span class="detail-icon blue">
            ◎
          </span>

          <div>

            <strong
              data-i18n
              data-vi="OCR tự động"
              data-en="Automatic OCR"
            >
              OCR tự động
            </strong>

            <p
              data-i18n
              data-vi="Nhận dạng chữ từ hình ảnh và ứng dụng."
              data-en="Recognize text from images and applications."
            >
              Nhận dạng chữ từ hình ảnh
              và ứng dụng.
            </p>

          </div>

        </article>


        <article>

          <span class="detail-icon green">
            ↺
          </span>

          <div>

            <strong
              data-i18n
              data-vi="Dùng context"
              data-en="Uses context"
            >
              Dùng context
            </strong>

            <p
              data-i18n
              data-vi="Profile, Memory và câu trước có thể hỗ trợ AI."
              data-en="Profiles, Memory and previous text can assist the AI."
            >
              Profile, Memory và câu trước
              có thể hỗ trợ AI.
            </p>

          </div>

        </article>


        <article>

          <span class="detail-icon orange">
            ◫
          </span>

          <div>

            <strong
              data-i18n
              data-vi="Overlay tức thì"
              data-en="Instant overlay"
            >
              Overlay tức thì
            </strong>

            <p
              data-i18n
              data-vi="Không phải rời nội dung đang đọc."
              data-en="Stay inside what you're currently reading."
            >
              Không phải rời nội dung
              đang đọc.
            </p>

          </div>

        </article>

      </div>

    </div>

  </section>



  <!-- WHY -->

  <section class="section intro home-memory-production-lock">

    <div class="container intro-grid">

      <div>

        <span class="section-label">
          AitraNova
        </span>

        <h2 class="section-title">

          <span
            data-i18n
            data-vi="Không chỉ dịch từng câu."
            data-en="More than translating one sentence."
          >
            Không chỉ dịch từng câu.
          </span>

          <em
            data-i18n
            data-vi="AitraNova hiểu phần trước đó."
            data-en="AitraNova remembers what came before."
          >
            AitraNova hiểu phần trước đó.
          </em>

        </h2>

      </div>

      <div class="intro-text">

        <p
          data-i18n
          data-vi="Các công cụ dịch màn hình thông thường thường xử lý từng câu riêng biệt. Điều này dễ làm sai tên nhân vật, đại từ và thuật ngữ."
          data-en="Typical screen translators often process each sentence independently, which can cause inconsistent names, pronouns and terminology."
        >
          Các công cụ dịch màn hình thông thường
          thường xử lý từng câu riêng biệt.
        </p>

        <p
          data-i18n
          data-vi="AitraNova có thể sử dụng Profile, Glossary, Character Rules, recent context và correction để giữ bản dịch nhất quán hơn."
          data-en="AitraNova can use Profiles, Glossary, Character Rules, recent context and corrections to keep translations more consistent."
        >
          AitraNova có thể sử dụng Profile,
          Glossary, Character Rules và context.
        </p>

        <a href="/guide">

          <span
            data-i18n
            data-vi="Tìm hiểu cách sử dụng"
            data-en="Learn how to use it"
          >
            Tìm hiểu cách sử dụng
          </span>

          →

        </a>

      </div>

    </div>

  </section>


  <!-- COMPACT FEATURE NAV V6.1 -->

  <CompactFeatureNav />

  <HomeSectionSwitcher />



  <!-- MANGA SHOWCASE V6 -->

  

  <MangaShowcase />


  <!-- DOCUMENTS DEEP DIVE V5.3C-2 -->

  <section class="documents-deep section home-documents-production-lock">

    <div class="container">

      <!-- HEADING -->

      <div class="documents-heading">

        <div>

          <span class="section-label">
            Document Reader
          </span>

          <h2 class="section-title">

            <span
              data-i18n
              data-vi="Không chỉ dịch một trang."
              data-en="Don't just translate one page."
            >
              Không chỉ dịch một trang.
            </span>

            <em
              data-i18n
              data-vi="Hãy đọc cả tài liệu."
              data-en="Read the whole document."
            >
              Hãy đọc cả tài liệu.
            </em>

          </h2>

        </div>

        <div class="documents-intro">

          <p
            data-i18n
            data-vi="Document Reader được thiết kế cho nội dung dài. Bạn có thể mở TXT, EPUB hoặc PDF và chọn workflow phù hợp với loại file."
            data-en="Document Reader is designed for longer content. Open TXT, EPUB or PDF files and use the workflow that fits the document."
          >
            Document Reader được thiết kế cho
            nội dung dài. Bạn có thể mở TXT,
            EPUB hoặc PDF và chọn workflow
            phù hợp với loại file.
          </p>

          <a href="/guide#documents">

            <span
              data-i18n
              data-vi="Xem hướng dẫn tài liệu"
              data-en="View document guide"
            >
              Xem hướng dẫn tài liệu
            </span>

            →

          </a>

        </div>

      </div>


      <!-- MAIN PRODUCT -->

      <div class="documents-product">

        <!-- APP PREVIEW -->

        <div class="reader-app">

          <!-- APP HEADER -->

          <div class="reader-header">

            <div class="reader-brand">

              <span>
                A
              </span>

              <div>

                <small>
                  AITRANOVA
                </small>

                <strong>
                  Document Reader
                </strong>

              </div>

            </div>


            <div class="reader-file">

              <span class="file-icon">
                EPUB
              </span>

              <div>

                <small>
                  OPEN DOCUMENT
                </small>

                <strong>
                  novel-volume-01.epub
                </strong>

              </div>

            </div>

          </div>


          <!-- BODY -->

          <div class="reader-layout">

            <!-- NAV -->

            <aside class="reader-sidebar">

              <div class="reader-sidebar-title">

                <small
                  data-i18n
                  data-vi="Mục lục"
                  data-en="Contents"
                >
                  Mục lục
                </small>

              </div>

              <button class="chapter active">

                <span>
                  01
                </span>

                <div>

                  <strong
                    data-i18n
                    data-vi="Chương 1"
                    data-en="Chapter 1"
                  >
                    Chương 1
                  </strong>

                  <small>
                    始まり
                  </small>

                </div>

              </button>

              <button class="chapter">

                <span>
                  02
                </span>

                <div>

                  <strong
                    data-i18n
                    data-vi="Chương 2"
                    data-en="Chapter 2"
                  >
                    Chương 2
                  </strong>

                  <small>
                    出会い
                  </small>

                </div>

              </button>

              <button class="chapter">

                <span>
                  03
