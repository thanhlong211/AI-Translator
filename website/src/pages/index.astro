    gap: 9px;

    margin-bottom: 15px;
  }

  .processing-icon {
    display: grid;

    width: 31px;
    height: 31px;

    place-items: center;

    border-radius: 9px;

    background:
      var(--primary-light);

    color:
      var(--primary);

    font-size: 11px;
