    border-radius: 14px;

    background: white;

    box-shadow:
      0 15px 45px
      rgba(37, 42, 69, 0.08);
  }

  .source-toolbar {
    display: flex;

    align-items: center;

    gap: 5px;

    height: 35px;

    padding:
      0 10px;

    border-bottom:
      1px solid var(--border);

    background:
      #f9fafc;
