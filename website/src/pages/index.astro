        #effbf6
      );
  }

  .memory-layout {
    display: grid;

    grid-template-columns:
      0.85fr 1.15fr;

    gap: 20px;

    height: calc(100% - 25px);

    align-items: center;

    margin-top: 15px;
  }

  .memory-preview {
    display: grid;

    gap: 8px;
  }

  .memory-row {
    display: grid;

    grid-template-columns:
      1fr auto 1fr auto;

    align-items: center;

    gap: 8px;

    padding: 10px;

    border:
      1px solid var(--border);

    border-radius: 10px;

    background:
      rgba(255, 255, 255, 0.84);

    box-shadow:
      var(--shadow-xs);
  }

  .memory-row small {
    display: block;

    color:
      var(--muted-2);

    font-size: 5px;
  }

  .memory-row strong {
    display: block;

    margin-top: 2px;

    font-size: 8px;
  }

  .memory-row > span {
    color:
      var(--green);

    font-size: 8px;
  }

  .memory-row > b {
    padding:
      3px 5px;

    border-radius: 5px;

    background:
      #eafaf3;

    color:
      var(--green);

    font-size: 5px;
  }

  /* LEARNING */

  .feature-learning {
    grid-column:
      span 4;

    grid-row:
      span 2;

    background:
      linear-gradient(
        150deg,
        #ffffff,
        #fff8ed
      );
  }

  .learning-cards {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 7px;

    margin-top: 24px;
  }

  .learning-cards > div {
    display: grid;

    min-height: 82px;

    place-content: center;

    gap: 7px;

    border:
      1px solid
      var(--border);

    border-radius: 11px;

    background:
      rgba(255, 255, 255, 0.8);

    text-align: center;
  }

  .learning-cards span {
    color:
      #df9043;

    font-size: 17px;

    font-weight: 800;
  }

  .learning-cards small {
    color:
      var(--muted);

    font-size: 7px;
  }

  /* BOTTOM */

  .feature-bottom {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    gap: 30px;

    margin-top: 18px;

    padding: 18px 20px;

    border:
      1px solid var(--border);

    border-radius: 15px;

    background:
      rgba(255, 255, 255, 0.84);
  }

  .feature-bottom > div {
    display: flex;

    align-items: center;

    gap: 11px;
  }

  .feature-bottom-icon {
    display: grid;

    width: 37px;
    height: 37px;

    place-items: center;

    border-radius: 11px;

    background:
      var(--primary-light);

    color:
      var(--primary);
  }

  .feature-bottom strong {
    display: block;

    font-size: 11px;
  }

  .feature-bottom p {
    margin:
      2px 0 0;

    color:
      var(--muted);

    font-size: 9px;
  }

  /* RESPONSIVE */

  @media (max-width: 1080px) {
    .feature-v5-heading {
      grid-template-columns:
        1fr;

      gap: 25px;
    }

    .feature-v5-grid {
      grid-template-columns:
        1fr 1fr;

      grid-auto-rows:
        auto;
    }

    .feature-quick,
    .feature-manga,
    .feature-document,
    .feature-profile,
    .feature-memory,
    .feature-learning {
      grid-column: auto;
      grid-row: auto;

      min-height: 390px;
    }

    .feature-quick {
      grid-column:
        1 / -1;
    }

    .feature-memory {
      grid-column:
        1 / -1;
    }
  }

  @media (max-width: 720px) {
    .feature-v5-grid {
      grid-template-columns:
        1fr;
    }

    .feature-quick,
    .feature-manga,
    .feature-document,
    .feature-profile,
    .feature-memory,
    .feature-learning {
      grid-column: auto;

      min-height: auto;
    }

    .feature-quick {
      display: block;

      min-height: 570px;
    }

    .feature-quick
    .feature-copy {
      padding-top: 55px;
    }

    .quick-visual {
      min-height: 290px;

      margin-top: 15px;
    }

    .feature-manga {
      min-height: 560px;
    }

    .feature-document {
      min-height: 520px;
    }

    .feature-memory {
      min-height: 430px;
    }

    .memory-layout {
      grid-template-columns:
        1fr;
    }

    .feature-learning {
      min-height: 390px;
    }

    .feature-bottom {
      align-items: flex-start;

      flex-direction: column;
    }
  }



  /* =========================================================
     V5.3C-2 — DOCUMENTS DEEP DIVE
     ========================================================= */

  .documents-deep {
    background:
      linear-gradient(
        180deg,
        #f0f3f9,
        #f7f8fc
      );
  }

  .documents-heading {
    display: grid;

    grid-template-columns:
      1.15fr 0.85fr;

    align-items: end;

    gap: 80px;

    margin-bottom: 50px;
  }

  .documents-heading
  .section-title em {
    display: block;

    color:
      var(--blue);

    font-style: normal;
  }

  .documents-intro p {
    margin: 0;

    color:
      var(--muted);

    font-size: 14px;

    line-height: 1.75;
  }

  .documents-intro a {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-top: 14px;

    color:
      var(--blue);

    font-size: 12px;

    font-weight: 750;
  }


  /* MAIN PRODUCT */

  .documents-product {
    display: grid;

    grid-template-columns:
      minmax(0, 1.3fr)
      minmax(330px, 0.7fr);

    align-items: stretch;

    gap: 24px;
  }


  /* READER APP */

  .reader-app {
    overflow: hidden;

    border:
      1px solid var(--border);

    border-radius: 22px;

    background: white;

    box-shadow:
      var(--shadow);
  }

  .reader-header {
    display: flex;

    min-height: 57px;

    align-items: center;

    justify-content:
      space-between;

    padding:
      0 17px;

    border-bottom:
      1px solid var(--border);

    background:
      #fafbfe;
  }

  .reader-brand,
  .reader-file {
    display: flex;

    align-items: center;

    gap: 9px;
  }

  .reader-brand > span {
    display: grid;

    width: 29px;
    height: 29px;

    place-items: center;

    border-radius: 8px;

    background:
      linear-gradient(
        135deg,
        var(--primary),
        var(--blue)
      );

    color: white;

    font-size: 9px;

    font-weight: 900;
  }

  .reader-header small {
    display: block;

    color:
      var(--muted-2);

    font-size: 6px;

    letter-spacing:
      0.08em;
  }

  .reader-header strong {
    display: block;

    margin-top: 2px;

    color:
      var(--text);

    font-size: 9px;
  }

  .file-icon {
    display: grid;

    min-width: 38px;
    height: 26px;

    place-items: center;

    padding: 0 6px;

    border-radius: 7px;

    background:
      #edf5ff;

    color:
      var(--blue);

    font-size: 6px;

    font-weight: 850;
  }


  /* READER LAYOUT */

  .reader-layout {
    display: grid;

    min-height: 480px;

    grid-template-columns:
      145px minmax(0, 1fr) 290px;
  }


  /* SIDEBAR */

  .reader-sidebar {
    display: flex;

    flex-direction: column;

    gap: 6px;

    padding: 14px 10px;

    border-right:
      1px solid var(--border);

    background:
      #f8f9fc;
  }

  .reader-sidebar-title {
    padding:
      4px 7px 8px;

    color:
      var(--muted-2);

    font-size: 7px;

    font-weight: 800;

    letter-spacing:
      0.08em;

    text-transform: uppercase;
  }

  .chapter {
    display: grid;

    grid-template-columns:
      auto 1fr;

    gap: 8px;

    width: 100%;

    padding:
      9px 8px;

    border: 0;

    border-radius: 9px;

    background: transparent;

    color:
      var(--text-2);

    text-align: left;
  }

  .chapter > span {
    display: grid;

    width: 24px;
    height: 24px;

    place-items: center;

    border-radius: 7px;

    background:
      #eceef3;

    color:
      var(--muted);

    font-size: 6px;

    font-weight: 850;
  }

  .chapter strong {
    display: block;

    font-size: 7px;
  }

  .chapter small {
    display: block;

    margin-top: 1px;

    color:
      var(--muted-2);

    font-size: 6px;
  }

  .chapter.active {
    background:
      #edf5ff;
  }

  .chapter.active > span {
    background:
      var(--blue);

    color: white;
  }

  .chapter.active strong {
    color:
      var(--blue);
  }

  .reader-sidebar-space {
    flex: 1;
  }

  .document-progress {
    padding: 10px 8px;
  }

  .document-progress small {
    color:
      var(--muted-2);

    font-size: 6px;
  }

  .document-progress strong {
    display: block;

    margin:
      3px 0 6px;

    font-size: 8px;
  }

  .document-progress > div {
    height: 4px;

    overflow: hidden;

    border-radius: 999px;

    background:
      #e4e7ee;
  }

  .document-progress span {
    display: block;

    width: 24%;
    height: 100%;

    border-radius: inherit;

    background:
      var(--blue);
  }


  /* DOCUMENT */

  .reader-document {
    display: grid;

    grid-template-rows:
      auto 1fr;

    border-right:
      1px solid var(--border);

    background:
      #f1f3f7;
  }

  .document-toolbar {
    display: flex;

    min-height: 42px;

    align-items: center;

    justify-content:
      space-between;

    padding:
      0 13px;

    border-bottom:
      1px solid var(--border);

    background:
      white;
  }

  .document-toolbar > div:first-child {
    display: flex;

    gap: 4px;
  }

  .tool {
    display: grid;

    width: 26px;
    height: 26px;

    place-items: center;

    border-radius: 7px;

    color:
      var(--muted);

    font-size: 8px;
  }

  .tool.active {
    background:
      #edf5ff;

    color:
      var(--blue);
  }

  .reader-language {
    display: flex;

    align-items: center;

    gap: 5px;

    color:
      var(--muted-2);

    font-size: 6px;
  }

  .reader-language span {
    padding:
      4px 5px;

    border-radius: 5px;

    background:
      #f3f4f7;

    color:
      var(--text-2);

    font-weight: 750;
  }


  /* PAGE */

  .reader-page {
    position: relative;

    width:
      min(
        calc(100% - 44px),
        410px
      );

    min-height: 390px;

    margin:
      22px auto;

    padding:
      30px 32px;

    border:
      1px solid var(--border);

    border-radius: 4px;

    background: white;

    box-shadow:
      0 12px 35px
      rgba(36, 41, 68, 0.08);
  }

  .reader-page-meta {
    display: flex;

    justify-content:
      space-between;

    color:
      var(--muted-2);

    font-size: 5px;

    letter-spacing:
      0.08em;
  }

  .reader-page h3 {
    margin:
      28px 0 24px;

    font-size: 18px;

    font-weight: 700;

    text-align: center;
  }

  .japanese-line {
    margin:
      0 0 15px;

    color:
      var(--text-2);

    font-family:
      "Yu Mincho",
      "Hiragino Mincho ProN",
      serif;

    font-size: 9px;

    line-height: 1.9;
  }

  .japanese-line.faded {
    color:
      var(--muted-2);
  }

  .selected-paragraph {
    position: relative;

    margin:
      19px -10px;

    padding:
      15px 10px;

    border:
      1px solid
      rgba(77, 141, 255, 0.25);

    border-radius: 8px;

    background:
      rgba(77, 141, 255, 0.055);
  }

  .selected-paragraph p {
    margin: 0;

    color:
      var(--text);

    font-family:
      "Yu Mincho",
      "Hiragino Mincho ProN",
      serif;

    font-size: 10px;

    line-height: 1.8;
  }

  .selection-marker {
    position: absolute;

    top: -9px;
    right: 8px;

    padding:
      3px 5px;

    border-radius: 4px;

    background:
      var(--blue);

    color: white;

    font-family:
      Inter,
      sans-serif;

    font-size: 5px;

    font-weight: 850;
  }


  /* TRANSLATION PANEL */

  .reader-translation {
    display: grid;

    align-content: start;

    gap: 10px;

    padding: 16px;

    background: white;
  }

  .reader-translation-head {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    margin-bottom: 3px;
  }

  .reader-translation-head small {
    display: block;

    color:
      var(--muted-2);

    font-size: 6px;

    letter-spacing:
      0.08em;
  }

  .reader-translation-head strong {
    display: block;

    margin-top: 2px;

    font-size: 9px;
  }

  .reader-translation-head > span {
    padding:
      4px 6px;

    border-radius: 6px;

    background:
      var(--primary-light);

    color:
      var(--primary);

    font-size: 7px;

    font-weight: 850;
  }

  .translation-source-document,
  .translation-result-document {
    padding: 12px;

    border:
      1px solid var(--border);

    border-radius: 10px;

    background:
      #fafbfe;
  }

  .translation-source-document small,
  .translation-result-document small {
    display: block;

    margin-bottom: 5px;

    color:
      var(--muted-2);

    font-size: 5px;

    letter-spacing:
      0.08em;
  }

  .translation-source-document p {
    margin: 0;

    color:
      var(--muted);

    font-size: 8px;
  }

  .translation-result-document {
    background:
      linear-gradient(
        135deg,
        #f6f5ff,
        #f4f8ff
      );
  }

  .translation-result-document p {
    margin: 0;

    color:
      var(--text);

    font-size: 11px;

    font-weight: 650;

    line-height: 1.55;
  }


  /* CONTEXT */

  .document-context {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    padding: 11px;

    border:
      1px solid var(--border);

    border-radius: 10px;

    background:
      #f8f9fc;
  }

  .document-context > div {
    display: flex;

    align-items: center;

    gap: 8px;
  }

  .document-context
  > div > span {
    display: grid;

    width: 28px;
    height: 28px;

    place-items: center;

    border-radius: 8px;

    background: white;

    color:
      var(--blue);

    box-shadow:
      var(--shadow-xs);
  }

  .document-context small {
    display: block;

    color:
      var(--muted-2);

    font-size: 5px;
  }

  .document-context strong {
    display: block;

    max-width: 155px;

    margin-top: 2px;

    font-size: 7px;

    line-height: 1.4;
  }

  .document-context > b {
    color:
      var(--green);

    font-size: 6px;
  }

  .reader-actions {
    display: grid;

    grid-template-columns:
      1fr 1fr;

    gap: 7px;
  }

  .reader-actions button {
    display: flex;

    min-height: 33px;

    align-items: center;
    justify-content: center;

    gap: 5px;

    border:
      1px solid var(--border);

    border-radius: 8px;

    background:
      #fafbfe;

    color:
      var(--muted);

    font-size: 7px;
  }


  /* EXPLAINER */

  .documents-explainer {
    padding: 29px;

    border:
      1px solid var(--border);

    border-radius: 22px;

    background:
      linear-gradient(
        145deg,
        #ffffff,
        #f1f6ff
      );

    box-shadow:
      var(--shadow-xs);
  }

  .documents-explainer > h3 {
    margin:
      20px 0 12px;

    color:
      var(--text);

    font-size:
      clamp(
        27px,
        3vw,
        39px
      );

    line-height: 1.05;

    letter-spacing:
      -0.045em;
  }

  .documents-explainer > p {
    margin: 0;

    color:
      var(--muted);

    font-size: 12px;

    line-height: 1.7;
  }

  .document-mode-list {
    display: grid;

    gap: 8px;

    margin-top: 25px;
  }

  .document-mode-list article {
    display: grid;

    grid-template-columns:
      auto 1fr;

    align-items: start;

    gap: 10px;

    padding: 11px;

    border:
      1px solid var(--border);

    border-radius: 11px;

    background:
      rgba(255, 255, 255, 0.82);
  }

  .mode-icon {
    display: grid;

    min-width: 39px;
    height: 33px;

    place-items: center;

    padding: 0 5px;

    border-radius: 8px;

    font-size: 6px;

    font-weight: 850;
  }

  .mode-icon.txt {
    background:
      var(--primary-light);

    color:
      var(--primary);
  }

  .mode-icon.epub {
    background:
      #fff5e8;

    color:
      #df9043;
  }

  .mode-icon.pdf {
    background:
      #edf5ff;

    color:
      var(--blue);
  }

  .mode-icon.ocr {
    background:
      #eafaf3;

    color:
      var(--green);
  }

  .mode-title {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    gap: 8px;
  }

  .mode-title strong {
    font-size: 9px;
  }

  .mode-title b {
    padding:
      3px 5px;

    border-radius: 5px;

    background:
      #f0f1f5;

    color:
      var(--muted);

    font-size: 5px;
  }

  .document-mode-list p {
    margin:
      4px 0 0;

    color:
      var(--muted);

    font-size: 7px;

    line-height: 1.5;
  }


  /* DECISION */

  .document-decision {
    display: grid;

    grid-template-columns:
      0.72fr 1.28fr;

    align-items: center;

    gap: 60px;

    margin-top: 75px;

    padding: 46px;

    border:
      1px solid var(--border);

    border-radius:
      var(--radius-lg);

    background: white;

    box-shadow:
      var(--shadow-sm);
  }

  .decision-heading h3 {
    margin:
      15px 0 0;

    font-size:
      clamp(
        30px,
        4vw,
        44px
      );

    line-height: 1.03;

    letter-spacing:
      -0.048em;
  }

  .decision-flow {
    display: grid;

    grid-template-columns:
      140px auto 1fr;

    align-items: center;

    gap: 17px;
  }

  .decision-start {
    padding: 17px;

    border:
      1px solid
      rgba(99, 91, 255, 0.18);

    border-radius: 13px;

    background:
      var(--primary-light);
  }

  .decision-start > span {
    display: block;

    color:
      var(--primary);

    font-size: 6px;

    font-weight: 850;
  }

  .decision-start strong {
    display: block;

    margin-top: 6px;

    color:
      var(--text);

    font-size: 10px;

    line-height: 1.4;
  }

  .decision-arrow {
    color:
      var(--muted-2);

    font-size: 16px;
  }

  .decision-options {
    display: grid;

    grid-template-columns:
      1fr 1fr;

    gap: 7px;
  }

  .decision-options article {
    display: flex;

    align-items: center;

    gap: 9px;

    padding: 10px;

    border:
      1px solid var(--border);

    border-radius: 10px;

    background:
      #fafbfe;
  }

  .decision-options
  article > span {
    display: grid;

    min-width: 34px;
    height: 29px;

    place-items: center;

    padding: 0 4px;

    border-radius: 7px;

    background: white;

    color:
      var(--blue);

    box-shadow:
      var(--shadow-xs);

    font-size: 6px;

    font-weight: 850;
  }

  .decision-options strong {
    display: block;

    font-size: 8px;
  }

  .decision-options small {
    display: block;

    margin-top: 1px;

    color:
      var(--muted-2);

    font-size: 6px;
  }


  /* BENEFITS */

  .document-benefits {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 13px;

    margin-top: 20px;
  }

  .document-benefits article {
    display: flex;

    align-items: center;

    gap: 12px;

    padding: 18px;

    border:
      1px solid var(--border);

    border-radius: 14px;

    background:
      rgba(255, 255, 255, 0.85);
  }

  .document-benefit-icon {
    display: grid;

    width: 38px;
    height: 38px;

    flex: 0 0 auto;

    place-items: center;

    border-radius: 11px;

    font-size: 12px;

    font-weight: 850;
  }

  .document-benefit-icon.purple {
    background:
      var(--primary-light);

    color:
      var(--primary);
  }

  .document-benefit-icon.blue {
    background:
      #edf5ff;

    color:
      var(--blue);
  }

  .document-benefit-icon.green {
    background:
      #eafaf3;

    color:
      var(--green);
  }

  .document-benefits strong {
    display: block;

    font-size: 10px;
  }

  .document-benefits p {
    margin:
      3px 0 0;

    color:
      var(--muted);

    font-size: 8px;

    line-height: 1.5;
  }


  /* RESPONSIVE */

  @media (max-width: 1100px) {
    .documents-heading {
      grid-template-columns:
        1fr;

      gap: 25px;
    }

    .documents-product {
      grid-template-columns:
        1fr;
    }

    .documents-explainer {
      display: grid;

      grid-template-columns:
        0.75fr 1.25fr;

      gap: 30px;
    }

    .document-mode-list {
      margin-top: 0;
    }

    .document-decision {
      grid-template-columns:
        1fr;

      gap: 30px;
    }
  }

  @media (max-width: 850px) {
    .reader-layout {
      grid-template-columns:
        120px 1fr;
    }

    .reader-translation {
      display: none;
    }

    .reader-document {
      border-right: 0;
    }

    .documents-explainer {
      grid-template-columns:
        1fr;
    }

    .decision-flow {
      grid-template-columns:
        1fr;
    }

    .decision-arrow {
      transform:
        rotate(90deg);

      justify-self: center;
    }

    .document-benefits {
      grid-template-columns:
        1fr;
    }
  }

  @media (max-width: 600px) {
    .reader-header {
      align-items: flex-start;

      flex-direction: column;

      gap: 10px;

      padding:
        12px 14px;
    }

    .reader-layout {
      grid-template-columns:
        1fr;
    }

    .reader-sidebar {
      display: none;
    }

    .reader-page {
      width:
        calc(100% - 24px);

      padding:
        25px 20px;
    }

    .document-decision {
      padding:
        30px 22px;
    }

    .decision-options {
      grid-template-columns:
        1fr;
    }
  }



  /* =========================================================
     V5.3C-3 — TRANSLATION PROFILE
     ========================================================= */

  .profile-deep {
    background: #ffffff;
  }

  .profile-deep-heading {
    display: grid;

    grid-template-columns:
      1.15fr 0.85fr;

    align-items: end;

    gap: 80px;

    margin-bottom: 50px;
  }

  .profile-deep-heading
  .section-title em {
    display: block;

    color: var(--primary);

    font-style: normal;
  }

  .profile-deep-intro p {
    margin: 0;

    color: var(--muted);

    font-size: 14px;

    line-height: 1.75;
  }

  .profile-deep-intro a {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-top: 14px;

    color: var(--primary);

    font-size: 12px;

    font-weight: 750;
  }


  /* EDITOR */

  .profile-editor-shell {
    display: grid;

    grid-template-columns:
      250px minmax(0, 1fr);

    min-height: 600px;

    overflow: hidden;

    border:
      1px solid var(--border);

    border-radius: 24px;

    background: white;

    box-shadow: var(--shadow);
  }

  .profile-list-panel {
    display: flex;

    flex-direction: column;

    padding: 16px;

    border-right:
      1px solid var(--border);

    background:
      #f8f9fc;
  }

  .profile-list-head {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    margin-bottom: 18px;
  }

  .profile-list-head small {
    display: block;

    color: var(--muted-2);

    font-size: 6px;

    letter-spacing: 0.1em;
  }

  .profile-list-head strong {
    display: block;

    margin-top: 2px;

    font-size: 10px;
  }

  .profile-list-head button {
    display: grid;

    width: 29px;
    height: 29px;

    place-items: center;

    border: 0;

    border-radius: 8px;

    background: var(--primary);

    color: white;
  }

  .profile-list {
    display: grid;

    gap: 7px;
  }

  .profile-item {
    display: grid;

    grid-template-columns:
      auto 1fr auto;

    align-items: center;

    gap: 9px;

    width: 100%;

    padding: 10px;

    border:
      1px solid transparent;

    border-radius: 11px;

    background: transparent;

    text-align: left;
  }

  .profile-item.active {
    border-color:
      rgba(99, 91, 255, 0.15);

    background:
      var(--primary-light);
  }

  .profile-avatar {
    display: grid;

    width: 34px;
    height: 34px;

    place-items: center;

    border-radius: 10px;

    font-size: 9px;

    font-weight: 850;
  }

  .profile-avatar.violet {
    background: white;

    color: var(--primary);
  }

  .profile-avatar.blue {
    background: #edf5ff;

    color: var(--blue);
  }

  .profile-avatar.green {
    background: #eafaf3;

    color: var(--green);

    font-size: 6px;
  }

  .profile-item strong {
    display: block;

    font-size: 8px;
  }

  .profile-item small {
    display: block;

    margin-top: 2px;

    color: var(--muted-2);

    font-size: 6px;
  }

  .profile-item > i {
    color: var(--primary);

    font-size: 8px;

    font-style: normal;
  }

  .profile-list-note {
    display: flex;

    gap: 8px;

    margin-top: auto;

    padding: 11px;

    border-radius: 10px;

    background: white;
  }

  .profile-list-note > span {
    color: var(--primary);
  }

  .profile-list-note p {
    margin: 0;

    color: var(--muted);

    font-size: 7px;

    line-height: 1.5;
  }


  /* EDITOR MAIN */

  .profile-editor {
    min-width: 0;

    padding: 20px;
  }

  .profile-editor-header {
    display: flex;

    align-items: center;

    justify-content: space-between;

    padding-bottom: 18px;

    border-bottom:
      1px solid var(--border);
  }

  .profile-editor-header > div {
    display: flex;

    align-items: center;

    gap: 9px;
  }

  .profile-editor-icon {
    display: grid;

    width: 39px;
    height: 39px;

    place-items: center;

    border-radius: 11px;

    background: var(--primary-light);

    color: var(--primary);

    font-weight: 850;
  }

  .profile-editor-header small {
    display: block;

    color: var(--muted-2);

    font-size: 6px;

    letter-spacing: 0.09em;
  }

  .profile-editor-header strong {
    display: block;

    margin-top: 2px;

    font-size: 12px;
  }

  .profile-saved {
    color: var(--green);

    font-size: 7px;

    font-weight: 750;
  }

  .profile-editor-actions button {
    display: grid;

    width: 29px;
    height: 29px;

    place-items: center;

    border:
      1px solid var(--border);

    border-radius: 8px;

    background: #fafbfe;
  }


  /* SETTINGS */

  .profile-settings-grid {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 10px;

    margin-top: 18px;
  }

  .profile-setting label {
    display: block;

    margin-bottom: 6px;

    color: var(--muted);

    font-size: 7px;

    font-weight: 700;
  }

  .fake-select {
    display: grid;

    grid-template-columns:
      auto 1fr auto;

    align-items: center;

    gap: 7px;

    min-height: 40px;

    padding: 0 10px;

    border:
      1px solid var(--border);

    border-radius: 9px;

    background: #fafbfe;
  }

  .fake-select span {
    font-size: 10px;
  }

  .fake-select strong {
    font-size: 8px;
  }

  .fake-select i {
    color: var(--muted-2);

    font-size: 8px;

    font-style: normal;
  }


  /* TABS */

  .profile-tabs {
    display: flex;

    gap: 4px;

    margin-top: 20px;

    border-bottom:
      1px solid var(--border);
  }

  .profile-tabs button {
    padding:
      9px 11px;

    border: 0;

    border-bottom:
      2px solid transparent;

    background: transparent;

    color: var(--muted);

    font-size: 7px;

    font-weight: 700;
  }

  .profile-tabs button.active {
    border-bottom-color:
      var(--primary);

    color: var(--primary);
  }


  /* GLOSSARY */

  .profile-workspace {
    margin-top: 17px;

    padding: 16px;

    border:
      1px solid var(--border);

    border-radius: 13px;

    background: #fafbfe;
  }

  .profile-workspace-head {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    margin-bottom: 13px;
  }

  .profile-workspace-head small {
    display: block;

    color: var(--muted-2);

    font-size: 6px;

    letter-spacing: 0.09em;
  }

  .profile-workspace-head strong {
    display: block;

    margin-top: 2px;

    font-size: 10px;
  }

  .profile-workspace-head button {
    display: flex;

    align-items: center;

    gap: 5px;

    padding:
      6px 8px;

    border: 0;

    border-radius: 7px;

    background: var(--primary);

    color: white;

    font-size: 6px;
  }

  .glossary-table {
    overflow: hidden;

    border:
      1px solid var(--border);

    border-radius: 10px;

    background: white;
  }

  .glossary-header,
  .glossary-row {
    display: grid;

    grid-template-columns:
      1fr 1fr 90px;

    align-items: center;

    gap: 10px;

    padding:
      10px 12px;
  }

  .glossary-header {
    border-bottom:
      1px solid var(--border);

    background: #f6f7fa;

    color: var(--muted-2);

    font-size: 5px;

    font-weight: 850;

    letter-spacing: 0.08em;
  }

  .glossary-row {
    border-bottom:
      1px solid var(--border);
  }

  .glossary-row:last-child {
    border-bottom: 0;
  }

  .glossary-row strong {
    display: block;

    font-size: 9px;
  }

  .glossary-row small {
    display: block;

    margin-top: 1px;

    color: var(--muted-2);

    font-size: 6px;
  }

  .rule-badge {
    width: fit-content;

    padding:
      4px 5px;

    border-radius: 5px;

    font-size: 5px;

    font-weight: 850;
  }

  .rule-badge.mandatory {
    background: var(--primary-light);

    color: var(--primary);
  }

  .rule-badge.preferred {
    background: #edf5ff;

    color: var(--blue);
  }

  .glossary-help {
    display: flex;

    align-items: center;

    gap: 8px;

    margin-top: 11px;

    padding: 9px;

    border-radius: 8px;

    background: #edf5ff;
  }

  .glossary-help > span {
    display: grid;

    width: 20px;
    height: 20px;

    flex: 0 0 auto;

    place-items: center;

    border-radius: 50%;

    background: white;

    color: var(--blue);

    font-size: 7px;

    font-weight: 850;
  }

  .glossary-help p {
    margin: 0;

    color: var(--muted);

    font-size: 6px;
  }


  /* SYSTEM CARDS */

  .profile-systems {
    display: grid;

    grid-template-columns:
      repeat(
        4,
        minmax(0, 1fr)
      );

    gap: 13px;

    margin-top: 24px;
  }

  .profile-system-card {
    min-height: 320px;

    padding: 21px;

    border:
      1px solid var(--border);

    border-radius: 17px;

    background: white;

    box-shadow: var(--shadow-xs);
  }

  .glossary-system {
    background:
      linear-gradient(
        145deg,
        #ffffff,
        #f7f5ff
      );
  }

  .character-system {
    background:
      linear-gradient(
        145deg,
        #ffffff,
        #fff5fa
      );
  }

  .honorific-system {
    background:
      linear-gradient(
        145deg,
        #ffffff,
        #f2f7ff
      );
  }

  .context-system {
    background:
      linear-gradient(
        145deg,
        #ffffff,
        #f1fbf6
      );
  }

  .system-top {
    display: flex;

    align-items: center;

    justify-content:
      space-between;
  }

  .system-icon {
    display: grid;

    width: 39px;
    height: 39px;

    place-items: center;

    border-radius: 11px;

    font-size: 13px;

    font-weight: 850;
  }

  .system-icon.purple {
    background: var(--primary-light);

    color: var(--primary);
  }

  .system-icon.pink {
    background: #fff0f6;

    color: #da629c;
  }

  .system-icon.blue {
    background: #edf5ff;

    color: var(--blue);
  }

  .system-icon.green {
    background: #eafaf3;

    color: var(--green);
  }

  .system-number {
    color: var(--muted-2);

    font-size: 7px;

    font-weight: 850;
  }

  .profile-system-card > h3 {
    margin:
      18px 0 8px;

    font-size: 18px;

    letter-spacing: -0.03em;
  }

  .profile-system-card > p {
    min-height: 58px;

    margin: 0;

    color: var(--muted);

    font-size: 9px;

    line-height: 1.6;
  }

  .system-example {
    margin-top: 18px;

    padding: 12px;

    border:
      1px solid var(--border);

    border-radius: 10px;

    background:
      rgba(255, 255, 255, 0.85);
  }

  .system-example small {
    color: var(--muted-2);

    font-size: 5px;
  }

  .system-example > div {
    display: flex;

    align-items: center;

    gap: 9px;

    margin-top: 7px;
  }

  .system-example span,
  .system-example strong {
    font-size: 10px;
  }

  .system-example b {
    color: var(--primary);
  }

  .system-when {
    display: grid;

    gap: 2px;

    margin-top: 14px;
  }

  .system-when strong {
    color: var(--muted-2);

    font-size: 6px;
  }

  .system-when span {
    color: var(--text-2);

    font-size: 7px;
  }


  /* CHARACTER EXAMPLE */

  .character-rule-example {
    display: flex;

    align-items: center;

    gap: 10px;

    margin-top: 18px;

    padding: 11px;

    border:
      1px solid var(--border);

    border-radius: 10px;

    background: white;
  }

  .character-rule-avatar {
    display: grid;

    width: 35px;
    height: 35px;

    place-items: center;

    border-radius: 50%;

    background: #fff0f6;

    color: #da629c;

    font-weight: 850;
  }

  .character-rule-example small {
    display: block;

    color: var(--muted-2);

    font-size: 5px;
  }

  .character-rule-example strong {
    display: block;

    margin-top: 2px;

    font-size: 8px;
  }

  .character-rule-example span {
    display: block;

    margin-top: 2px;

    color: var(--muted);

    font-size: 6px;
  }


  /* HONORIFICS */

  .honorific-example {
    display: flex;

    flex-wrap: wrap;

    gap: 5px;

    margin-top: 18px;
  }

  .honorific-chip {
    padding:
      5px 7px;

    border:
      1px solid #dce7f8;

    border-radius: 999px;

    background: white;

    color: var(--blue);

    font-size: 6px;

    font-weight: 750;
  }

  .honorific-setting {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    margin-top: 18px;

    padding: 10px;

    border:
      1px solid var(--border);

    border-radius: 9px;

    background: white;

    font-size: 7px;
  }

  .toggle-on {
    position: relative;

    width: 30px;
    height: 17px;

    border-radius: 999px;

    background: var(--blue);
  }

  .toggle-on i {
    position: absolute;

    top: 3px;
    right: 3px;

    width: 11px;
    height: 11px;

    border-radius: 50%;

    background: white;
  }


  /* CONTEXT EXAMPLE */

  .context-example {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        1fr
      );

    gap: 5px;

    margin-top: 18px;
  }

  .context-example > div {
    padding: 9px 6px;

    border:
      1px solid var(--border);

    border-radius: 9px;

    background: white;

    text-align: center;
  }

  .context-example small {
    display: block;

    color: var(--muted-2);

    font-size: 5px;
  }

  .context-example span {
    display: block;

    margin-top: 3px;

    font-size: 7px;

    font-weight: 750;
  }

  .context-example
  .context-current {
    border-color:
      rgba(36, 180, 126, 0.2);

    background: #eafaf3;

    color: var(--green);
  }


  /* PRIORITY */

  .translation-priority {
    display: grid;

    grid-template-columns:
      0.8fr 1.2fr;

    align-items: center;

    gap: 70px;

    margin-top: 80px;

    padding: 52px;

    border-radius:
      var(--radius-lg);

    background:
      linear-gradient(
        135deg,
        #f1efff,
        #eef6ff
      );
  }

  .priority-copy h3 {
    margin:
      16px 0 13px;

    font-size:
      clamp(
        31px,
        4vw,
        46px
      );

    line-height: 1.04;

    letter-spacing: -0.05em;
  }

  .priority-copy p {
    margin: 0;

    color: var(--muted);

    font-size: 12px;

    line-height: 1.7;
  }

  .priority-visual {
    display: grid;

    gap: 7px;
  }

  .priority-level {
    display: grid;

    grid-template-columns:
      auto 1fr auto;

    align-items: center;

    gap: 10px;

    padding: 11px;

    border:
      1px solid var(--border);

    border-radius: 10px;

    background:
      rgba(255, 255, 255, 0.88);
  }

  .priority-level > span {
    display: grid;

    width: 28px;
    height: 28px;

    place-items: center;

    border-radius: 8px;

    background: #f0f1f5;

    color: var(--muted);

    font-size: 7px;

    font-weight: 850;
  }

  .priority-level small {
    display: block;

    color: var(--muted-2);

    font-size: 5px;
  }

  .priority-level strong {
    display: block;

    margin-top: 1px;

    font-size: 8px;
  }

  .priority-level > b {
    padding:
      4px 5px;

    border-radius: 5px;

    background: #f0f1f5;

    color: var(--muted);

    font-size: 5px;
  }

  .level-one > span {
    background: var(--primary);

    color: white;
  }

  .level-one > b {
    background: var(--primary-light);

    color: var(--primary);
  }

  .level-two > b,
  .level-three > b {
    background: #edf5ff;

    color: var(--blue);
  }


  /* PROFILE FLOW */

  .profile-setup-flow {
    margin-top: 24px;

    padding: 35px;

    border:
      1px solid var(--border);

    border-radius:
      var(--radius-lg);

    background: #fafbfe;
  }

  .profile-flow-heading {
    margin-bottom: 27px;
  }

  .profile-flow-heading h3 {
    margin:
      13px 0 0;

    font-size:
      clamp(
        28px,
        3vw,
        38px
      );

    letter-spacing: -0.04em;
  }

  .profile-flow-steps {
    display: grid;

    grid-template-columns:
      1fr auto
      1fr auto
      1fr auto
      1fr auto
      1fr;

    align-items: stretch;

    gap: 8px;
  }

  .profile-flow-steps article {
    padding: 14px;

    border:
      1px solid var(--border);

    border-radius: 11px;

    background: white;
  }

  .profile-flow-steps
  article > span {
    color: var(--primary);

    font-size: 7px;

    font-weight: 850;
  }

  .profile-flow-steps strong {
    display: block;

    margin-top: 13px;

    font-size: 9px;
  }

  .profile-flow-steps p {
    margin:
      4px 0 0;

    color: var(--muted);

    font-size: 7px;

    line-height: 1.5;
  }

  .profile-flow-steps > i {
    align-self: center;

    color: var(--muted-2);

    font-style: normal;
  }


  /* RESPONSIVE */

  @media (max-width: 1080px) {
    .profile-deep-heading {
      grid-template-columns:
        1fr;

      gap: 25px;
    }

    .profile-systems {
      grid-template-columns:
        1fr 1fr;
    }

    .translation-priority {
      grid-template-columns:
        1fr;

      gap: 35px;
    }

    .profile-flow-steps {
      grid-template-columns:
        repeat(
          5,
          1fr
        );
    }

    .profile-flow-steps > i {
      display: none;
    }
  }

  @media (max-width: 850px) {
    .profile-editor-shell {
      grid-template-columns:
        1fr;
    }

    .profile-list-panel {
      display: none;
    }

    .profile-settings-grid {
      grid-template-columns:
        1fr;
    }

    .profile-tabs {
      overflow-x: auto;
    }

    .translation-priority {
      padding: 32px;
    }
  }

  @media (max-width: 700px) {
    .profile-systems {
      grid-template-columns:
        1fr;
    }

    .glossary-header,
    .glossary-row {
      grid-template-columns:
        1fr 1fr;
    }

    .glossary-header
    > span:last-child,
    .glossary-row
    > span:last-child {
      display: none;
    }

    .profile-flow-steps {
      grid-template-columns:
        1fr;
    }
  }

  @media (max-width: 520px) {
    .profile-editor {
      padding: 13px;
    }

    .profile-editor-header {
      align-items: flex-start;

      flex-direction: column;

      gap: 10px;
    }

    .translation-priority {
      padding: 26px 20px;
    }

    .profile-setup-flow {
      padding: 25px 18px;
    }
  }



  /* =========================================================
     V5.3D-1 — LEARNING
     ========================================================= */

  .learning-deep {
    background:
      linear-gradient(
        180deg,
        #f8f8fc,
        #f2f4f9
      );
  }

  .learning-heading {
    display: grid;

    grid-template-columns:
      1.15fr 0.85fr;

    align-items: end;

    gap: 80px;

    margin-bottom: 50px;
  }

  .learning-heading
  .section-title em {
    display: block;

    color: var(--primary);

    font-style: normal;
  }

  .learning-intro p {
    margin: 0;

    color: var(--muted);

    font-size: 14px;

    line-height: 1.75;
  }

  .learning-intro a {
    display: inline-flex;

    gap: 8px;

    margin-top: 14px;

    color: var(--primary);

    font-size: 12px;

    font-weight: 750;
  }


  /* PRODUCT */

  .learning-product {
    display: grid;

    grid-template-columns:
      minmax(0, 1.3fr)
      minmax(330px, 0.7fr);

    gap: 24px;
  }

  .learning-app {
    overflow: hidden;

    border:
      1px solid var(--border);

    border-radius: 22px;

    background: white;

    box-shadow: var(--shadow);
  }

  .learning-app-header {
    display: flex;

    min-height: 58px;

    align-items: center;

    justify-content:
      space-between;

    padding:
      0 17px;

    border-bottom:
      1px solid var(--border);

    background: #fafbfe;
  }

  .learning-app-header > div:first-child {
    display: flex;

    align-items: center;

    gap: 9px;
  }

  .learning-logo {
    display: grid;

    width: 30px;
    height: 30px;

    place-items: center;

    border-radius: 9px;

    background:
      linear-gradient(
        135deg,
        var(--primary),
        var(--blue)
      );

    color: white;

    font-size: 9px;

    font-weight: 900;
  }

  .learning-app-header small {
    display: block;

    color: var(--muted-2);

    font-size: 6px;
  }

  .learning-app-header strong {
    display: block;

    margin-top: 2px;

    font-size: 9px;
  }

  .learning-nav {
    display: flex;

    gap: 3px;
  }

  .learning-nav button {
    padding:
      7px 9px;

    border: 0;

    border-radius: 7px;

    background: transparent;

    color: var(--muted);

    font-size: 6px;

    font-weight: 700;
  }

  .learning-nav button.active {
    background:
      var(--primary-light);

    color: var(--primary);
  }


  /* DASHBOARD */

  .learning-dashboard {
    padding: 20px;
  }

  .learning-dashboard-head {
    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 18px;
  }

  .learning-dashboard-head small {
    color: var(--muted-2);

    font-size: 6px;

    letter-spacing: 0.08em;
  }

  .learning-dashboard-head h3 {
    margin:
      3px 0 0;

    font-size: 20px;

    letter-spacing: -0.035em;
  }

  .learning-streak {
    display: flex;

    align-items: center;

    gap: 7px;

    padding:
      8px 10px;

    border:
      1px solid var(--border);

    border-radius: 10px;

    background: #fff9f0;
  }

  .learning-streak > span {
    font-size: 15px;
  }

  .learning-streak small {
    display: block;

    color: #c88c40;

    font-size: 5px;
  }

  .learning-streak strong {
    display: block;

    font-size: 8px;
  }


  /* STATS */

  .learning-stats {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 9px;
  }

  .learning-stats article {
    display: flex;

    align-items: center;

    gap: 10px;

    padding: 12px;

    border:
      1px solid var(--border);

    border-radius: 11px;

    background: #fafbfe;
  }

  .learning-stat-icon {
    display: grid;

    width: 36px;
    height: 36px;

    flex: 0 0 auto;

    place-items: center;

    border-radius: 10px;

    font-size: 12px;

    font-weight: 850;
  }

  .learning-stat-icon.purple {
    background: var(--primary-light);

    color: var(--primary);
  }

  .learning-stat-icon.blue {
    background: #edf5ff;

    color: var(--blue);
  }

  .learning-stat-icon.green {
    background: #eafaf3;

    color: var(--green);
  }

  .learning-stats small {
    display: block;

    color: var(--muted-2);

    font-size: 5px;
  }

  .learning-stats strong {
    display: block;

    margin-top: 2px;

    font-size: 15px;
  }

  .learning-stats p {
    margin: 0;

    color: var(--muted);

    font-size: 6px;
  }


  /* LOWER */

  .learning-lower {
    display: grid;

    grid-template-columns:
      1fr 0.85fr;

    gap: 10px;

    margin-top: 11px;
  }

  .recent-learning,
  .review-preview {
    padding: 14px;

    border:
      1px solid var(--border);

    border-radius: 13px;

    background: #fafbfe;
  }

  .learning-panel-title,
  .review-preview-head {
    display: flex;

    align-items: center;

    justify-content:
      space-between;

    margin-bottom: 12px;
  }

  .learning-panel-title small,
  .review-preview-head small {
    display: block;

    color: var(--muted-2);

    font-size: 5px;
  }

  .learning-panel-title strong,
  .review-preview-head strong {
    display: block;

    margin-top: 2px;

    font-size: 8px;
  }

  .learning-panel-title button {
    display: grid;

    width: 24px;
    height: 24px;

    place-items: center;

    border:
      1px solid var(--border);

    border-radius: 7px;

    background: white;

    color: var(--primary);
  }

  .vocab-row {
    display: grid;

    grid-template-columns:
      auto 1fr auto;

    align-items: center;

    gap: 10px;

    padding:
      9px 0;

    border-bottom:
      1px solid var(--border);
  }

  .vocab-row:last-child {
    border-bottom: 0;
  }

  .vocab-kanji {
    display: grid;

    width: 39px;
    height: 39px;

    place-items: center;

    border-radius: 9px;

    background: white;

    box-shadow: var(--shadow-xs);

    font-size: 12px;

    font-weight: 750;
  }

  .vocab-row strong {
    font-size: 8px;
  }

  .vocab-row p {
    margin:
      2px 0 0;

    color: var(--muted);

    font-size: 7px;
  }

  .vocab-level {
    padding:
      4px 6px;

    border-radius: 6px;

    background:
      var(--primary-light);

    color: var(--primary);

    font-size: 5px;

    font-weight: 850;
  }


  /* FLASH CARD */

  .review-preview-head > span {
    color: var(--muted-2);

    font-size: 6px;
  }

  .flash-card {
    padding:
      18px 14px;

    border:
      1px solid var(--border);

    border-radius: 11px;

    background: white;

    text-align: center;

    box-shadow: var(--shadow-xs);
  }

  .flash-card > small {
    color: var(--muted-2);

    font-size: 5px;
  }

  .flash-card > strong {
    display: block;

    margin-top: 7px;

    font-size: 28px;
  }

  .flash-card > span {
    display: block;

    margin-top: 2px;

    color: var(--muted);

    font-size: 8px;
  }

  .flash-divider {
    width: 40px;
    height: 1px;

    margin:
      14px auto;

    background: var(--border);
  }

  .flash-card p {
    margin: 0;

    font-size: 10px;

    font-weight: 650;
  }

  .flash-card blockquote {
    margin:
      10px 0 0;

    color: var(--muted);

    font-size: 7px;
  }

  .review-actions {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        1fr
      );

    gap: 5px;

    margin-top: 9px;
  }

  .review-actions button {
    min-height: 29px;

    border:
      1px solid var(--border);

    border-radius: 7px;

    background: white;

    font-size: 6px;
  }

  .review-actions .again {
    color: #d96767;
  }

  .review-actions .hard {
    color: #cc8c3e;
  }

  .review-actions .good {
    color: var(--green);
  }


  /* EXPLAINER */

  .learning-explainer {
    padding: 29px;

    border:
      1px solid var(--border);

    border-radius: 22px;

    background:
      linear-gradient(
        145deg,
        #ffffff,
        #f4f2ff
      );
  }

  .learning-explainer > h3 {
    margin:
      20px 0 12px;

    font-size:
      clamp(
        28px,
        3vw,
        40px
      );

    line-height: 1.04;

    letter-spacing: -0.05em;
  }

  .learning-explainer > p {
    margin: 0;

    color: var(--muted);

    font-size: 12px;

    line-height: 1.7;
  }

  .learning-system-list {
    display: grid;

    gap: 8px;

    margin-top: 26px;
  }

  .learning-system-list article {
    display: grid;

    grid-template-columns:
      auto 1fr;

    gap: 10px;

    padding: 11px;

    border:
      1px solid var(--border);

    border-radius: 11px;

    background:
      rgba(255, 255, 255, 0.83);
  }

  .learning-list-icon {
    display: grid;

    width: 35px;
    height: 35px;

    place-items: center;

    border-radius: 10px;

    font-size: 11px;

    font-weight: 850;
  }

  .learning-list-icon.purple {
    background: var(--primary-light);

    color: var(--primary);
  }

  .learning-list-icon.blue {
    background: #edf5ff;

    color: var(--blue);
  }

  .learning-list-icon.green {
    background: #eafaf3;

    color: var(--green);
  }

  .learning-system-list strong {
    display: block;

    font-size: 9px;
  }

  .learning-system-list p {
    margin:
      3px 0 0;

    color: var(--muted);

    font-size: 7px;

    line-height: 1.5;
  }


  /* WORKFLOW */

  .learning-workflow {
    display: grid;

    grid-template-columns:
      0.75fr 1.25fr;

    align-items: center;

    gap: 55px;

    margin-top: 75px;

    padding: 45px;

    border:
      1px solid var(--border);

    border-radius:
      var(--radius-lg);

    background: white;

    box-shadow: var(--shadow-sm);
  }

  .learning-workflow-copy h3 {
    margin:
      14px 0 0;

    font-size:
      clamp(
        30px,
        4vw,
        44px
      );

    line-height: 1.04;

    letter-spacing: -0.05em;
  }

  .learning-flow {
    display: grid;

    grid-template-columns:
      1fr auto
      1fr auto
      1fr auto
      1fr;

    align-items: center;

    gap: 7px;
  }

  .learning-flow article {
    min-height: 145px;

    padding: 13px;

    border:
      1px solid var(--border);

    border-radius: 11px;

    background: #fafbfe;
  }

  .flow-number {
    color: var(--muted-2);

    font-size: 6px;

    font-weight: 850;
  }

  .flow-learning-icon {
    display: grid;

    width: 34px;
    height: 34px;

    place-items: center;

    margin:
      13px 0;

    border-radius: 10px;

    font-size: 10px;

    font-weight: 850;
  }

  .flow-learning-icon.manga {
    background: #fff0f6;

    color: #da629c;
  }

  .flow-learning-icon.select {
    background: var(--primary-light);

    color: var(--primary);
  }

  .flow-learning-icon.save {
    background: #edf5ff;

    color: var(--blue);
  }

  .flow-learning-icon.review {
    background: #eafaf3;

    color: var(--green);
  }

  .learning-flow strong {
    display: block;

    font-size: 8px;
  }

  .learning-flow p {
    margin:
      3px 0 0;

    color: var(--muted);

    font-size: 6px;
  }

  .learning-flow > i {
    color: var(--muted-2);

    font-style: normal;
  }


  /* BENEFITS */

  .learning-benefits {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        1fr
      );

    gap: 13px;

    margin-top: 20px;
  }

  .learning-benefits article {
    display: grid;

    grid-template-columns:
      auto 1fr;

    gap: 11px;

    padding: 18px;

    border:
      1px solid var(--border);

    border-radius: 14px;

    background:
      rgba(255, 255, 255, 0.86);
  }

  .learning-benefits
  article > span {
    display: grid;

    width: 32px;
    height: 32px;

    place-items: center;

    border-radius: 9px;

    background:
      var(--primary-light);

    color: var(--primary);

    font-size: 7px;

    font-weight: 850;
  }

  .learning-benefits strong {
    display: block;

    font-size: 10px;
  }

  .learning-benefits p {
    margin:
      3px 0 0;

    color: var(--muted);

    font-size: 8px;

    line-height: 1.5;
  }


  /* RESPONSIVE */

  @media (max-width: 1080px) {
    .learning-heading {
      grid-template-columns:
        1fr;

      gap: 25px;
    }

    .learning-product {
      grid-template-columns:
        1fr;
    }

    .learning-explainer {
      display: grid;

      grid-template-columns:
        0.8fr 1.2fr;

      gap: 30px;
    }

    .learning-system-list {
      margin-top: 0;
    }

    .learning-workflow {
      grid-template-columns:
        1fr;

      gap: 30px;
    }
  }

  @media (max-width: 850px) {
    .learning-nav {
      display: none;
    }

    .learning-explainer {
      grid-template-columns:
        1fr;
    }

    .learning-flow {
      grid-template-columns:
        1fr 1fr;
    }

    .learning-flow > i {
      display: none;
    }

    .learning-benefits {
      grid-template-columns:
        1fr;
    }
  }

  @media (max-width: 650px) {
    .learning-stats {
      grid-template-columns:
        1fr;
    }

    .learning-lower {
      grid-template-columns:
        1fr;
    }

    .learning-workflow {
      padding:
        30px 20px;
    }

    .learning-flow {
      grid-template-columns:
        1fr;
    }
  }



  /* =========================================================
     V5.3D-2 — ROADMAP PREVIEW
     ========================================================= */

  .roadmap-preview-v5 {
    position: relative;

    background: #ffffff;
  }

  .roadmap-v5-heading {
    display: grid;

    grid-template-columns:
      1.15fr 0.85fr;

    align-items: end;

    gap: 80px;

    margin-bottom: 50px;
  }

  .roadmap-v5-heading
  .section-title em {
    display: block;

    color: var(--primary);

    font-style: normal;
  }

  .roadmap-v5-intro p {
    margin: 0;

    color: var(--muted);

    font-size: 14px;

    line-height: 1.75;
  }

  .roadmap-v5-intro a {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-top: 14px;

    color: var(--primary);

    font-size: 12px;

    font-weight: 750;
  }


  /* BOARD */

  .roadmap-board {
    display: grid;

    grid-template-columns:
      repeat(
        3,
        minmax(0, 1fr)
      );

    gap: 15px;
  }

  .roadmap-column {
    display: flex;

    min-width: 0;

    flex-direction: column;

    padding: 21px;

    border:
      1px solid var(--border);

    border-radius: 18px;

    background: #fafbfe;

    box-shadow: var(--shadow-xs);
  }

  .roadmap-column.available {
    background:
      linear-gradient(
        155deg,
        #ffffff,
        #f1fbf6
      );
  }

  .roadmap-column.development {
    border-color:
      rgba(99, 91, 255, 0.18);

    background:
      linear-gradient(
        155deg,
        #ffffff,
        #f4f2ff
      );

    box-shadow:
      0 20px 50px
      rgba(99, 91, 255, 0.09);
  }

  .roadmap-column.planned {
    background:
      linear-gradient(
        155deg,
        #ffffff,
        #f3f7fc
      );
  }


  /* HEAD */

  .roadmap-column-head {
    display: grid;

    grid-template-columns:
      auto 1fr auto;

    align-items: center;

    gap: 10px;

    padding-bottom: 17px;

    border-bottom:
      1px solid var(--border);
  }

  .roadmap-status-icon {
    display: grid;

    width: 36px;
    height: 36px;

    place-items: center;

    border-radius: 10px;

    font-size: 12px;

    font-weight: 900;
  }

  .available
  .roadmap-status-icon {
    background: #eafaf3;

    color: var(--green);
  }

  .development
  .roadmap-status-icon {
    background: var(--primary-light);

    color: var(--primary);
  }

  .planned
  .roadmap-status-icon {
    background: #edf1f6;

    color: var(--muted);
  }

  .roadmap-column-head small {
    display: block;

    color: var(--muted-2);

    font-size: 6px;

    font-weight: 850;

    letter-spacing: 0.09em;
  }

  .roadmap-column-head strong {
    display: block;

    margin-top: 2px;

    color: var(--text);

    font-size: 10px;
  }

  .roadmap-count {
    color: var(--muted-2);

    font-size: 8px;

    font-weight: 850;
  }


  /* ITEMS */

  .roadmap-items {
    display: grid;

    gap: 2px;

    margin-top: 11px;
  }

  .roadmap-item {
    display: grid;

    grid-template-columns:
      auto 1fr;

    gap: 9px;

    padding:
      11px 7px;

    border-bottom:
      1px solid
      rgba(229, 231, 239, 0.8);
  }

  .roadmap-item:last-child {
    border-bottom: 0;
  }

  .roadmap-item > span {
    display: grid;

    width: 20px;
    height: 20px;

    place-items: center;

    margin-top: 1px;

    border-radius: 6px;

    font-size: 7px;

    font-weight: 900;
  }

  .available
  .roadmap-item > span {
    background: #eafaf3;

    color: var(--green);
  }

  .development
  .roadmap-item > span {
    background: var(--primary-light);

    color: var(--primary);
  }

  .planned
  .roadmap-item > span {
    background: #eef0f4;

    color: var(--muted);
  }

  .roadmap-item strong {
    display: block;

    color: var(--text);

    font-size: 9px;
  }

  .roadmap-item p {
    margin:
      3px 0 0;

    color: var(--muted);

    font-size: 7px;

    line-height: 1.5;
  }

  .roadmap-item.highlighted {
    margin:
      3px -5px;

    padding:
      12px;

    border:
      1px solid
      rgba(99, 91, 255, 0.15);

    border-radius: 10px;

    background:
      rgba(255, 255, 255, 0.72);
  }


  /* DEVELOPMENT */

  .development-progress {
    margin-top: auto;

    padding-top: 18px;

    border-top:
      1px solid var(--border);
  }

  .development-progress
  > div:first-child {
    display: flex;

    align-items: center;

    justify-content:
      space-between;
  }

  .development-progress span {
    color: var(--muted-2);

    font-size: 6px;
  }

  .development-progress strong {
    color: var(--primary);

    font-size: 7px;
  }

  .progress-track {
    height: 5px;

    margin-top: 8px;

    overflow: hidden;

    border-radius: 999px;

    background:
      #e8e6f5;
  }

  .progress-track span {
    display: block;

    width: 64%;
    height: 100%;

    border-radius: inherit;

    background:
      linear-gradient(
        90deg,
        var(--primary),
        var(--blue)
      );
  }


  /* VISION */

  .roadmap-vision {
    position: relative;

    display: grid;

    grid-template-columns:
      0.95fr 1.05fr;

    min-height: 360px;

    align-items: center;

    gap: 60px;

    margin-top: 22px;

    padding:
      55px;

    overflow: hidden;

    border:
      1px solid var(--border);

    border-radius:
      var(--radius-lg);

    background:
      linear-gradient(
        135deg,
        #f2f0ff,
        #eef6ff 60%,
        #f3fbf7
      );
  }

  .vision-kicker {
    color: var(--primary);

    font-size: 7px;

    font-weight: 850;

    letter-spacing: 0.12em;
  }

  .vision-copy h3 {
    margin:
      17px 0 13px;

    color: var(--text);

    font-size:
      clamp(
        36px,
        5vw,
        56px
      );

    line-height: 0.98;

    letter-spacing: -0.055em;
  }

  .vision-copy h3 span,
  .vision-copy h3 em {
    display: block;
  }

  .vision-copy h3 em {
    color: var(--primary);

    font-style: normal;
  }

  .vision-copy p {
    max-width: 500px;

    margin: 0;

    color: var(--muted);

    font-size: 12px;

    line-height: 1.7;
  }


  /* ORBIT */

  .vision-orbit {
    position: relative;

    width:
      min(
        100%,
        390px
      );

    aspect-ratio: 1;

    justify-self: center;

    border:
      1px solid
      rgba(99, 91, 255, 0.12);

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        rgba(255, 255, 255, 0.9),
        rgba(255, 255, 255, 0.22) 48%,
        transparent 49%
      );
  }

  .vision-orbit::before {
    position: absolute;

    inset: 16%;

    border:
      1px dashed
      rgba(99, 91, 255, 0.16);

    border-radius: 50%;

    content: "";
  }

  .vision-center {
    position: absolute;

    z-index: 4;

    top: 50%;
    left: 50%;

    display: grid;

    width: 74px;
    height: 74px;

    transform:
      translate(-50%, -50%);

    place-items: center;

    border-radius: 22px;

    background:
      linear-gradient(
        135deg,
        var(--primary),
        var(--blue)
      );

    box-shadow:
      0 20px 50px
      rgba(99, 91, 255, 0.24);

    color: white;

    font-size: 25px;

    font-weight: 900;
  }

  .vision-node {
    position: absolute;

    z-index: 3;

    padding:
      8px 11px;

