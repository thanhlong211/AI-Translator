    display: flex;

    align-items: center;

    gap: 11px;

    padding:
      16px;

    border:
      1px solid var(--border);

    border-radius: 14px;

    background:
      #fafbfe;
  }

  .detail-icon {
    display: grid;

    width: 34px;
    height: 34px;

    flex: 0 0 auto;

    place-items: center;

    border-radius: 10px;

    font-size: 11px;

    font-weight: 850;
  }

  .detail-icon.purple {
    background:
      var(--primary-light);

    color:
      var(--primary);
  }

  .detail-icon.blue {
    background:
      #edf5ff;

    color:
      var(--blue);
  }

  .detail-icon.green {
    background:
      #eafaf3;

    color:
      var(--green);
  }

  .detail-icon.orange {
    background:
      #fff5e8;

    color:
      #df9043;
  }

