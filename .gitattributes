# Normalize source files so Windows/Linux diffs stay clean.
* text=auto eol=lf

# Windows-native scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.rar binary
*.7z binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pyd binary
*.dll binary
*.exe binary
